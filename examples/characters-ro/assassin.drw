# RO-style Assassin/Thief — chibi ~4 heads, dark hood+cloak, twin daggers, cel-shaded.
# Three views (front/side/back) on one file, composed onto one sheet (§ bottom).

# proportions (module scope, shared design lines — actual placement is pin/fit-driven)
cx           = 32
headTop      = 6
shoulderLine = 34
hipLine      = 63
kneeLine     = 92
footLine     = 121

# colours (module scope — sequential, must precede materials/theme use)
clothC   = #37304a    # dark violet cloth: hood, tunic, pants (lifted off near-black so form
                      # shading carries the C004 value spread without washing to warm — W2-1b)
cloakC   = #4a2b52    # plum-violet cloak layer — distinct hue from clothC, not just darker
leatherC = #4d3628    # dark brown leather: straps, boots, gloves
skinC    = #d69b6f    # warm tan skin
steelC   = #8a95a5    # cool steel, dagger blade/guard
hiltC    = #241a14    # near-black grip wrap
trimC    = #7a2634    # dark crimson accent, clasp/pommel
eyeGlow  = #8fe0e6     # cool cyan eye glint under the hood
warm     = #ffe6b0     # matches light sun's warm colour
cool     = #2a3a5e     # matches light sun's amb colour
rimC     = warm.alpha(55%)          # thin lit-edge stroke on the light-facing side

# dark materials shade with smooth normal-based `model` (ADR-0089): a dark base keeps form
# detail without crushing to black. The value spread these dark parts need for C004 comes from
# each material's own `spread` (ADR-0091) — the canonical one-knob control — not from hand
# `.intersect(rect)+litTone` corner patches (retired W2-1b). A dark cloth's smooth form terminator
# is a gentle gradient, so `spread` runs high to lift the lit face's p90 to the C004 floor; the
# cloak carries the `drape` profile so its hanging length reads as a vertical half-tube (no
# turtle-shell). Silhouette closes with ONE bare `outline` per assembly (ADR-0090).
material clothMat   = clothC cloth spread 780%
material cloakMat   = cloakC cloth drape spread 820%
material leatherMat = leatherC cloth spread 780%
material skinMat    = skinC skin
material steelMat   = steelC metal

theme roTheme:
  light sun = dir 1:1 warm amb cool 15%   # source up-left; one light for all 3 views
  mode pixel

use roTheme

# ---------------------------------------------------------------- head

draw headFront 22x26:
  hoodReg = curvePoly(11:0, 21:6, 19:18, 11:24, 3:18, 1:6)
  model hoodReg clothMat
  rim hoodReg 1:1 rimC 1
  faceReg = ellipse(11:20, 5:5)
  model faceReg skinMat
  rect clothC.darken(12%) 5:13 17:16 fill              # hood casts a brow shadow band
  rect #d9ecec 7:17 8:18 fill                          # sclera L
  rect #d9ecec 13:17 14:18 fill                        # sclera R
  px eyeGlow 8:18                                       # cyan iris glint L
  px eyeGlow 13:18                                      # cyan iris glint R
  px #f2ffff 7:17                                       # highlight L
  px #f2ffff 14:17                                      # highlight R
  px skinC.darken(26%) 11:20                            # nose tick
  line skinC.darken(30%) 9:22 12:22                     # mouth
  poly clothC.darken(10%) 19:9 22:13 18:19 fill         # hood side-fold
  pin neck 11:25

draw headSide 20x28:
  hoodReg = curvePoly(9:0, 17:4, 18:12, 15:19, 10:25, 4:26, 1:15, 2:5)
  model hoodReg clothMat
  rim hoodReg 1:1 rimC 1
  faceReg = ellipse(13:19, 4:4)
  model faceReg skinMat
  rect clothC.darken(12%) 9:14 17:16 fill               # brow shadow under the brim
  rect #d9ecec 13:17 14:18 fill                         # sclera (near eye)
  px eyeGlow 14:18                                      # cyan iris glint
  px #f2ffff 13:17                                      # highlight
  px skinC.darken(26%) 15:19                            # nose tick (forward)
  line skinC.darken(30%) 13:21 15:21                    # mouth
  pin neck 9:26

draw headBack 22x27:
  hoodReg = curvePoly(11:0, 21:5, 20:18, 11:26, 2:18, 1:5)
  model hoodReg clothMat
  rim hoodReg 1:1 rimC 1
  px leatherC 10:15                                     # nape hair (no face on the back)
  px leatherC 12:15
  rect leatherC 9:16 13:17 fill
  pin neck 11:25

# ---------------------------------------------------------------- torso

draw torsoFront 26x32:
  bodyReg = poly(11:0, 15:0, 24:2, 26:9, 20:19, 23:31, 3:31, 6:19, 0:9, 2:2)
  model bodyReg clothMat
  rim bodyReg 1:1 rimC 1
  rect leatherC 2:17 24:20 fill
  rect trimC 12:17 14:20 fill
  pin neck 13:0
  pin shoulderL 2:3
  pin shoulderR 24:3
  pin hipL 4:29
  pin hipR 22:29
  pin beltL 2:18
  pin beltR 24:18

draw torsoSide 30x32:
  farArmReg = poly(2:5, 6:4, 7:16, 4:23, 1:20)
  fill #38323f farArmReg
  bodyReg = poly(14:0, 22:3, 25:12, 20:19, 22:29, 6:29, 5:19, 3:10, 6:2)
  model bodyReg clothMat
  rim bodyReg 1:1 rimC 1
  rect leatherC 5:19 22:22 fill
  pin neck 14:0
  pin shoulder 21:4
  pin hipNear 18:28
  pin hipFar 6:28
  pin belt 17:20
  pin cloak 6:3

draw torsoBack 26x32:
  bodyReg = poly(11:0, 15:0, 24:2, 26:9, 20:19, 23:31, 3:31, 6:19, 0:9, 2:2)
  model bodyReg clothMat
  rim bodyReg 1:1 rimC 1
  strapA = poly(2:3, 4:3, 22:29, 20:29)
  strapB = poly(22:3, 24:3, 4:29, 2:29)
  fill leatherC strapA
  fill leatherC strapB
  pin neck 13:0
  pin shoulderL 2:3
  pin shoulderR 24:3
  pin hipL 4:29
  pin hipR 22:29
  pin backL 9:9
  pin backR 17:9
  pin cloak 13:2

# ---------------------------------------------------------------- arm (pose-invariant, reused all views)

draw arm 9x36:
  sleeveReg = rect(1:0, 8:24)
  model sleeveReg clothMat
  rim sleeveReg 1:1 rimC 1
  strapReg = rect(1:15, 8:17)
  fill leatherC.darken(10%) strapReg
  gloveReg = rect(1:24, 8:34)
  model gloveReg leatherMat
  pin shoulder 4:0

# ---------------------------------------------------------------- leg (front/back, pose-invariant)

draw leg 14x60:
  thighReg = rect(2:0, 12:28)
  shinReg = rect(3:28, 11:50)
  bootReg = poly(2:48, 12:48, 13:53, 11:58, 3:58, 1:53)
  limbReg = thighReg.union(shinReg).union(bootReg)   # one shading unit → no seam break at the material joins
  model thighReg clothMat over limbReg
  rim thighReg 1:1 rimC 1
  model shinReg leatherMat over limbReg
  model bootReg leatherMat over limbReg

draw legL 14x60:
  stamp leg 0:0
  pin hip 7:0
  pin foot 7:58

draw legR 14x60:
  stamp leg 0:0
  pin hip 7:0
  pin foot 7:58

draw legSideFront 16x60:
  thighReg = rect(1:0, 11:26)
  shinReg = rect(2:26, 10:46)
  bootReg = poly(2:46, 11:46, 13:51, 11:57, 2:57, 1:51)
  limbReg = thighReg.union(shinReg).union(bootReg)   # one continuous shading unit
  model thighReg clothMat over limbReg
  rim thighReg 1:1 rimC 1
  model shinReg leatherMat over limbReg
  model bootReg leatherMat over limbReg
  pin hip 6:0
  pin foot 7:56

draw legSideBack 16x54:
  thighReg = rect(3:0, 13:24)
  shinReg = rect(4:24, 12:42)
  bootReg = poly(4:42, 12:42, 13:47, 11:52, 3:52, 2:47)
  limbReg = thighReg.union(shinReg).union(bootReg)   # one continuous shading unit
  model thighReg clothMat over limbReg
  rim thighReg 1:1 rimC 1
  model shinReg leatherMat over limbReg
  model bootReg leatherMat over limbReg
  pin hip 8:0
  pin foot 7:51

# ---------------------------------------------------------------- cloak
# side: authored generously, then clamped to the half BEHIND the attach pin so it can't
# jut forward into the body (ADR-0090 §5b(d)); back: mounted last, over the assembled figure.

draw cloakSide 20x56:
  raw      = curvePoly(17:1, 12:8, 4:24, 3:38, 9:53, 14:47, 16:30, 16:10)
  cloakReg = raw.intersect(rect(0:0, 17:h))    # keep only x <= attach (behind the body)
  model cloakReg cloakMat
  rim cloakReg 1:1 rimC 1
  pin attach 17:1

draw cloakBack 46x62:
  cloakReg = curvePoly(23:0, 41:10, 45:30, 36:52, 41:60, 27:54, 23:60, 19:54, 5:60, 10:52, 1:30, 5:10)
  model cloakReg cloakMat
  rim cloakReg 1:1 rimC 1
  pin attach 23:0

# ---------------------------------------------------------------- dagger (sheathed prop, pose-invariant)

draw dagger 9x16:
  guardReg = rect(0:4, 8:6)
  model guardReg steelMat
  gripReg = rect(2:5, 7:15)
  fill hiltC gripReg
  pommelReg = rect(3:13, 6:15)
  fill trimC pommelReg
  pin grip 4:15

# ---------------------------------------------------------------- composed views

draw assassinFront 64x128:
  stamp torsoFront 19:34
  pin torsoFront.neck 32:34
  pin torsoFront.shoulderL 21:37
  pin torsoFront.shoulderR 43:37
  pin torsoFront.hipL 23:63
  pin torsoFront.hipR 41:63
  pin torsoFront.beltL 21:52
  pin torsoFront.beltR 43:52
  fit legL.hip torsoFront.hipL shadow
  fit legR.hip torsoFront.hipR shadow
  fit arm.shoulder torsoFront.shoulderL
  fit arm.shoulder torsoFront.shoulderR
  fit dagger.grip torsoFront.beltL
  fit dagger.grip torsoFront.beltR
  fit headFront.neck torsoFront.neck
  outline

draw assassinSide 64x128:
  stamp torsoSide 23:34
  pin torsoSide.neck 37:34            # +6 on x vs the raw pose to centre the trailing cape (C003)
  pin torsoSide.shoulder 44:38
  pin torsoSide.hipNear 41:62
  pin torsoSide.hipFar 29:62
  pin torsoSide.belt 40:54
  pin torsoSide.cloak 29:37
  fit legSideBack.hip torsoSide.hipFar shadow
  fit legSideFront.hip torsoSide.hipNear shadow
  fit cloakSide.attach torsoSide.cloak
  fit arm.shoulder torsoSide.shoulder
  fit dagger.grip torsoSide.belt
  fit headSide.neck torsoSide.neck
  outline

# back view (ADR-0090 §5b): no face; arms tuck BEHIND the torso (fitted before it is
# stamped, inverted z-order); the cloak is a mounted prop fitted LAST, over the whole back.
draw assassinBack 64x128:
  pin torsoBack.neck 32:34          # seeds ALL torsoBack pins in canvas space
  pin torsoBack.shoulderL 21:37
  pin torsoBack.shoulderR 43:37
  pin torsoBack.hipL 23:63
  pin torsoBack.hipR 41:63
  pin torsoBack.cloak 32:36
  fit legL.hip torsoBack.hipL shadow
  fit legR.hip torsoBack.hipR shadow
  fit arm.shoulder torsoBack.shoulderL     # arms painted BEHIND the torso …
  fit arm.shoulder torsoBack.shoulderR
  stamp torsoBack 19:34                     # … torso stamped over them
  fit headBack.neck torsoBack.neck
  fit cloakBack.attach torsoBack.cloak      # cloak LAST — over the assembled back
  outline

# ---------------------------------------------------------------- sheet

draw assassinSheet 248x160:
  bg #d9d3c8
  stamp assassinFront 12:14
  stamp assassinSide 92:14
  stamp assassinBack 172:14
  text #2a2333 30:146 "FRONT" font small
  text #2a2333 106:146 "SIDE" font small
  text #2a2333 188:146 "BACK" font small

export assassinFront assassin-front:
  png @1 @4

export assassinSide assassin-side:
  png @1 @4

export assassinBack assassin-back:
  png @1 @4

export assassinSheet assassin-sheet:
  png @1 @2
