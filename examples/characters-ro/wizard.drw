# Ragnarok-Online-style chibi wizard — three views (front / side / back) on one sheet.
# One theme light shared by every view; parts assembled with pin/fit; smooth model shading.

# --- proportions (shared across all three views) ---
cx       = 32
neckY    = 62
hemY     = 114

# --- palette (semantic bindings) ---
ink      = #1b1428
robeBase = #4a3f8c
hatBase  = #3b3178
skinBase = #f8d3ad
hairBase = #b06a2c
woodBase = #6b4526
trim     = #e6c34e
bootBase = #47341f
orbBase  = #7bd4ff
eyeInk   = #241d3a
irisCol  = #5566a8
browCol  = #7c4a22
mouthCol = #9c5647
blush    = #eaa07e

# --- materials (response drives model doses; base colour stays ours) ---
material robeM = robeBase cloth
material hatM  = hatBase  cloth
material skinM = skinBase skin
material hairM = hairBase cloth
material woodM = woodBase cloth
material bootM = bootBase cloth spread 760%
material orbM  = orbBase  glow
material trimM = trim     cloth spread 240%   # gold trim (sash/hem/cuff/band) modelled so it shows form (W2-1b)

# --- one light for every view/variant (theme default; never mirrored per view) ---
theme wizTheme:
  light sun = dir 1:1 #ffe6b0 amb #2a3a5e 15%
  style """
    RO chibi wizard, ~4 head-heights tall. One warm light from the upper-left, shared by every view.
    Smooth model shading (cloth/skin/glow); 1px derived-dark outline over the whole silhouette, added last.
  """

use wizTheme

# ============================ ACCESSORY: hat ============================
draw hat 36x40:
  cone = poly(18:5, 30:31, 6:31)
  brim = ellipse(18:32, 15:5)
  knob = circle(18:4, 2)
  mass = cone.union(brim).union(knob)
  model mass hatM
  fill trim rect(7:28, 29:30)              # hat band (bright gold accent)
  poly trim 18:14 21:17 18:20 15:17 fill   # star gem
  pin brimC 18:32

draw hatSide 36x40:
  cone  = poly(15:5, 26:31, 5:31)          # apex leans back (left)
  brim  = ellipse(18:32, 14:5)
  brimF = poly(20:29, 33:32, 20:35)        # brim points forward (right)
  mass  = cone.union(brim).union(brimF)
  model mass hatM
  fill trim rect(6:28, 27:30)
  pin brimC 16:32

draw hatBack 36x40:
  cone = poly(18:5, 30:31, 6:31)
  brim = ellipse(18:32, 15:5)
  knob = circle(18:4, 2)
  mass = cone.union(brim).union(knob)
  model mass hatM
  fill trim rect(7:28, 29:30)
  pin brimC 18:32

# ============================ HEAD (three poses) ============================
draw headFront 32x36:
  skull = ellipse(16:14, 12:11)                # x4..27, y3..24
  jaw   = poly(8:20, 24:20, 20:30, 12:30)      # chin down to y30
  neck  = rect(13:29, 19:34)                   # neck stub → plugs into the collar
  ears  = circle(5:19, 3).union(circle(27:19, 3))   # overlap the skull → no seam gap
  face  = skull.union(jaw).union(neck).union(ears)
  model face skinM
  fill hairBase ellipse(16:9, 12:5).intersect(rect(3:11, 29:15))   # fringe below the brim
  # eyes: white sclera + iris + pupil + highlight (four layers, not two dots)
  fill #ffffff rect(9:18, 11:20)
  fill #ffffff rect(20:18, 22:20)
  fill irisCol rect(10:18, 11:19)
  fill irisCol rect(20:18, 21:19)
  px eyeInk 10:19
  px eyeInk 21:19
  px #ffffff 11:18
  px #ffffff 20:18
  line browCol 9:16 12:15                       # brows, clear of the hairline
  line browCol 20:15 23:16
  px skinBase.darken(20%) 16:21                  # nose tick
  px skinBase.darken(20%) 16:22
  line mouthCol 14:24 18:24                       # mouth stroke
  fill blush ellipse(7:22, 2:1)
  fill blush ellipse(25:22, 2:1)
  pin crown 16:6
  pin chin  16:33

draw headSide 32x36:
  skull = ellipse(15:14, 12:11)
  nose  = poly(24:17, 30:20, 24:22)                                 # base overlaps the skull → no seam gap
  jaw   = poly(9:20, 25:20, 22:30, 14:30)
  neck  = rect(13:29, 19:34)
  ear   = circle(14:19, 2)
  mass  = skull.union(nose).union(jaw).union(neck).union(ear)
  model mass skinM
  fill hairBase ellipse(13:10, 11:9).intersect(rect(2:3, 21:18))    # hair over crown/back
  fill hairBase poly(3:13, 9:13, 8:29, 3:27)                        # tapered nape hair
  fill #ffffff rect(20:18, 22:20)                                    # eye (facing right)
  fill irisCol rect(20:18, 21:19)
  px eyeInk 21:19
  px #ffffff 20:18
  line browCol 20:15 23:16
  px skinBase.darken(20%) 27:19                                      # nose-shadow tick
  line mouthCol 26:23 29:23                                          # mouth
  fill blush ellipse(24:22, 2:1)
  pin crown 15:6
  pin chin  16:33

draw headBack 32x36:
  skull = ellipse(16:14, 12:11)
  jaw   = poly(9:20, 23:20, 20:30, 12:30)
  mass  = skull.union(jaw)
  model mass hairM
  fill skinBase rect(13:29, 19:34)              # nape of neck
  line hairBase.darken(24%) 16:5 16:29          # centre part
  line hairBase.darken(16%) 11:8 12:28
  line hairBase.darken(16%) 21:8 20:28
  pin crown 16:6
  pin chin  16:33

# ============================ TORSO / ROBE (three poses) ============================
draw torsoFront 40x54:
  robe = poly(13:0, 27:0, 37:53, 3:53)
  model robe robeM
  fill robeBase.darken(24%) poly(16:0, 24:0, 20:6)   # collar V
  line trim 20:6 20:50                               # gold placket
  model rect(4:25, 36:28) trimM                        # waist sash
  line robeBase.darken(18%) 12:16 9:50               # fold shadow L
  line robeBase.darken(18%) 28:16 31:50              # fold shadow R
  model rect(3:50, 37:52) trimM                        # hem band
  pin neck      20:0
  pin shoulderL 12:4
  pin shoulderR 28:4
  pin hem       20:53

draw torsoSide 40x54:
  robe = poly(14:0, 24:0, 34:53, 8:53)               # hem drapes forward (right)
  model robe robeM
  model rect(9:25, 33:28) trimM                        # sash
  line robeBase.darken(20%) 19:8 22:50               # front drape fold
  line robeBase.darken(16%) 12:10 11:50              # back fold
  model rect(8:50, 34:52) trimM                        # hem band
  pin neck      19:0
  pin shoulderF 24:3
  pin shoulderB 14:3
  pin hem       21:53

draw torsoBack 40x54:
  robe = poly(13:0, 27:0, 37:53, 3:53)
  model robe robeM
  fill robeBase.darken(16%) ellipse(20:3, 9:4)       # hood/collar drape
  line robeBase.darken(22%) 20:6 20:50               # centre back seam
  model rect(4:25, 36:28) trimM                        # sash
  line robeBase.darken(16%) 12:12 10:50
  line robeBase.darken(16%) 28:12 30:50
  model rect(3:50, 37:52) trimM                        # hem band
  pin neck      20:0
  pin shoulderL 12:4
  pin shoulderR 28:4
  pin hem       20:53

# ============================ ARMS: one bell sleeve, reused ============================
draw sleeve 16x30:
  bell = poly(5:0, 11:0, 14:26, 2:26)
  model bell robeM
  model rect(2:24, 14:26) trimM         # cuff
  fill skinBase ellipse(8:28, 3:2)    # hand
  pin shoulder 8:1
  pin wrist    8:27

# ============================ LEGS: boots, reused ============================
draw feet 20x11:
  bootL = poly(1:0, 9:0, 9:8, 6:10, 1:10)
  bootR = poly(10:0, 18:0, 18:10, 13:10, 10:8)
  model bootL bootM
  model bootR bootM
  fill #0e0b06 rect(1:9, 6:10)     # near-black sole L
  fill #0e0b06 rect(10:9, 18:10)   # near-black sole R
  pin top 9:0

# ============================ STAFF (glowing orb) ============================
draw staff 16x78:
  shaft = rect(7:14, 9:76)
  model shaft woodM
  line woodBase.darken(25%) 3:16 8:11     # claw L
  line woodBase.darken(25%) 13:16 8:11    # claw R
  model rect(6:44, 10:48) trimM             # grip wrap
  circle orbBase.alpha(20%) 8:9 10 fill   # soft halo (translucent → not outlined)
  circle orbBase.alpha(38%) 8:9 8 fill
  orb = circle(8:9, 6)
  model orb orbM
  px #ffffff 6:7
  pin grip 8:46
  pin tip  8:9

# ============================ COMPOSERS ============================
draw wizardFront 64x128:
  stamp staff 41:24                        # held prop; shaft overlaps the near sleeve/hand
  fit torsoFront.neck cx:neckY             # root: seeds every torso pin at once
  fit headFront.chin torsoFront.neck
  fit hat.brimC headFront.crown
  fit sleeve.shoulder torsoFront.shoulderL
  fit sleeve.shoulder torsoFront.shoulderR
  fit feet.top torsoFront.hem shadow
  outline

draw wizardSide 64x128:
  stamp sleeve 22:66 tint #2b2b2b 45%      # far arm (behind, neutral-grey depth cue)
  stamp staff 39:24
  fit torsoSide.neck cx:neckY              # root
  fit headSide.chin torsoSide.neck
  fit hatSide.brimC headSide.crown
  fit sleeve.shoulder torsoSide.shoulderF  # near arm grips the staff
  fit feet.top torsoSide.hem shadow
  outline

draw wizardBack 64x128:
  stamp staff 9:24                         # held hand appears on the left from behind
  fit torsoBack.neck cx:neckY              # root
  fit headBack.chin torsoBack.neck
  fit sleeve.shoulder torsoBack.shoulderL
  fit sleeve.shoulder torsoBack.shoulderR
  fit feet.top torsoBack.hem shadow
  fit hatBack.brimC headBack.crown         # mounted last: over the assembled figure
  outline

# ============================ EXPORTS ============================
export wizardFront wizard-front:
  png @1 @4

export wizardSide wizard-side:
  png @1 @4

export wizardBack wizard-back:
  png @1 @4
