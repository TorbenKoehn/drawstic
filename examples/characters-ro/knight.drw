# Ragnarok-Online-style chibi Knight / Swordsman — front, side, back.
# ONE shared theme light drives every part's material shading, so the lit edge lands on the
# same world side (up-left) in all three views. Shading runs through the `material … metal`/
# `cloth` pipeline via form-following `cel` (ADR-0089 wraps the surface normal — smooth, not the
# old flat linear ramp), never raw `shadeRegion`. `model` (continuous tones) overshoots the
# character C006 palette ceiling at 64x128 chibi scale, so `cel` is the palette-tight smooth path.
# Parts are modular draws, assembled with pin/fit for guaranteed pixel contact (no floating seams).
# The sword is authored once blade-up with a `grip` pin and grip-fitted into the hand in every
# view (never flipped), so its orientation is identical front/side/back (ADR-0087).
# One bare `outline` closes each view's whole-figure silhouette as the assembly's last line (ADR-0090).

# --- shared light (theme default → reaches every part + view) ---
theme knightTheme:
  mode pixel                                    # crisp RO pixel-art; cel bands stay a tight palette
  light sun = dir 1:1 #ffe6b0 amb #2a3a5e 18%   # source up-left ⇒ up-left edge lit
  style """RO chibi knight, ~3.5 heads. Single whole-figure outline, form-following cel shading.
Steel plate, red cape + plume, gold trim. Light up-left, shared across all views.
Sword grip-pinned into the hand (blade up) in every view — never flipped."""

use knightTheme

# --- palette (semantic bindings) ---
steelSpec = #eaf2fa
steelLite = #b6c3d6
steelMid = #8494ac
steelDark = #55617c
steelInk = #2b3346
capeRed = #b23a34
capeLite = #d0584a
capeDark = #7c2521
gold = #e8c15a
goldDark = #a9822f
ink = #16181f
slit = #10121a
shadowCol = #212c47
chain = #2a3040

# --- materials for form-following cel shading ---
material plate = #8494ac metal
material cloth = #b23a34 cloth
# hanging cape: `drape` profile (per-row half-tube, no turtle-shell) + `spread` for the C004 value
# range that the retired capeHi/capeDeep `.intersect` corner patches used to supply (W2-1b).
material capeM = capeRed cloth drape spread 230%

# ===================== FRONT PARTS =====================

draw helmFront 32x38:
  # plume crest (red) on top
  crest = curvePoly(16:0, 12:4, 13:10, 16:9, 19:10, 20:4)
  cel crest cloth 3
  # helm shell
  shell = poly(16:8, 27:13, 28:23, 25:34, 20:37, 12:37, 7:34, 4:23, 5:13)
  cel shell plate 4
  px steelSpec 9:14
  px steelSpec 10:13
  # brow ridge + eye slit (T-visor)
  fill slit rect(7:20, 24:24)
  fill steelDark rect(15:14, 17:32)
  line ink 16:14 16:32
  # rivets
  px gold 8:30
  px gold 24:30
  pin chin 16:36

draw torsoFront 36x46:
  body = poly(6:1, 30:1, 32:12, 29:26, 33:45, 3:45, 7:26, 4:12)
  cel body plate 4
  # central keel + pectoral seams
  line steelInk 18:4 18:25
  line steelInk 11:5 17:14
  line steelInk 25:5 19:14
  px steelSpec 10:6
  px steelSpec 11:6
  # gorget / collar (gold)
  fill gold rect(13:1, 23:4)
  fill goldDark rect(13:4, 23:5)
  # belt + buckle
  fill goldDark rect(3:26, 33:29)
  fill gold rect(15:26, 21:29)
  px slit 18:27
  # fauld segments
  line steelInk 12:30 11:44
  line steelInk 24:30 25:44
  line steelInk 18:29 18:44
  pin neck 18:1
  pin shoulderL 6:5
  pin shoulderR 30:5
  pin hip 18:45

draw pauldron 16x13:
  dome = ellipse(8:8, 8:7)
  cel dome plate 4
  fill steelDark rect(0:10, 15:12)
  px gold 7:4
  px steelSpec 4:3
  pin inner 8:11

draw armFront 9x27:
  upper = poly(1:0, 7:0, 8:11, 7:16, 8:26, 1:26, 2:16, 1:11)
  cel upper plate 4
  # gauntlet cuff
  fill steelDark rect(1:15, 8:17)
  px steelSpec 3:2
  pin shoulder 4:1

draw legFront 12x40:
  cuisse = poly(2:0, 10:0, 11:14, 9:26, 11:39, 1:39, 3:26, 1:14)
  cel cuisse plate 4
  # knee cop + sabaton line
  fill steelDark rect(1:13, 11:16)
  px gold 6:14
  fill steelInk rect(1:36, 11:39)
  px steelSpec 4:3
  pin hip 6:1

# authored ONCE, true orientation: blade up, grip/pommel at the bottom.
# `grip` pin marks the held point (mid-grip) — fitted into the hand in every view, never flipped.
draw sword 9x48:
  blade = poly(4:0, 6:4, 6:30, 3:30, 3:4)
  fill steelLite blade
  line steelSpec 4:2 4:29
  line steelDark 5:5 5:29
  # crossguard
  fill gold rect(0:30, 8:33)
  fill goldDark rect(0:33, 8:34)
  # grip + pommel
  fill steelInk rect(3:34, 6:43)
  fill gold rect(2:43, 7:47)
  px goldDark 4:47
  pin grip 4:38
  pin tip 4:0          # blade tip — the aim pin for orienting the sword per view (ADR-0092)

draw capeEdge 10x34:
  drape = poly(0:0, 9:2, 7:33, 2:31)
  cel drape capeM 3
  line capeDark 4:4 5:32
  pin top 5:1

draw knightFront 64x128:
  # contact shadow first (feet cover it; below the 50% floor so `outline` skips it)
  fill shadowCol.alpha(38%) ellipse(32:123, 15:3)
  # cape peeks behind each shoulder
  stamp capeEdge 12:44
  stamp capeEdge 42:44 flipx
  # chainmail between the legs (fills the inter-leg gap; legs stamp over the sides)
  fill chain rect(29:88, 34:119)
  # legs (back-to-front: legs, torso/faulds cover the tops)
  pin a.hipL 26:84
  pin a.hipR 38:84
  fit legFront.hip a.hipL
  fit legFront.hip a.hipR
  # torso root
  stamp torsoFront 14:43
  pin a.neck 32:44
  pin a.shoulderL 20:48
  pin a.shoulderR 44:48
  # arms
  fit armFront.shoulder a.shoulderL
  fit armFront.shoulder a.shoulderR
  # pauldrons over the arm/torso seams
  stamp pauldron 12:44
  stamp pauldron 36:44 flipx
  # head
  fit helmFront.chin a.neck
  # sword: grip in the figure's left fist (viewer right), blade up — grip-pinned, never flipped
  pin a.grip 45:70
  fit sword.grip a.grip
  # single whole-figure silhouette outline, last statement
  outline

# ===================== SIDE PARTS (facing left; a new pose, not a flip) =====================

draw helmSide 34x36:
  crest = curvePoly(23:9, 29:3, 33:8, 31:14, 25:14)
  cel crest cloth 3
  shell = poly(16:8, 24:9, 28:16, 26:28, 22:33, 10:33, 7:28, 6:20, 8:12, 11:9)
  cel shell plate 4
  px steelSpec 11:12
  # visor slit (front-left) + breath holes
  fill slit poly(6:18, 13:19, 13:22, 6:22)
  px slit 8:26
  px slit 10:27
  px gold 20:30
  pin chin 15:35

draw torsoSide 28x44:
  body = poly(10:1, 20:1, 23:9, 21:24, 24:43, 6:43, 8:26, 6:13, 8:4)
  cel body plate 4
  line steelInk 8:8 7:26
  px steelSpec 9:5
  px steelSpec 10:5
  # gorget + belt
  fill gold rect(10:1, 18:3)
  fill goldDark rect(6:26, 24:29)
  fill gold rect(10:26, 15:29)
  # back plate seam
  line steelInk 20:11 22:41
  pin neck 14:1
  pin shoulder 15:6
  pin hip 14:43

draw armSide 10x26:
  upper = poly(3:0, 8:0, 8:12, 6:18, 3:25, 0:25, 1:18, 2:12)
  cel upper plate 4
  fill steelDark rect(0:15, 7:17)
  px steelSpec 4:2
  pin shoulder 5:1

draw legSide 13x40:
  body = poly(3:0, 10:0, 11:13, 9:25, 10:33, 3:36, 0:39, 0:35, 2:26, 1:13)
  cel body plate 4
  fill steelDark rect(2:13, 10:16)
  px gold 6:14
  fill steelInk poly(0:35, 3:33, 3:36, 0:39)
  px steelSpec 4:3
  pin hip 6:1

draw capeSide 26x64:
  drape = curvePoly(2:0, 10:2, 8:20, 14:38, 22:58, 12:62, 4:44, 1:22, 0:6)
  cel drape capeM 3
  line capeDark 7:10 11:44
  line capeDark 12:30 17:54
  pin top 3:1

draw knightSide 64x128:
  # contact shadow
  fill shadowCol.alpha(38%) ellipse(30:123, 15:3)
  # cape flows behind, from the back shoulder
  stamp capeSide 33:44
  # seal the inter-leg slot (matches the front/back crotch fill; legs stamp over it)
  fill chain rect(31:87, 34:119)
  # back leg (far): neutral-grey tint for depth, pushed back
  stamp legSide 33:85 tint #2b2b2b 42%
  # front leg
  pin a.hip 26:86
  fit legSide.hip a.hip
  # torso root
  stamp torsoSide 17:43
  pin a.neck 31:44
  pin a.shoulder 30:49
  # near arm (forward)
  fit armSide.shoulder a.shoulder
  # pauldron over the shoulder seam
  stamp pauldron 22:45
  # head profile
  fit helmSide.chin a.neck
  # sword: grip in the near (forward) fist; `aim` cants the blade up-forward so it lies across the
  # front of the body instead of stabbing straight up into the head (ADR-0092)
  pin a.grip 23:74
  fit sword.grip a.grip aim tip 9:48
  # single whole-figure silhouette outline, last statement
  outline

# ===================== BACK PARTS (facing away; cape dominates) =====================

draw helmBack 30x36:
  crest = curvePoly(15:0, 11:5, 13:12, 15:11, 17:12, 19:5)
  cel crest cloth 3
  shell = poly(15:8, 25:13, 26:24, 23:34, 18:37, 12:37, 7:34, 4:24, 5:13)
  cel shell plate 4
  px steelSpec 9:14
  # center back ridge + neck guard (no face)
  line steelInk 15:12 15:33
  fill steelDark rect(8:32, 22:35)
  px gold 9:30
  px gold 21:30
  pin chin 15:36

draw capeBack 50x72:
  drape = curvePoly(15:1, 35:1, 41:16, 45:38, 47:70, 34:66, 25:71, 16:66, 3:70, 5:38, 9:16)
  cel drape capeM 3
  # gold collar trim
  fill gold rect(16:1, 34:3)
  fill goldDark rect(16:3, 34:4)
  # center seam + fold shadows/highlight (drape profile carries the value spread; folds add detail)
  line capeDark 25:4 25:69
  line capeDark 18:8 10:64
  line capeDark 32:8 40:64
  line capeLite 21:6 18:60
  pin top 25:1

draw knightBack 64x128:
  # contact shadow
  fill shadowCol.alpha(38%) ellipse(32:123, 15:3)
  # chainmail + back of legs (lower legs peek below the cape)
  fill chain rect(29:88, 34:119)
  pin a.hipL 26:84
  pin a.hipR 38:84
  fit legFront.hip a.hipL
  fit legFront.hip a.hipR
  # cape drapes over the whole back (mounted prop: fits AFTER the body, z-inverted vs front/side)
  pin a.capeTop 32:42
  fit capeBack.top a.capeTop
  # pauldrons peek above the cape at the shoulders — declared in FRONT of the cape (ADR-0092)
  stamp pauldron 12:44 front capeBack
  stamp pauldron 36:44 flipx front capeBack
  # head from behind (hair/nape, no face)
  pin a.neck 32:44
  fit helmBack.chin a.neck
  # sword slung on the back, blade-up in the figure's left hand — `aim` cants it out to the left so it
  # reads as carried behind the back, and `behind capeBack` tucks the grip-side edge behind the body
  # instead of floating in front of the sprite (ADR-0092)
  pin a.grip 14:74
  fit sword.grip a.grip aim tip 2:36 behind capeBack
  # single whole-figure silhouette outline, last statement
  outline

# ===================== FINISHED SHEET (all three views, transparent) =====================

draw knightSheet 216x150:
  stamp knightFront 8:8
  stamp knightSide 76:8
  stamp knightBack 144:8
  text steelDark 25:139 "FRONT" font small
  text steelDark 97:139 "SIDE" font small
  text steelDark 165:139 "BACK" font small

export knightFront characters-ro/knight-front:
  png @1 @4

export knightSide characters-ro/knight-side:
  png @1 @4

export knightBack characters-ro/knight-back:
  png @1 @4

export knightSheet characters-ro/knight-sheet:
  png @1 @2
