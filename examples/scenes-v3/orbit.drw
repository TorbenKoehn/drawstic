# Raumstation im Orbit — space station orbiting an ocean world, starfield behind.
# Light: the sun sits off-canvas upper-right; everything is lit from up-right,
# shadowed down-left. `light` is the single shared light point for all shading.

# ===========================================================================
# STATION COMPONENTS (stamped into the scene)
# ===========================================================================

# One solar array wing: gold frame, photovoltaic cell field, cell seams.
draw solarWing(c) 78x34:
  rect #b0904a 0:0 77:33 fill
  panel = rect(2:2, 75:31)
  fill c panel
  seam = c.lighten(16%)
  for i 1..6:
    line seam (2 + i * 12):2 (2 + i * 12):31
  line seam 2:12 75:12
  line seam 2:22 75:22
  # faint sheen so the flat field is not dead
  fill c.lighten(10%).alpha(40%) rect(2:2, 37:31)

# Parabolic comms dish: concave face, feed tripod, horn.
draw dish 34x32:
  ellipse #b9beca 17:16 16:14 fill
  ellipse #828895 17:16 13:11 fill
  ellipse #565c69 17:16 9:8 fill
  ellipse #3a3f4b 17:16 5:4 fill
  line #9aa0ad 17:16 25:2
  line #9aa0ad 17:16 14:1
  rrect #d3d8e1 21:0 28:5 2 fill

# Little approaching shuttle (foreground scale + docking story).
draw shuttle 28x15:
  rrect #cbcfd7 2:4 21:11 5 fill
  poly #dde1e9 21:4 27:7 21:11 fill
  poly #9aa0ad 2:4 2:0 8:4 fill
  poly #9aa0ad 2:11 2:15 8:11 fill
  rrect #33405e 5:5 11:9 1 fill
  rrect #8fd8ff 5:5 10:7 1 fill
  fill #444a57 rect(2:6, 5:9)
  px #ff8a3a 1:7
  px #ffbf72 0:7

draw scene 384x256:
  light = 470:-70

  # --- deep space backdrop -------------------------------------------------
  grad space = linear(90, #0a0b22, #04040c)
  bg space

  # faint nebula washes (stacked translucent masses, cool + warm)
  grad neb1 = radial(#3a1f66.alpha(40%), #3a1f66.alpha(0%))
  grad neb2 = radial(#123f52.alpha(34%), #123f52.alpha(0%))
  fill neb1 ellipse(300:60, 120:70)
  fill neb2 ellipse(70:150, 110:80)

  # --- starfield -----------------------------------------------------------
  scatter s 150 7 rect(0:0, w-1:h-1):
    px #cdd6ff.alpha(0.22 + rand(3, s.x + s.y * 7) * 0.7) s
  scatter b 22 5 rect(0:0, w-1:120):
    px #ffffff.alpha(0.7 + rand(8, b.x) * 0.3) b
    px #ffffff.alpha(0.35) b+1:0
    px #ffffff.alpha(0.35) b-1:0
    px #ffffff.alpha(0.35) b+0:1
    px #ffffff.alpha(0.35) b+0:-1

  # --- planet (huge sphere; we see its upper-right limb curving the base) ---
  pl = circle(120:430, 300)
  grad ocean = linear(90, #1f5da0, #123a70)
  fill ocean pl

  # continents (organic masses, clipped to the sphere)
  land1 = curvePoly(60:180, 130:150, 210:170, 250:220, 170:250, 80:240).intersect(pl)
  land2 = curvePoly(300:210, 350:190, 384:230, 340:256, 300:250).intersect(pl)
  fill #3f7a4c land1
  fill #6f6238 land2
  # coastal + highland variation
  fill #52915a land1.subtract(land1.scale(0.9).shift(6:6))
  fill #8a7a46 land2.intersect(circle(340:210, 26))
  # faint surface mottling (texture, keeps the sphere from reading flat)
  grain pl 0.05 7 #0c2448

  # swirling cloud bands (thin, translucent, curving with latitude)
  fill #eef4ff.alpha(24%) curvePoly(70:246, 170:212, 270:222, 344:204, 268:236, 168:230).intersect(pl)
  fill #ffffff.alpha(16%) curvePoly(120:300, 230:286, 320:298, 232:312, 128:312).intersect(pl)
  fill #eef4ff.alpha(18%) curvePoly(210:352, 300:342, 360:356, 300:366, 214:366).intersect(pl)

  # spherical light: warm day highlight near the sun, deep falloff to night
  lightRegion pl light #fff0cc 0.34
  shadeRegion pl light #04081a 0.82

  # city lights on the night side (alpha keyed to distance from the sun)
  scatter c 130 4 pl:
    px #ffce74.alpha(clamp((dist(c, light) - 380) / 120, 0, 1) * 0.9) c

  # atmosphere: cyan glow hugging the lit limb — inner haze + stacked outer rings
  fill #8fd8ff.alpha(28%) circle(120:430, 300).subtract(circle(120:430, 293))
  fill #bdebff.alpha(46%) circle(120:430, 301).subtract(circle(120:430, 298))
  fill #8fd8ff.alpha(30%) circle(120:430, 304).subtract(circle(120:430, 300))
  fill #7ac8ff.alpha(20%) circle(120:430, 308).subtract(circle(120:430, 304))
  fill #6ab8ff.alpha(12%) circle(120:430, 313).subtract(circle(120:430, 308))

  # =========================================================================
  # SPACE STATION (foreground) — hub + rotating ring, lit from the shared sun
  # =========================================================================
  cx = 206
  cy = 106
  metal = #9aa0ad
  rimLit = #fff4dc
  grad hullG = linear(90, #d6dbe4, #3c414f)

  ring = ellipse(cx:cy, 120:46).subtract(ellipse(cx:cy, 98:34))
  backRing = ring.intersect(rect(0:0, 383:cy))
  frontRing = ring.intersect(rect(0:cy, 383:255))
  hub = rrect(158:88, 254:124, 16)

  # back arc of the ring (behind the hub)
  fill metal backRing
  # central hub cylinder (vertical gradient = round cross-section)
  fill hullG hub
  # recessed panel ribs (drawn before shading so the cylinder light unifies them)
  for i 1..4:
    rx = 158 + i * 19
    line #565b68 rx:93 rx:119
    line #b9bec9 (rx + 1):93 (rx + 1):119
  # struts bridging hub to ring
  st = #6b7080
  rect st 108:104 158:108 fill
  rect st 254:104 304:108 fill
  rect st 204:70 208:88 fill
  rect st 204:124 208:140 fill
  # front arc of the ring (in front of the hub)
  fill metal frontRing

  # radial truss rungs segmenting the ring
  for i 0..24:
    t = i * tau / 24
    co = cos(t)
    si = sin(t)
    line #474c59 (cx + co * 98):(cy + si * 34) (cx + co * 120):(cy + si * 46)

  # global light on all station metal (same sun point as the planet)
  lightRegion ring light #ffffff 0.26
  shadeRegion ring light #10131d 0.6
  shadeRegion hub light #14171f 0.30
  ambientOcclusion ring #0d0f16 0.5
  # directional sun rim: only the upper-right outer edge
  rim ring.intersect(rect(cx:44, 340:cy)) -1:1 rimLit 2
  # planetshine: faint cool bounce light from the planet below on undersides
  lightRegion hub 206:430 #5aa0e0 0.14
  lightRegion ring 206:430 #5aa0e0 0.12
  # subtle brushed-metal grain
  grain hub 0.05 3 #e8ecf2
  grain ring 0.045 4 #e8ecf2

  # --- hub bright accents (after shading, so they stay crisp) ---------------
  # top specular strip + bottom shadow band → rounder cylinder
  fill #eef2f8.alpha(55%) hub.intersect(rect(162:92, 250:96))
  fill #23272f.alpha(50%) hub.intersect(rect(162:118, 250:123))
  # docking collars at both ends
  fill #c3c8d2 hub.intersect(rect(156:92, 166:120))
  fill #c3c8d2 hub.intersect(rect(246:92, 256:120))
  line #4a4f5b 166:93 166:119
  line #4a4f5b 246:93 246:119
  # rim-lit right collar edge (sun side)
  fill rimLit.alpha(70%) hub.intersect(rect(253:96, 256:116))
  # row of warm-lit windows
  for i 0..5:
    wx = 172 + i * 14
    fill #7a5a1e rect(wx:102, (wx + 7):111)
    fill #ffce70 rect((wx + 1):103, (wx + 6):110)
    fill #fff0c0 rect((wx + 1):103, (wx + 6):105)

  # --- solar wings: mounted on the ring, foreshortened in 3D (rotatey) ------
  # mounting booms
  fill st rect(66:103, 90:109)
  fill st rect(322:103, 346:109)
  line #b9bec9 66:103 90:103
  line #b9bec9 322:103 346:103
  # left wing (obliquely lit → tinted down) and right wing (full sun)
  stamp solarWing(#22397a) 48:106 anchor center transform rotatey(52).perspective(200).about(39:17) tint #10203f 0.18
  stamp solarWing(#22397a) 356:106 anchor center transform rotatey(-52).perspective(200).about(39:17)

  # --- comms dish on a mast over the hub ------------------------------------
  fill st rect(246:60, 250:90)
  stamp dish 248:60 anchor bottom
  rim ellipse(248:44, 16:14).intersect(rect(248:30, 264:44)) -1:1 rimLit 1

  # --- nav beacons on the ring (port red / starboard green) -----------------
  fill #ff3838.alpha(28%) circle(88:106, 6)
  fill #ff5050.alpha(55%) circle(88:106, 3)
  px #ffd0d0 88:106
  fill #38ff70.alpha(28%) circle(324:106, 6)
  fill #58ff88.alpha(55%) circle(324:106, 3)
  px #d6ffe0 324:106

  # --- approaching shuttle (foreground: scale, depth, docking story) --------
  stamp shuttle 150:180 anchor center tint #12203a 0.14
  # engine plume trailing straight back from the tail
  fill #ff7a30.alpha(28%) ellipse(131:181, 7:3)
  fill #ffab4a.alpha(52%) ellipse(134:181, 3:2)
  px #ffe8b0 136:181
  # sun glint on the shuttle's nose
  px #fff2d8 162:179

  # --- sun glint in the upper-right (anchors the light direction) -----------
  fill #fff4d8.alpha(10%) circle(356:22, 16)
  fill #fff6e0.alpha(16%) circle(356:22, 9)
  fill #fff6e0.alpha(30%) circle(356:22, 5)
  line #fff6e0.alpha(50%) 338:22 374:22
  line #fff6e0.alpha(50%) 356:6 356:38
  px #ffffff 356:22

export scene scenes-v3/orbit:
  png @1 @4
