# Desert caravan, golden hour
# Light: low sun at right (238:58); all shadows fall left.

# Sky and light
skyHi = oklch(0.40, 0.09, 285)
skyMd = oklch(0.60, 0.10, 45)
skyLo = oklch(0.82, 0.11, 72)
gold = oklch(0.94, 0.09, 88)
sunC = oklch(0.98, 0.04, 95)
haze = oklch(0.85, 0.06, 75)
dusk = oklch(0.34, 0.06, 295)
cloudC = dusk.mix(skyMd, 55%).alpha(70%)

gradient sky = linear(90, (skyHi, 0%), (skyMd, 52%), (skyLo, 84%), (gold, 100%))

# Sand — Tiefenstaffelung via mix Richtung Dunst
sand = oklch(0.74, 0.09, 70)
d1c = sand.mix(haze, 72%)
d2c = sand.mix(haze, 52%)
d2bc = sand.mix(haze, 33%)
d3c = sand.mix(haze, 15%)
d4c = sand.darken(22%).saturate(10%)

gradient hazeV = linear(90, haze.alpha(22%), haze.alpha(0%))
gradient d3g = linear(90, d3c.lighten(6%), d3c.darken(14%))
gradient d4g = linear(90, d4c.lighten(4%), d4c.darken(18%))

# Karawane
camelC = oklch(0.40, 0.055, 60)
camelD = camelC.darken(20%)
robes = #a03028, #274068, #b07830, #705890
ropeC = #4a3a28

# Ein Gradient spannt immer die BBox der Region, die er malt. Ein Punktlicht-Wasch ist
# deshalb ein `radial`-Fill ueber einen Span, der um das Licht zentriert ist und genau bis
# zur fernsten Ecke der Zielregion reicht (d = groesster Abstand in x bzw. y).
fn washSpan(p, d) = rect((p - d), (p + d))

# Kammlinien (absolute y, nx = normiertes x)
fn bump(nx, c, k) = exp(0 - pow((nx - c) * k, 2))
fn r1(nx) = 90 - round(5 * noise(11, nx * 5, 0))
fn r2(nx) = 106 - round(9 * noise(23, nx * 3.5, 0)) - round(6 * bump(nx, 0.85, 3))
fn r2b(nx) = 124 - round(5 * noise(53, nx * 3, 0)) - round(8 * bump(nx, 0.28, 2.2))
fn r3(nx) = 139 - round(27 * (if nx < 0.55 then bump(nx, 0.55, 3.4) else bump(nx, 0.55, 1.4))) - round(6 * noise(31, nx * 4, 0))
fn r4(nx) = 168 - round(12 * noise(47, nx * 2.5, 0)) - round(10 * bump(nx, 0.1, 3)) - round(8 * bump(nx, 0.98, 5))

draw camel(cb, cd) 30x26:
  # Far legs first (darker)
  line cd 10:16 8:25 w2
  line cd 19:16 21:25 w2
  ellipse cb 13:13 8:5 fill
  circle cb 12:7 4 fill
  poly cb 19:10 24:3 26:5 21:13 fill
  ellipse cb 26:3 3:2 fill
  px cb 25:0
  px cb 29:4
  line cb 6:11 3:16
  px cb 3:17
  line cb 12:17 13:25 w2
  line cb 17:17 16:25 w2

draw camelLoaded(cb, cd, robe, m) 30x28:
  stamp camel(cb, cd) 0:2
  rect robe 9:9 16:13 fill
  rect robe.darken(25%) 9:12 16:13 fill
  if m == 1:
    rect robe 11:2 14:6 fill
    rect #e8d8b8 12:0 13:1 fill
  else:
    rrect robe.darken(10%) 10:4 15:8 2 fill
    line robe.darken(35%) 10:8 15:8

draw camelFar 12x8:
  palette f = #6b5540
  pixels:
    ....f.....f.
    ...fff...fff
    ..fffff..ff.
    .ffffffffff.
    .fffffffff..
    ..f.f..f.f..
    ..f.f..f.f..
    ..f.f..f.f..

draw bird 5x3:
  palette k = #2a2118
  pixels:
    k...k
    .k.k.
    ..k..

draw tuft(c) 9x7:
  line c 4:6 0:2
  line c 4:6 3:0
  line c 4:6 6:0
  line c 4:6 8:2
  line c.darken(15%) 4:6 2:4

draw rock(c) 14x9:
  ellipse c 5:5 5:3 fill
  ellipse c 9:4 4:3 fill

draw desert 320x180:
  sun = 238:58
  # Alle Duenen laufen bis zum unteren Bildrand, teilen also einen Wasch-Span:
  # fernste Ecke ist immer 0:179.
  duneWash = washSpan(sun, 238:121)

  # ── Himmel ──
  rect sky 0:0 319:104 fill
  # Wolkenstreifen, von unten goldig angestrahlt
  ellipse cloudC 66:24 30:2 fill
  ellipse cloudC 96:31 22:2 fill
  line gold.alpha(60%) 40:27 92:27
  ellipse cloudC 190:18 26:2 fill
  line gold.alpha(45%) 170:21 212:21
  ellipse cloudC.alpha(50%) 258:40 18:1 fill
  line gold.alpha(70%) 244:42 272:42
  # blasser Mond links oben
  mask moon = circle(46:22, 5).subtract(circle(48:21, 5))
  fill #f0ead8.alpha(55%) moon

  # ── Sonne + Glow (gestapelte Alpha-Scheiben) ──
  circle gold.alpha(8%) sun 46 fill
  circle gold.alpha(12%) sun 34 fill
  circle gold.alpha(18%) sun 25 fill
  circle sunC.alpha(30%) sun 18 fill
  circle sunC sun 13 fill
  circle sunC.lighten(4%) sun 9 fill

  # Birds
  stamp bird 150:38
  stamp bird 162:44
  stamp bird 141:47

  # ── Fern-Grat ──
  mask m1 = profile(0..w, r1)
  fill d1c m1
  mask m1:
    fill radial(gold.alpha(30%), gold.alpha(0%)) duneWash

  # ── Grat 2 + Fern-Karawane ──
  mask m2 = profile(0..w, r2)
  fill d2c m2
  mask m2:
    fill radial(gold.alpha(18%), gold.alpha(0%)) duneWash
  for j 0..5:
    fx = 246 + j * 15
    fy = r2(fx / 319) + 1
    line dusk.alpha(35%) (fx - 9):(fy + 1) (fx - 2):(fy + 1)
    stamp camelFar (fx - 6):(fy - 7) tint haze 50%

  # Horizontdunst (weich auslaufend)
  fill hazeV rect(0:84, 319:116)

  # ── Zwischengrat (Tiefen-Trittstein links) ──
  mask m2b = profile(0..w, r2b)
  fill d2bc m2b
  mask m2b:
    fill radial(gold.alpha(12%), gold.alpha(0%)) duneWash

  # Main dune
  mask m3 = profile(0..w, r3)
  fill d3g m3
  mask m3:
    fill radial(dusk.alpha(0%), dusk.alpha(48%)) duneWash
    fill radial(gold.alpha(15%), gold.alpha(0%)) duneWash
  ripple m3 0.25 9 sand.lighten(18%).alpha(50%)
  ripple m3 0.2 12 dusk.alpha(25%)
  # Kamm-Rimlicht rechts vom Scheitel
  fill gold.alpha(85%) m3.edge(0:1).intersect(rect(176:100, 310:126))
  # Windstreifen auf der Sonnenflanke
  sy1 = r3(210 / 319)
  sy2 = r3(265 / 319)
  sy3 = r3(315 / 319)
  curve dusk.alpha(22%) (205):(sy1 + 7) (262):(sy2 + 6) (315):(sy3 + 9)
  curve sand.lighten(15%).alpha(35%) (215):(sy1 + 13) (270):(sy2 + 14) (316):(sy3 + 17)
  curve dusk.alpha(16%) (228):(sy1 + 22) (278):(sy2 + 23) (317):(sy3 + 27)

  # Footprints behind the caravan
  for t 0..9:
    fx2 = 10 + t * 5
    fy2 = r3(fx2 / 319) + 3
    px dusk.alpha(40%) fx2:fy2
    px dusk.alpha(30%) (fx2 + 2):(fy2 + 1)

  # ── Karawane (hinten → vorn, Leittier zuletzt) ──
  for i 0..4:
    k = 3 - i
    cx = 210 - k * 54 - (k mod 2) * 7
    fy3 = r3(cx / 319) + 2
    tlx = cx - 15
    tly = fy3 - 27
    robe = robes.cycle(k)
    m = if k == 0 then 1 else 0
    camR = region(camelLoaded(camelC, camelD, robe, m)).shift((tlx):(tly))
    shadowR = region(camelLoaded(camelC, camelD, robe, m)).transform(flipy().about(15:27)).transform(skew(-64).about(15:27)).shift((tlx):(tly))
    fill dusk.alpha(26%) shadowR.intersect(m3).intersect(rect((0):(fy3 - 1), (319):(fy3 + 12)))
    ellipse dusk.alpha(35%) (cx):(fy3) 9:2 fill
    stamp camelLoaded(camelC, camelD, robe, m) (tlx):(tly)
    fill gold.alpha(65%) camR.edge((0 - 1):1).intersect(rect((tlx):(tly), (tlx + 29):(tly + 15)))
    if k < 3:
      # Seil zum nachfolgenden Tier
      fcx = 210 - (k + 1) * 54 - ((k + 1) mod 2) * 7
      hx = fcx + 11
      hy = r3(fcx / 319) + 2 - 27 + 6
      tx2 = cx - 4
      ty2 = tly + 11
      quad ropeC (hx):(hy) ((hx + tx2) // 2):(((hy + ty2) // 2) + 3) (tx2):(ty2)

  # Staubfahne hinter dem Schlusstier
  ellipse haze.alpha(18%) (27):(r3(41 / 319) - 1) 9:4 fill

  # Foreground dune
  mask m4 = profile(0..w, r4)
  fill d4g m4
  mask m4:
    fill radial(dusk.alpha(0%), dusk.alpha(45%)) duneWash
  ripple m4 0.5 7 sand.lighten(10%).alpha(50%)
  ripple m4 0.4 13 dusk.alpha(35%)
  grain m4 0.2 5 dusk.alpha(45%)
  # Kammlicht: `edge` schneidet erst die Silhouette, der Clip kommt danach. Nur so ist
  # das Rechteck eine reine Auswahl (rechte Haelfte) und kein zweiter Kantengeber — der
  # untere Rand darf den Grat nicht mehr stillschweigend abschneiden.
  fill sand.lighten(25%).alpha(55%) m4.edge(0:1).intersect(rect(150:0, 319:172))
  # Windlinien, dem Kamm folgend
  wy1 = r4(60 / 319) + 5
  wy2 = r4(160 / 319) + 4
  wy3 = r4(255 / 319) + 6
  curve sand.lighten(22%).alpha(60%) (40):(wy1 + 1) (110):(wy2) (200):(wy2 + 3) (280):(wy3)
  curve sand.lighten(16%).alpha(45%) (70):(wy1 + 8) (170):(wy2 + 9) (270):(wy3 + 7)
  # Kiesel
  scatter g 24 3 m4.intersect(rect(0:150, 319:174)):
    px d4c.darken(30%) g
    px d4c.lighten(15%) (g.x + 1):(g.y)
  # Rocks on the left and grass tufts on the right
  ellipse dusk.alpha(40%) 31:164 9:2 fill
  ellipse dusk.alpha(25%) 16:165 11:2 fill
  stamp rock(#5f4a38) 24:156
  fill linear(154, dusk.alpha(33%), dusk.alpha(35%)) region(rock(#5f4a38)).shift(24:156)
  line #8a6f52.alpha(80%) 31:157 36:158
  ellipse dusk.alpha(30%) 44:166 5:1 fill
  stamp rock(#564334) 40:162
  fill linear(154, dusk.alpha(33%), dusk.alpha(35%)) region(rock(#564334)).shift(40:162)
  stamp tuft(#665c34) 280:148
  stamp tuft(#575030) 300:158

  # ── globale Lichtvereinheitlichung ──
  fill radial(dusk.alpha(0%), dusk.alpha(14%)) duneWash

export desert:
  png @1 @4
