# Skeleton warrior — modular Ragnarok-Online chibi (front + side, faction recolor).
# ONE light contract: sun top-left -> highlights upper-left, core shadow lower-right,
# contact shadow ellipse under the feet. Big skull (~1/3 of the figure), visible ribs,
# a broken wooden shield and a rusty short sword. Bone ramp = warm ivory, never white.

warm    = #ffe9c4
cool    = #35506e
ink = #2a2024          # very dark warm silhouette contour

boneHi  = #f3e9d0          # warm ivory highlight (not pure white)
boneLite = #ddc9a1
boneMid = #c2a878          # base
boneShd = #9b8155
boneDrk = #695135          # darkest bone: sockets, inner separation lines

wood     = #7a5734
woodLite = #9c7442
woodDrk  = #4a3520
steel    = #9aa0a8
steelHi  = #c6cbd2
rust     = #8a5a38
grip     = #52402a
gripHi   = #6f5636

# faction cloth colours (the recolor axis, threaded part -> body -> wrapper)
crimson = #8a2f2f
azure   = #2f4f8a

# proportions (front + side share the vertical lines)
headTop      = 1
shoulderLine = 25
hipLine      = 42
footLine     = 59

# ============================================================
# Parts — front view (non-exported components)
# ============================================================

# skull: bottom-center seam at row 21 (chin reaches row 21, no buffer row)
draw skull 20x22:
  pal:
    k = ink
    x = boneHi
    l = boneLite
    m = boneMid
    s = boneShd
    d = boneDrk
  pixels:
    ......kkkkkkkk......
    ....kxxllmmmsssk....
    ...kxxllmmmmssssk...
    ..kxxlllmmmmsssssk..
    .kxxlllmmmmmssssssk.
    .kxxllmmmmmmssssssk.
    .klldddddmmdddddssk.
    .klmdkkkdmmdkkkdssk.
    .klmdkkkdmmdkkkdssk.
    .klmmdkdmmmmdkdsssk.
    .klmmddmmmmmddmsssk.
    .klmmmmmmddmmmssssk.
    ..klmmmmdkkdmmsssk..
    ...klmmmdddmmsssk...
    ....klmmmmmmsssk....
    ....klmmmmmssssk....
    ....kldmdmdmdssk....
    ....kmdmdmdmdssk....
    ....kmmmdmdmmssk....
    .....klmmmmsssk.....
    ......klmmmssk......
    .......klmssk.......

# ribcage + pelvis: top neck seam rows 0-1, pelvis bottom seam row 21
draw ribTorso 18x22:
  pal:
    k = ink
    x = boneHi
    l = boneLite
    m = boneMid
    s = boneShd
    d = boneDrk
  pixels:
    .......kllk.......
    .......kmmk.......
    ..kxllmmmmmssssk..
    ..kxlmmmmmmssssk..
    .kxllmmmmmssssssk.
    .kxlmmmmssssssssk.
    .klmddddmmddddssk.
    .kxllmmmmmssssssk.
    .kxlmmmmssssssssk.
    ..klmdddmmdddssk..
    ..kxlmmmmmsssssk..
    ..kxlmmmsssssssk..
    ...kldddmmdddsk...
    ...kxlmmmsssssk...
    ...kxlmmssssssk...
    ....klddmmddsk....
    ...kxlmmmmssssk...
    ...klmdmmmmdssk...
    ....klmdmmdssk....
    .....klmddmsk.....
    .....klmddmsk.....
    ......kmddmk......

# thin arm bone: highlight-left / dark-right edge (no full stroke on a thin bar),
# small hand at rows 15-16
draw boneArm 6x18:
  pal:
    k = ink
    x = boneHi
    m = boneMid
    s = boneShd
    d = boneDrk
  pixels:
    .kmsk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xdsk.
    .kddk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xmsk.
    .xdsk.
    kmmmsk
    kmmmsk
    .kkkk.

# thin leg bone: femur / knee / tibia / tiny foot
draw boneLeg 7x18:
  pal:
    k = ink
    x = boneHi
    m = boneMid
    s = boneShd
    d = boneDrk
  pixels:
    .kmmsk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xdmsk.
    .kddkk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xmmsk.
    .xdmsk.
    .kddkk.
    .kmssk.
    .kkkk..

# rusty short sword: steel blade with rust patches, crossguard, wrapped grip
draw rustSword 5x22:
  pal:
    k = ink
    g = grip
    G = gripHi
    t = steel
    h = steelHi
    r = rust
    d = boneDrk
  pixels:
    .ggg.
    .Ggk.
    .ggk.
    .ggk.
    htttd
    .htd.
    .htd.
    .hrd.
    .htd.
    .htd.
    .hrd.
    .htd.
    .hrd.
    .htd.
    .htd.
    .hrd.
    .htd.
    .htd.
    .ttd.
    .td..
    .td..
    .d...

# broken wooden shield: bite notch (.subtract), crack, plank seams, steel rivets.
# accent = the faction heraldic band down the centre plank.
draw brokenShield(accent) 16x18:
  shape = rrect(1:1, 14:16, 4).subtract(circle(14:3, 4))
  fill wood shape
  fill woodLite shape.intersect(rect(0:0, 5:17))
  fill woodDrk shape.intersect(rect(11:5, 15:17))
  line woodDrk 6:2 6:15
  line woodDrk 10:2 10:15
  fill accent shape.intersect(rect(6:1, 9:16))
  fill accent.lighten(18%) shape.intersect(rect(6:1, 7:8))
  fill accent.darken(20%) shape.intersect(rect(8:9, 9:16))
  line ink 12:6 8:10
  line ink 8:10 9:15
  circle steel 3:4 1 fill
  px steelHi 3:4
  circle steel 3:13 1 fill
  px steelHi 3:13
  circle steel 12:13 1 fill
  px steelHi 12:13
  stroke ink shape

# ============================================================
# Body — front view
# ============================================================

draw bodyFront(accent) 40x64:
  ellipse cool.alpha(32%) 20:60 12:2 fill
  stamp boneLeg 13:42
  stamp boneLeg 21:42
  stamp ribTorso 11:22
  stamp boneArm 6:25
  stamp boneArm 28:25
  stamp rustSword 29:38
  stamp skull 10:1
  stamp brokenShield(accent) 2:32

# ============================================================
# Parts — side view (profile, faces +x / right; pose-leading parts redrawn)
# ============================================================

draw skullSide 22x22:
  cranium = circle(9:10, 8)
  face = poly(11:6, 20:9, 19:16, 13:19, 11:16)
  skull = cranium.union(face)
  fill boneMid skull
  fill boneLite skull.intersect(rect(0:0, 11:9))
  fill boneHi cranium.intersect(rect(2:3, 8:8))
  fill boneShd skull.intersect(rect(12:12, 21:21))
  fill boneShd cranium.intersect(rect(13:13, 17:17))
  circle ink 15:11 2 fill
  fill boneDrk circle(15:11, 3).subtract(circle(15:11, 2)).intersect(rect(11:6, 21:11))
  fill ink poly(19:11, 21:13, 19:14)
  px boneHi 13:8
  line boneDrk 12:16 19:16
  fill boneLite rect(12:17, 19:18)
  px ink 13:17
  px ink 15:17
  px ink 17:17
  fill boneMid poly(11:18, 17:19, 15:21, 11:21)
  stroke ink skull

draw ribTorsoSide 14x22:
  spine = rect(1:2, 3:20)
  fill boneMid spine
  fill boneHi rect(1:2, 1:20)
  fill boneShd rect(3:2, 3:20)
  fill boneMid poly(3:3, 12:5, 12:6, 3:5)
  fill boneMid poly(3:7, 12:9, 12:10, 3:9)
  fill boneMid poly(3:11, 11:13, 11:14, 3:13)
  fill boneShd poly(9:5, 12:6, 12:10, 9:9)
  fill boneMid poly(2:15, 12:16, 11:20, 2:20)
  fill boneShd poly(8:16, 12:16, 11:20, 9:20)
  fill boneDrk rect(5:17, 9:18)
  stroke ink spine.union(poly(3:3, 12:5, 12:14, 3:13)).union(poly(2:15, 12:16, 11:20, 2:20))
  px boneHi 2:3

draw shieldSide(accent) 8x18:
  outer = rrect(0:1, 7:16, 3).subtract(circle(6:3, 3))
  inner = rrect(1:2, 6:15, 2).subtract(circle(6:4, 2))
  fill ink outer
  fill wood inner
  fill accent inner.intersect(rect(0:0, 3:16))
  fill woodDrk inner.intersect(rect(4:8, 7:16))
  px steelHi 2:5
  px steelHi 2:13

# ============================================================
# Body — side view
# ============================================================

draw bodySide(accent) 44x64:
  ellipse cool.alpha(32%) 22:60 14:2 fill
  stamp boneLeg 18:42 tint #2b2b2b 40%
  stamp boneArm 27:26 tint #2b2b2b 40%
  stamp rustSword 31:38 tint #2b2b2b 40%
  stamp boneLeg 23:42
  stamp ribTorsoSide 15:22
  stamp skullSide 11:1
  stamp boneArm 22:26
  stamp shieldSide(accent) 26:33

# ============================================================
# Export wrappers — 2 views x 2 faction colours
# ============================================================

draw frontCrimson 40x64:
  stamp bodyFront(crimson) 0:0

draw frontAzure 40x64:
  stamp bodyFront(azure) 0:0

draw sideCrimson 44x64:
  stamp bodySide(crimson) 0:0

draw sideAzure 44x64:
  stamp bodySide(azure) 0:0

export frontCrimson skeleton/front-crimson:
  png @1 @4

export frontAzure skeleton/front-azure:
  png @1 @4

export sideCrimson skeleton/side-crimson:
  png @1 @4

export sideAzure skeleton/side-azure:
  png @1 @4
