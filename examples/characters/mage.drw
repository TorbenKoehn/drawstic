# Mage — modular chibi character sprite (Ragnarok-Online style, front + side, faction recolor).
# Magierin: big pointed wizard hat (wider than the body), visible hair strands, a drapery
# robe with folds, and a wooden staff crowned by a glowing orb.
# ONE light contract: sun top-left -> highlights top-left, core shadow bottom-right.
# Big head (hat ~1/3 of the figure), compact robe torso, tiny boots peeking under the hem.

warm = #ffe8bf            # light colour
cool = #2c3550            # cool shadow complement, never pure black

fn lit(c)  = c.mix(warm, 22%)
fn shd(c)  = c.darken(10%).mix(cool, 20%)
fn deep(c) = c.darken(20%).mix(cool, 34%)

# warm materials: shade via darken only (a cool mix runs OkLCh through magenta)
fn litW(c) = c.mix(warm, 20%)
fn shdW(c) = c.darken(14%)
fn dpW(c)  = c.darken(28%)

# materials (fixed across factions)
skin  = #e8b489
hair  = #7a4a24
gold  = #e8c25a
wood  = #6f4a2a
boot  = #4a3d55
edge  = #2a2024          # silhouette outline (very dark warm)

# faction cloth + orb colours (the palette-swap axis)
robeA = #40357e       # arcane indigo
glowA = #79e2ff       # cyan
robeE = #7d2740       # ember crimson
glowE = #ffb154       # amber

# proportions for a ~60px chibi figure (~2.8 heads). Shared by front AND side.
headTop      = 1
brimLine     = 15
neckLine     = 23
shoulderLine = 24
hipLine      = 39
hemLine      = 52
footLine     = 58

# ---------------------------------------------------------------- parts (front)

# head: pointed hat + wide brim + face. neck seam reaches the bottom row (row 23).
draw head(cloth) 28x24:
  cone = poly(14:0, 6:13, 22:13)
  brim = ellipse(14:15, 13:2)
  face = ellipse(14:19, 6:5)
  # hat cone
  fill cloth cone
  fill lit(cloth) cone.intersect(rect(0:0, 13:13))
  fill shd(cloth) cone.intersect(rect(15:0, 27:13))
  fill deep(cloth) cone.intersect(rect(16:7, 27:13))
  # hatband + star accent
  fill gold rect(7:11, 21:13)
  fill litW(gold) rect(7:11, 21:11)
  fill dpW(gold) rect(7:13, 21:13)
  px litW(gold) 14:7
  px gold 13:8
  px gold 15:8
  # face (drawn before the brim so the brim overhangs)
  fill skin face
  fill shdW(skin) face.intersect(rect(15:14, 27:27))
  fill shdW(skin) face.intersect(rect(0:14, 27:16))
  # hair strands framing the face
  fill hair poly(8:14, 10:14, 9:23, 7:23)
  fill hair poly(18:14, 20:14, 21:23, 19:23)
  fill shdW(hair) poly(19:15, 20:14, 21:23, 20:23)
  # neck (bottom-centre seam, flush to the last row)
  fill skin rect(12:21, 16:23)
  fill shdW(skin) rect(12:22, 16:23)
  # brim (on top; overhangs the upper face)
  fill cloth brim
  fill lit(cloth) brim.intersect(rect(0:13, 13:15))
  fill deep(cloth) brim.intersect(rect(0:16, 27:17))
  # eyes + nose + mouth (after the brim, on the visible lower face)
  fill edge rect(11:19, 12:20)
  fill edge rect(16:19, 17:20)
  px warm 11:19
  px warm 16:19
  px shdW(skin) 14:21
  line shdW(skin) 13:22 15:22

# torso: A-line drapery robe, shoulders to hem. top seam row 0, hem row 29 (covers legs).
draw robe(cloth) 28x30:
  body = poly(9:0, 18:0, 21:8, 26:29, 1:29, 6:8)
  fill cloth body
  fill lit(cloth) body.intersect(rect(0:0, 11:29))
  fill shd(cloth) body.intersect(rect(16:0, 27:29))
  fill deep(cloth) body.intersect(rect(20:13, 27:29))
  # collar / V trim + neck skin
  fill skin rect(12:0, 15:1)
  fill gold poly(10:0, 17:0, 14:6)
  fill dpW(gold) poly(13:1, 15:1, 14:6)
  # waist sash
  fill gold rect(3:15, 24:17)
  fill litW(gold) rect(3:15, 24:15)
  fill dpW(gold) rect(3:17, 24:17)
  # fold lines (deep) + a fold highlight
  line deep(cloth) 14:18 12:28
  line deep(cloth) 18:18 21:28
  line deep(cloth) 9:18 6:28
  line lit(cloth) 11:18 9:28
  # hem band
  line deep(cloth) 1:29 26:29
  line gold 3:27 24:27

# bell sleeve + small hand. shoulder seam row 0, hand rows 14..17.
draw arm(cloth) 8x18:
  body = poly(2:0, 5:0, 7:14, 0:14)
  fill cloth body
  fill lit(cloth) body.intersect(rect(0:0, 2:14))
  fill shd(cloth) body.intersect(rect(5:0, 7:14))
  fill deep(cloth) rect(0:13, 7:14)
  # hand
  fill skin ellipse(3:16, 2:2)
  fill shdW(skin) rect(3:16, 4:17)

# tiny boot peeking under the hem. top row 0, sole row 7.
draw bootFront 7x8:
  fill boot rect(1:0, 5:3)
  fill boot poly(0:4, 6:4, 6:7, 0:7)
  fill lit(boot) rect(1:0, 2:6)
  fill shd(boot) rect(5:1, 6:6)
  fill deep(boot) rect(0:7, 6:7)

# staff: wooden pole + gold claw cradling the orb. pole runs the body height.
draw staff 10x50:
  fill wood rect(4:12, 6:49)
  fill litW(wood) rect(4:12, 4:49)
  fill dpW(wood) rect(6:12, 6:49)
  # claw
  fill gold poly(2:6, 5:13, 4:13)
  fill gold poly(8:6, 5:13, 6:13)
  fill dpW(gold) poly(8:6, 7:9, 6:13)

# glowing orb (soft alpha halo, no hard outline). stamped in the wrapper, over the claw.
draw orb(glow) 16x16:
  fill glow.alpha(7%) circle(8:8, 7)
  fill glow.alpha(13%) circle(8:8, 6)
  fill glow.alpha(20%) circle(8:8, 5)
  fill glow.alpha(30%) circle(8:8, 4)
  fill glow circle(8:8, 3)
  fill glow.lighten(28%) circle(7:7, 2)
  px #ffffff 7:7

# ------------------------------------------------------------ full body: FRONT

draw figFront(cloth) 44x62:
  stamp staff 28:5
  stamp bootFront 13:51
  stamp bootFront 20:51 flipx
  stamp robe(cloth) 2:23
  stamp arm(cloth) 2:26
  stamp arm(cloth) 26:26 flipx
  stamp head(cloth) 2:1
  outline edge

draw mageFront 44x64:
  fill cool.alpha(35%) ellipse(22:61, 12:2)
  stamp figFront(robeA) 0:1
  stamp orb(glowA) 25:4

draw mageFrontEmber 44x64:
  fill cool.alpha(35%) ellipse(22:61, 12:2)
  stamp figFront(robeE) 0:1
  stamp orb(glowE) 25:4

# ---------------------------------------------------------- parts (side, faces right)

# head profile: hat tips back-left, brim leads forward-right, nose points right (+x).
draw headSide(cloth) 26x24:
  cone = poly(11:0, 4:13, 19:13)
  face = poly(9:14, 15:15, 18:18, 15:20, 14:22, 10:23, 8:20, 8:14)
  # hat cone
  fill cloth cone
  fill lit(cloth) cone.intersect(rect(0:0, 10:13))
  fill shd(cloth) cone.intersect(rect(12:0, 25:13))
  fill gold rect(5:11, 17:13)
  fill dpW(gold) rect(5:13, 17:13)
  px litW(gold) 10:7
  # brim (leads forward to the right)
  fill cloth poly(1:13, 23:13, 20:16, 3:16)
  fill deep(cloth) poly(1:16, 23:14, 20:16, 3:16)
  # hair flowing down the back (left)
  fill hair poly(3:14, 8:14, 8:23, 4:23)
  fill shdW(hair) poly(3:15, 4:14, 4:23, 3:23)
  # face profile
  fill skin face
  fill shdW(skin) poly(13:19, 15:20, 14:22, 12:22)
  fill edge rect(13:16, 14:17)
  px warm 13:16
  px shdW(skin) 16:18
  line shdW(skin) 11:22 13:22

# torso profile: front drape (right) convex, back (left), flaring hem. seam row 0, hem row 29.
draw robeSide(cloth) 22x30:
  body = poly(6:0, 15:0, 17:8, 19:29, 3:29, 4:8)
  fill cloth body
  fill lit(cloth) body.intersect(rect(0:0, 8:29))
  fill shd(cloth) body.intersect(rect(13:0, 21:29))
  fill deep(cloth) body.intersect(rect(15:13, 21:29))
  fill skin rect(10:0, 13:1)
  fill gold poly(9:0, 15:0, 13:5)
  # sash
  fill gold rect(4:15, 18:17)
  fill litW(gold) rect(4:15, 18:15)
  fill dpW(gold) rect(4:17, 18:17)
  # folds + hem
  line deep(cloth) 9:18 7:28
  line deep(cloth) 13:18 15:28
  line deep(cloth) 1:29 20:29
  line gold 4:27 17:27

# side sleeve: shoulder down-forward to the gripping hand (lower-right). seam row 0.
draw armSide(cloth) 12x18:
  body = poly(1:0, 5:0, 10:12, 8:16, 2:14)
  fill cloth body
  fill lit(cloth) body.intersect(rect(0:0, 3:16))
  fill shd(cloth) body.intersect(rect(7:0, 11:16))
  # hand at the grip
  fill skin ellipse(8:15, 2:2)
  fill shdW(skin) rect(8:15, 9:16)

# side boot (toe points right, +x). top row 0, sole row 7.
draw bootSide 9x8:
  fill boot rect(2:0, 6:3)
  fill boot poly(1:4, 8:4, 8:7, 1:7)
  fill lit(boot) rect(2:0, 3:6)
  fill shd(boot) rect(6:1, 7:6)
  fill deep(boot) rect(1:7, 8:7)

# ------------------------------------------------------------- full body: SIDE

draw figSide(cloth) 40x62:
  stamp bootSide 19:51 tint cool 0.4
  stamp bootSide 12:51
  stamp robeSide(cloth) 6:23
  stamp staff 20:3
  stamp armSide(cloth) 13:26
  stamp headSide(cloth) 5:1
  outline edge

draw mageSide 40x64:
  fill cool.alpha(35%) ellipse(17:61, 12:2)
  stamp figSide(robeA) 0:1
  stamp orb(glowA) 17:2

draw mageSideEmber 40x64:
  fill cool.alpha(35%) ellipse(17:61, 12:2)
  stamp figSide(robeE) 0:1
  stamp orb(glowE) 17:2

# ============================ EXPORTS ==========================

export mageFront mage/front:
  png @1 @4

export mageFrontEmber mage/front-ember:
  png @1 @4

export mageSide mage/side:
  png @1 @4

export mageSideEmber mage/side-ember:
  png @1 @4
