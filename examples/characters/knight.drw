# Knight — modular Ragnarok-Online-style chibi, front + side, two faction colors.
# ~2.7 heads tall: a big helmeted head dominates a compact torso with massive
# pauldrons over short armored legs; feet stand on a contact-shadow ellipse.
# Light contract: one warm key light top-left -> speculars on upper-left metal
# edges, core shadow lower-right; cool shadow complement, never pure black.
# Silhouette wears a 1px warm-dark outline (o); steel ink (k) is the inner
# separator / visor line.

warm = #ffe9c4
cool = #2a3450
edge      = #2a2024
steelInk  = #232838
steelSpec = #eaf2fa
steelLite = #b6c3d6
steelMid  = #8494ac
steelDark = #55617c
crimson   = #a83836
azure     = #2f5fb0

fn litC(c)  = c.mix(warm, 24%)
fn deepC(c) = c.darken(26%).mix(cool, 12%)

# ---- front parts (components, never exported) -----------------------------

# head: big helm — plume (faction) rows 0-3, dome, visor slit rows 10-11,
# cheek guards, neck. Bottom-center seam at row 23 (silhouette reaches it).
draw head(c) 22x24:
  pal:
    o = edge
    k = steelInk
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
    f = c
    g = litC(c)
    v = deepC(c)
  pixels:
    ..........gf..........
    .........ggfv.........
    .........gffv.........
    .........gffv.........
    ........oxlsdo........
    ......oxxllssddo......
    .....oxxllsssdddo.....
    ....oxxlllssssdddo....
    ...oxxlllsssssddddo...
    ...oxxlllsssssddddo...
    ...oddddddddddddddo...
    ...okkkxkkkkkkxkkko...
    ...oxllsssssssddddo...
    ...oxlssssssssddddo...
    ....oxllssssssdddo....
    ....oxllssssssdddo....
    .....oxllsssssddo.....
    ......oxllsssddo......
    .......oxlssddo.......
    ........olssdo........
    ........odssdo........
    ........odssdo........
    ........odssdo........
    ........okkkko........

# torso: breastplate + massive pauldrons (rows 1-6, full width) + faction
# tabard down the center + faulds (rows 14-19) covering the leg tops.
# top seam row 0, bottom seam row 19.
draw torso(c) 28x20:
  pal:
    o = edge
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
    f = c
    g = litC(c)
    v = deepC(c)
  pixels:
    .....oxxllssssssssddddo.....
    ..oxxxllllsssssssssddddddo..
    oxxxlllllsssssssssssdddddddo
    oxxxlllllsssssssssssdddddddo
    .oxxlllsssddgffvlsssssddddo.
    ..oxllsssdddgffvlssssddddo..
    ....oxlsssddgffvlsssdddo....
    ......oxlsddgffvlsdddo......
    .......oxlsdgffvlsddo.......
    .......oxlsdgffvlsddo.......
    .......oxlsdgffvlsddo.......
    .......oxlsdgffvlsddo.......
    .......oxlsdgffvlsddo.......
    .......oxlsdgffvlsddo.......
    ......oxlssdgffvlsssdo......
    ......oxlssdgffvlsssdo......
    ......oxlssdgffvlsssdo......
    .......oxlsdgffvlsddo.......
    .......oddddgffvddddo.......
    ........odddgffvdddo........

# armR: sword arm (viewer-left, lit). Top seam row 0 (under pauldron), fist row 15.
draw armR 8x16:
  pal:
    o = edge
    k = steelInk
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
  pixels:
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxssdo.
    .oxssdo.
    .okssdo.
    .okkkko.

# armL: shield arm (viewer-right, shadow side). Top seam row 0, fist row 15.
draw armL 8x16:
  pal:
    o = edge
    k = steelInk
    l = steelLite
    s = steelMid
    d = steelDark
  pixels:
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .osssdo.
    .osssdo.
    .okssdo.
    .okkkko.

# legL: left leg (lit). Top seam row 0 (tucked under faulds), sole row 21.
