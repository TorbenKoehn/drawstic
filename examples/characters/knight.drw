    .oxlsdo.
    .oxlsdo.
    .oxssdo.
    .okssdo.
    .okssdo.
    .okkkdo.
    .okkkko.

# legR: right leg (shadow). Top seam row 0, sole row 21.
draw legR 8x22:
  pal:
    o = edge
    k = steelInk
    l = steelLite
    s = steelMid
    d = steelDark
  pixels:
    .olssdo.
