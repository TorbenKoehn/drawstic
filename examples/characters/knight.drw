  pal:
    o = edge
    k = steelInk
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
  pixels:
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
    .oxlsdo.
