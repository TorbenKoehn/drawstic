    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .olssdo.
    .osssdo.
    .okssdo.
    .okssdo.
    .okkddo.
    .okkkko.

# sword: blade points up (spec left edge, dark-right outline), crossguard,
# faction grip + pommel. Reused in the side view via flipy.
draw sword(c) 8x30:
  pal:
    o = edge
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
    f = c
    g = litC(c)
    v = deepC(c)
  pixels:
    ....l...
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    ...xlsd.
    oxlssddo
    oxlssddo
    ...gffv.
    ...gffv.
    ...gffv.
    ...gffv.
    ..gffv..
    ...oo...

# shield: heater shield — faction field, steel rim, spec cross emblem, point.
draw shield(c) 16x15:
  pal:
    o = edge
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
    f = c
    g = litC(c)
    v = deepC(c)
  pixels:
    .oxxlllssssdddo.
    oggffffffffffvvo
    oggffffxxffffvvo
    oggffffxxffffvvo
    oggfxxxxxxxxfvvo
    oggffffxxffffvvo
    oggffffxxffffvvo
    oggffffffffffvvo
    .oggffffffffvvo.
    ..oggffffffvvo..
    ...oggffffvvo...
    ....oggffvvo....
    .....ogffvo.....
    ......ofvo......
    .......oo.......

# ---- side-view parts (profile facing LEFT, toward the light) --------------
# Genuinely redrawn, not flipped: visor juts forward-left, plume trails back,
# chest curves forward, boots point forward. Reuses only the laterally
# symmetric sword (flipped) and the far leg (near leg tinted + offset back).

draw headSide(c) 22x24:
  pal:
    o = edge
    k = steelInk
    x = steelSpec
    l = steelLite
    s = steelMid
    d = steelDark
    f = c
    g = litC(c)
    v = deepC(c)
  pixels:
    ..............gffv....
    .............ggffv....
    ............gffffv....
    ...........gfffv......
    ....oxxxlllssssddo....
    ...oxxxllllsssssddo...
    ..oxxxlllllssssssddo..
    ..oxxlllllssssssdddo..
    ..oxxllllsssssssddo...
    ..oddddddddddddddddo..
