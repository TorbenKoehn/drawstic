# ---- full-body compositions -----------------------------------------------

draw front(c) 44x64:
  ellipse cool.alpha(32%) 22:61 12:2 fill
  stamp legL 14:40
  stamp legR 22:40
  stamp armR 5:27
  stamp armL 31:27
  stamp torso(c) 8:22
  stamp shield(c) 24:31
  stamp sword(c) 3:14
  stamp head(c) 11:2

draw side(c) 44x64:
  ellipse cool.alpha(32%) 21:61 13:2 fill
  stamp shield(c) 26:26 tint #2b2b2b 45%
  stamp legSide 24:40 tint #2b2b2b 45%
  stamp legSide 18:40
  stamp torsoSide(c) 13:22
  stamp armSide 15:27
  stamp sword(c) 12:34 flipy
  stamp headSide(c) 11:2

# ---- faction variants (parametric recolor via the parts) ------------------

draw knightFront 44x64:
  stamp front(crimson) 0:0

draw knightFrontAzure 44x64:
  stamp front(azure) 0:0

draw knightSide 44x64:
  stamp side(crimson) 0:0

draw knightSideAzure 44x64:
  stamp side(azure) 0:0

# ---- exports --------------------------------------------------------------

export knightFront knight/front:
  png @1 @4

export knightFrontAzure knight/frontAzure:
  png @1 @4

export knightSide knight/side:
  png @1 @4

export knightSideAzure knight/sideAzure:
  png @1 @4
