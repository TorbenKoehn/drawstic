# Modular robot character — Ragnarok-Online chibi mecha (big head, hard-surface panels,
# visible joints, faction-coloured emissive lights). Canvas 45x64, figure ~58px (~2.8 heads).
# Parts are non-exported components (fragment-renderable: render robot.drw#head(#2fdcd0)).
# Body composed via stamp; symmetric limbs via mirror; 1px silhouette outline baked per view;
# contact shadow drawn under the outlined body. Faction recolor = the emissive param only.

# --- Light contract -------------------------------------------------------
# ONE light from the top-LEFT, both views (side faces left, so the front stays lit).
# Metal ramp = 5 cel tones; the darkest ramp tone (steelDk) draws the inner panel lines.
steelHi = #e0e8f7        # spec highlight (top-left)
steelLt = #aab8dc        # lit face
steel   = #7382b4        # mid metal
steelLo = #505f8c        # shaded face
steelDk = #333d5a        # darkest ramp tone -> panel / seam lines
edge    = #232a40        # emissive recess (behind visor / core)
joint   = #2c344c        # dark articulation metal (ball joints)
outlineCol = #2a2024     # 1px silhouette outline (very dark, warm)
cool    = #1b2033        # contact-shadow tone (cool, not black)
shade   = #2b2b2b        # exactly-neutral depth tint (R=G=B: darkens, keeps emissive hue)

# --- Faction accent (the recolor variant) — only the emissive swaps -------
accentA = #2fdcd0        # faction A: cyan
accentB = #ff9a34        # faction B: amber

fn ecore(e) = e.mix(#ffffff, 55%)     # bright emissive core

# ===================== PARTS (front) ======================================

draw head(e) 25x21:                    # big helmet + wide visor; symmetric about col 12; neck seam row 20
  rect steelDk 11:0 13:1 fill          # antenna base
  px e 12:0                            # antenna tip (emissive)
  rrect steel 2:1 22:15 4 fill         # helmet shell
  fill steelLt rrect(2:1, 22:15, 4).intersect(rect(0:0, 10:8))     # upper-left lit
  fill steelLo rrect(2:1, 22:15, 4).intersect(rect(15:8, 24:15))   # lower-right shade
  line steelHi 4:1 12:1                # crown highlight
  line steelHi 2:2 2:8                 # lit left edge
  line steelDk 22:2 22:14              # shaded right edge
  line steelDk 2:15 22:15              # helmet underside seam
  rect steelDk 0:8 2:13 fill           # left ear vent
  rect steelDk 22:8 24:13 fill         # right ear vent
  px e 1:10                            # left ear LED (emissive)
  px e 23:10                           # right ear LED (emissive)
  rrect edge 4:7 20:13 2 fill          # visor recess
  rect e 5:8 19:12 fill                # emissive visor band
  line ecore(e) 8:9 16:9               # bright visor core
  rect steel 6:15 18:19 fill           # jaw block
  fill steelLt rect(6:15, 11:19)       # jaw lit
  fill steelLo rect(13:15, 18:19)      # jaw shade
  line steelDk 6:16 18:16              # jaw seam
  line steelDk 6:18 18:18              # mouth grille
  rect steelLo 9:19 15:20 fill         # neck stub
  line steelDk 9:20 15:20              # neck seam (row 20, no buffer)

draw torso(e) 27x22:                   # broad-shoulder torso; symmetric about col 13; hip covers leg tops
  body = poly(4:1, 22:1, 20:19, 6:19)
  fill steel body
  fill steelLt body.intersect(rect(0:0, 10:19))    # left lit
  fill steelLo body.intersect(rect(16:0, 26:19))   # right shade
  line steelHi 5:2 5:15                # lit left flank
  line steelDk 21:2 21:15              # shaded right flank
  line steelDk 6:1 20:1                # collar seam
  circle edge 13:9 4 fill              # chest-core recess
  circle e 13:9 3 fill                 # emissive core
  circle ecore(e) 13:9 1 fill          # hot core
  line steelDk 5:15 21:15              # waist seam
  line steelDk 8:18 18:18              # ab panel line
  rect steel 5:18 21:21 fill           # hip guard (reaches leg tops)
  fill steelLt rect(5:18, 11:21)
  fill steelLo rect(15:18, 21:21)
  line steelDk 5:18 21:18              # hip top seam

draw arm(e) 9x22:                      # pauldron+arm+fist; center-lit (mirror-safe); top seam row 0
  rrect steel 0:0 8:6 2 fill           # pauldron
  fill steelLt rrect(0:0, 8:6, 2).intersect(rect(0:0, 3:6))
  fill steelLo rrect(0:0, 8:6, 2).intersect(rect(6:0, 8:6))
  line steelHi 1:0 4:0                 # pauldron top-lit
  line e 2:3 6:3                       # pauldron LED strip (emissive)
  line steelDk 0:6 8:6                 # pauldron underside seam
  rect steel 2:7 6:11 fill             # upper arm
  fill steelLt rect(2:7, 3:11)
  fill steelLo rect(5:7, 6:11)
  rect edge 2:11 6:12 fill             # elbow joint recess
  rrect steel 1:13 7:18 1 fill         # forearm
  fill steelLt rrect(1:13, 7:18, 1).intersect(rect(0:0, 3:18))
  fill steelLo rrect(1:13, 7:18, 1).intersect(rect(5:0, 7:18))
  line e 3:15 5:15                     # forearm vent (emissive)
  rrect steel 1:18 7:21 1 fill         # fist
  fill steelLo rect(5:18, 7:21)
  line steelDk 1:18 7:18               # wrist seam
  line steelDk 1:20 7:20               # knuckle line

draw leg(e) 9x20:                      # short leg; center-lit; top seam row 0, foot at bottom
  circle joint 4:2 2 fill              # hip ball joint
  px steelHi 3:1
  rrect steel 1:3 7:9 1 fill           # thigh
  fill steelLt rect(1:3, 3:9)
  fill steelLo rect(6:3, 7:9)
  rect edge 1:9 7:10 fill              # knee joint recess
  px e 4:9                             # knee LED (emissive)
  rrect steel 0:10 8:15 1 fill         # shin greave
  fill steelLt rect(0:10, 3:15)
  fill steelLo rect(6:10, 8:15)
  line e 3:12 5:12                     # shin vent (emissive)
  rrect steel 0:15 8:19 1 fill         # foot
  fill steelLo rect(0:17, 8:19)
  line steelHi 1:15 6:15               # foot top-lit
  line steelDk 0:19 8:19               # sole

# ===================== PARTS (side profile, facing LEFT) ==================
# Head + torso are genuinely redrawn (a profile differs fundamentally from the
# front): jaw + visor jut forward (left), a crest fin trails at the back (right).
# arm + leg are REUSED. Face points left = toward the light, so the same
# top-left light contract keeps the face lit and the back shaded.

draw headSide(e) 21x21:                # profile head, faces LEFT; neck seam row 20
  rect steelDk 7:0 9:1 fill            # antenna base
  px e 8:0                             # antenna tip (emissive)
  rrect steel 2:1 17:15 4 fill         # helmet shell
  poly steel 15:2 20:5 19:9 16:11 fill # back crest fin
  fill steelLt rrect(2:1, 17:15, 4).intersect(rect(0:0, 9:8))      # front-top lit
  fill steelLo rrect(2:1, 17:15, 4).intersect(rect(12:8, 20:15))   # back-bottom shade
  line steelHi 4:1 11:1                # crown lit
  line steelHi 2:2 2:8                 # lit front edge
  line steelDk 17:3 17:14              # shaded back edge
  line steelDk 2:15 17:15              # underside seam
  rrect edge 2:7 11:13 2 fill          # visor recess (front)
  rect e 3:8 10:12 fill                # emissive eye
  line ecore(e) 3:9 7:9                # bright core
  rect steel 1:15 10:19 fill           # jaw juts forward (left)
  fill steelLt rect(1:15, 4:19)
  fill steelLo rect(7:15, 10:19)
  line steelDk 1:16 10:16              # jaw seam
  line steelDk 1:18 10:18              # mouth grille
  rect steelLo 7:19 13:20 fill         # neck
  line steelDk 7:20 13:20

draw torsoSide(e) 20x22:               # profile torso, faces LEFT; hip seam row 21
  body = rrect(3:1, 15:19, 3)
  fill steel body
  fill steelLt body.intersect(rect(0:0, 8:19))     # front lit
  fill steelLo body.intersect(rect(11:0, 19:19))   # back shade
  line steelHi 4:2 4:15                # lit front edge
  line steelDk 15:2 15:15              # shaded back edge
  line steelDk 4:1 14:1                # collar seam
  circle edge 6:9 3 fill               # chest-core recess (front)
  circle e 6:9 2 fill                  # emissive core
  px ecore(e) 6:9                      # hot core
  line steelDk 3:15 15:15              # waist seam
  line steelDk 5:18 13:18              # ab panel
  rect steel 3:18 15:21 fill           # hip
  fill steelLt rect(3:18, 8:21)
  fill steelLo rect(11:18, 15:21)
  line steelDk 3:18 15:18

# ===================== FULL BODY (front) ==================================

draw robotFrontBody(e) 45x64:          # figure only (silhouette-outlined), no ground shadow
  mirror x=22:                         # legs: draw one, mirror for the pair
    stamp leg(e) 16:40 anchor top
  stamp torso(e) 22:21 anchor top
  mirror x=22:                         # arms: draw one, mirror for the pair
    stamp arm(e) 12:21 anchor top
  stamp head(e) 22:2 anchor top
  outline outlineCol                   # 1px silhouette outline

draw robotFront(e) 45x64:
  ellipse cool.alpha(35%) 22:61 15:2 fill      # contact shadow at the feet
  stamp robotFrontBody(e) 0:0

# ===================== FULL BODY (side, facing left) ======================

draw robotSideBody(e) 45x64:           # profile figure (silhouette-outlined)
  stamp leg(e) 23:40 anchor top tint shade 38%    # far leg (neutral-grey depth tint)
  stamp torsoSide(e) 20:21 anchor top             # torso, front faces left
  stamp headSide(e) 20:2 anchor top               # head faces left
  stamp arm(e) 21:22 anchor top                   # near arm hangs beside the body
  stamp leg(e) 19:40 anchor top                   # near leg
  outline outlineCol

draw robotSide(e) 45x64:
  ellipse cool.alpha(35%) 21:61 14:2 fill      # contact shadow
  stamp robotSideBody(e) 0:0

# ===================== EXPORT VARIANTS ====================================

draw frontA 45x64:
  stamp robotFront(accentA) 0:0

draw frontB 45x64:
  stamp robotFront(accentB) 0:0

draw sideA 45x64:
  stamp robotSide(accentA) 0:0

draw sideB 45x64:
  stamp robotSide(accentB) 0:0

export frontA robot/front-cyan:
  png @1 @4

export frontB robot/front-amber:
  png @1 @4

export sideA robot/side-cyan:
  png @1 @4

export sideB robot/side-amber:
  png @1 @4
