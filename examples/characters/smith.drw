# Dwarf smith — modular character (Ragnarok-Online style)
# Archetype: squat 2.4-head chibi dwarf, huge ginger beard with light strands,
# leather apron over a tunic, welding goggles + faction headband, a warhammer
# shouldered (fist grips the vertical haft). Front + side view, two factions.
#
# --- light contract (character-craft §6): warm light from upper-left, cool
# shadow lower-right. Warm materials (skin/beard/leather/wood/cloth) shade via
# darken() only — a cool mix would swing the OkLCh arc through magenta. Only the
# already-cool steel takes a cool mix. One contract for every part and view.
warm       = #ffe6b0
cool       = #35406a
outlineCol = #2a2024              # 1px silhouette outline (very dark warm)
groundShadow = cool.alpha(30%)

fn lit(c)  = c.mix(warm, 22%)     # toward light
fn hi(c)   = c.mix(warm, 42%)     # bright top-left highlight
fn shd(c)  = c.darken(15%)        # core shadow (warm-safe)
fn deep(c) = c.darken(30%)        # deepest / internal separator

# --- skin (warm — darken-shaded) ---
skin     = #dca06a
skinLit  = lit(skin)
skinHi   = hi(skin)
skinShd  = shd(skin)
skinDeep = deep(skin)

# --- beard / hair (ginger, 2-3 light strands) ---
beard     = #a85d2c
beardLit  = #cf8544
beardHi   = #ecb26e
beardShd  = beard.darken(16%)
beardDeep = beard.darken(32%)
browCol   = beard.darken(40%)
eyeCol    = #241812

# --- tunic (dull teal under-layer: sleeves + shoulders) ---
tunic    = #35625a
tunicLit = lit(tunic)
tunicShd = shd(tunic)
tunicDeep = deep(tunic)

# --- leather apron (warm tan, dominant front mass) ---
leather     = #9a6330
leatherLit  = lit(leather)
leatherHi   = hi(leather)
leatherShd  = shd(leather)
leatherDeep = deep(leather)

# --- trousers ---
trousers    = #4a3524
trousersLit = lit(trousers)
trousersShd = deep(trousers)

# --- boots ---
boot    = #35271b
bootLit = lit(boot)
bootShd = boot.darken(34%)

# --- steel (cool material: hammer head, buckle, goggles) ---
metal     = #9aa4ac
metalHi   = metal.mix(warm, 32%)
metalLit  = metal.mix(warm, 12%)
metalShd  = metal.darken(14%).mix(cool, 16%)
metalDeep = metal.darken(28%).mix(cool, 24%)

# --- wood haft ---
haft    = #7a4f2c
haftLit = lit(haft)
haftShd = deep(haft)

# --- faction trims (headband + apron straps) ---
trimA = #b5352f                   # Clan Ember (default)
trimB = #2f6ab5                   # Clan Tide (recolor)

# =====================================================================
# PARTS — front view (components: never exported, only stamped)
# =====================================================================

# head+beard: one rigid unit. Bottom-center seam ~row 29 tucks over the torso
# top; the beard fan covers the neck so no seam gap can open (§4b overlap-cut).
draw head(trim) 30x30:
  # --- face skin (wide, short dwarf face) ---
  rrect skin 7:3 22:16 3 fill
  rect skinLit 7:5 9:14 fill
  rect skinShd 20:5 22:14 fill
  # brow ridge shadow
  rect skinShd 8:7 21:7 fill
  # --- welding goggles pushed up on the forehead ---
  rect metalShd 7:2 22:5 fill
  circle metal 11:3 2 fill
  circle metal 18:3 2 fill
  px metalHi 10:2
  px metalHi 17:2
  circle eyeCol 11:3 1 fill
  circle eyeCol 18:3 1 fill
  # --- faction headband under the goggles ---
  rect trim 6:5 23:6 fill
  rect trim.darken(18%) 15:5 23:6 fill
  # knot + tails on the light side
  rect trim 4:6 6:7 fill
  rect trim.darken(18%) 4:8 5:11 fill
  # --- brows (heavy, angled) ---
  rect browCol 8:8 12:8 fill
  px browCol 12:9
  rect browCol 18:8 21:8 fill
  px browCol 18:9
  # --- eyes ---
  rect eyeCol 9:9 10:10 fill
  rect eyeCol 19:9 20:10 fill
  px skinHi 9:9
  px skinHi 19:9
  px skinShd 8:11
  px skinShd 21:11
  # --- beard fan (huge, tapering point) ---
  poly beard 5:11 25:11 28:17 25:24 20:28 15:30 10:28 5:24 2:17 fill
  # mustache over the mouth (splits under the nose)
  poly beard 8:13 22:13 20:17 15:16 10:17 fill
  px beardHi 11:14
  px beardHi 19:14
  # --- bulbous nose (drawn last, sits above the mustache) ---
  rect skin 14:9 16:11 fill
  rect skin 13:11 17:13 fill
  px skinHi 14:9
  px skinLit 13:12
  rect skinShd 16:9 17:12 fill
  px skinDeep 13:13
  px skinDeep 17:13
  # light strands (left / lit side)
  rect beardLit 5:14 6:24 fill
  rect beardLit 9:16 10:26 fill
  px beardHi 5:15
  px beardHi 5:18
  px beardHi 9:17
  # right / shaded side
  rect beardShd 20:14 21:26 fill
  rect beardShd 24:15 25:22 fill
  # crevice separators (internal dark lines)
  line beardDeep 15:17 15:29
  line beardDeep 7:14 7:23
  line beardDeep 22:14 22:24

# torso: massive dwarf trunk. top seam row 0 (neck stub, beard covers it),
# bottom seam row 25 (apron/belt overlaps the leg tops). Shoulders carry the
# arms; faction straps + headband are the two recolor surfaces on the front.
draw torso(trim) 32x26:
  # neck stub (beard covers it; guarantees no head->torso gap)
  rect skin 13:0 18:3 fill
  rect skinShd 16:0 18:3 fill
  # --- broad shoulders (tunic) ---
  poly tunic 4:1 27:1 30:9 1:9 fill
  rect tunicLit 1:3 4:9 fill
  rect tunicShd 27:4 30:9 fill
  # --- leather apron bib (dominant front mass) ---
  poly leather 7:4 24:4 26:25 5:25 fill
  rect leatherLit 7:6 11:24 fill
  rect leatherShd 21:6 25:24 fill
  px leatherHi 8:6
  # apron seams (internal separators) + stitch line + rivets
  line leatherDeep 15:5 15:24
  line leatherDeep 6:15 25:15
  px metalHi 8:16
  px metalHi 23:16
  # --- faction shoulder straps ---
  rect trim 9:1 11:15 fill
  rect trim.darken(20%) 11:2 11:15 fill
  rect trim 20:1 22:15 fill
  rect trim.darken(20%) 22:2 22:15 fill
  # --- belt + steel buckle (waist) ---
  rect boot 5:19 26:22 fill
  rect bootLit 5:19 26:19 fill
  rect metalShd 13:18 18:23 fill
  rect metal 14:19 17:22 fill
  px metalHi 14:19

# arm: one beefy hanging arm, reused both sides (left plain, right = grip). Top
# seam row 0 (shoulder, tucks under the tunic), fist bulb centered on row 18-21.
draw arm(trim) 10x22:
  rrect tunic 1:0 8:10 2 fill
  rect tunicLit 1:2 2:9 fill
  rect tunicShd 7:2 8:9 fill
  # leather bracer at the wrist
  rect leather 1:9 8:11 fill
  rect leatherLit 1:9 2:11 fill
  rect leatherShd 7:9 8:11 fill
  # skin forearm
  rect skin 2:11 7:16 fill
  rect skinLit 2:12 3:15 fill
  rect skinShd 6:12 7:16 fill
  # fist bulb
  circle skin 4:18 3 fill
  rect skinShd 5:17 7:20 fill
  px skinHi 2:17
  line skinDeep 2:19 6:19

# hammer: shouldered warhammer, vertical haft. The grip wrap (rows 24-29) is
# where the fist closes; the composer overlaps the fist onto it pixel-exactly.
draw hammer(trim) 16x40:
  # wooden haft
  rect haft 6:8 9:39 fill
  rect haftLit 6:8 6:39 fill
  rect haftShd 9:8 9:39 fill
  # faction grip wrap
  rect trim 5:24 10:29 fill
  rect trim.darken(20%) 9:24 10:29 fill
  px trim.mix(warm, 30%) 6:24
  # blocky steel head
  rrect metal 1:0 14:9 1 fill
  rect metalLit 2:1 6:7 fill
  rect metalHi 2:1 4:3 fill
  rect metalShd 11:2 14:8 fill
  rect metalDeep 1:8 14:9 fill
  line metalDeep 1:1 1:8
  px #fff 3:1

# leg: short dwarf leg + chunky boot. Top seam row 0 (under apron), sole row 15.
draw leg 11x16:
  rrect trousers 1:0 9:9 2 fill
  rect trousersLit 1:1 3:8 fill
  rect trousersShd 8:1 9:8 fill
  rrect boot 0:8 10:15 2 fill
  rect bootLit 1:9 3:12 fill
  rect bootShd 0:14 10:15 fill
  px skinHi 2:9

# =====================================================================
# COMPOSITION — front. bodyFront composes every part (back-to-front) and
# bakes the 1px silhouette outline; the thin export wrappers add the faction
# colour + the contact-shadow ellipse (drawn first, feet cover it).
# =====================================================================

# shared front layout (48x62, face centered x24, soles y60)
fCenterX = 24
fLegLX   = 12                     # left leg (11 wide)
fLegRX   = 24                     # right leg
fLegY    = 45                     # leg top -> sole row15 at y60
fTorsoX  = 8                      # torso 32w, center16
fTorsoY  = 21
fHeadX   = 9                      # head 30w, face-center15
fHeadY   = 2
fArmLX   = 5                      # left arm hangs
fArmRX   = 33                     # right arm grips the haft
fArmY    = 22
fHaftX   = 33                     # haft vertical, right of the beard
fHaftY   = 3                      # hammer head up beside the head

draw bodyFront(trim) 48x62:
  stamp leg fLegLX:fLegY flipx
  stamp leg fLegRX:fLegY
  stamp torso(trim) fTorsoX:fTorsoY
  stamp arm(trim) fArmLX:fArmY flipx
  stamp head(trim) fHeadX:fHeadY
  stamp hammer(trim) fHaftX:fHaftY
  stamp arm(trim) fArmRX:fArmY
  outline outlineCol

draw frontA 48x64:
  ellipse groundShadow fCenterX:61 13:3 fill
  stamp bodyFront(trimA) 0:1

draw frontB 48x64:
  ellipse groundShadow fCenterX:61 13:3 fill
  stamp bodyFront(trimB) 0:1
