draw volcano 128x96:
  # --- palette -------------------------------------------------
  skyTop   = #070a1c
  skyMid   = #221a3e
  star     = #ffffff
  moon     = #ece7cc
  glowC    = #ff5a24
  rockDark = #100c10
  warmLit  = #e85a20
  lava     = #ff5a1e
  flowDark = #b8380f
  lavaHot  = #ffcf4a
  lavaCore = #fff2b0
  smoke    = #241d2c
  smokeLit = #7a3a26
  ember    = #ff8a30

  # --- sky -----------------------------------------------------
  grad sky = linear(90, skyTop, skyMid)
  bg sky

  # stars in the upper band
  scatter s 70 3 rect(0:0, 127:44):
    px star.alpha(0.25 + rand(9, s.x + s.y) * 0.6) s

  # moon
  circle moon 102:18 6 fill
  circle skyMid.lighten(6%) 99:15 2 fill

  # --- crater glow (behind the mountain) -----------------------
  grad glow = radial(glowC.alpha(75%), transparent)
  ellipse glow 64:44 44:30 fill

  # --- volcano silhouette --------------------------------------
  mask rock = poly(0:96, 4:88, 48:38, 58:44, 70:44, 80:38, 124:88, 128:96)
  fill rockDark rock
  # warm light on the upper slopes, fading to black at the base
  lightRegion rock 64:44 warmLit 0.42
  # hot rim only on the crater lip
  mask craterLip = rock.intersect(rect(52:38, 76:48))
  rim craterLip 0:1 lavaHot 1

  # --- lava ----------------------------------------------------
  ellipse lava 64:44 8:2 fill
  ellipse lavaHot 64:44 5:1 fill
  px lavaCore 64:44

  # lava flows: dark molten channel with a bright core, cooling mid-slope
  curve flowDark 61:45 57:56 54:66 52:77 w3
  curve lava 61:45 57:56 54:66 52:77 w1
  curve flowDark 68:45 72:55 76:65 79:76 w3
  curve lava 68:45 72:55 76:65 79:76 w1

  # --- smoke plume with underlight -----------------------------
  mask smokeR = ellipse(64:28, 11:7).union(ellipse(57:18, 8:6)).union(ellipse(71:13, 7:5)).union(ellipse(64:6, 6:4))
  fill smoke smokeR
  lightRegion smokeR 64:44 smokeLit 0.85

  # rising embers
  scatter e 26 7 poly(64:45, 56:6, 72:6):
    px ember.alpha(0.3 + rand(4, e.x + e.y) * 0.7) e

export volcano scenes-v2/volcano:
  png @1 @2
