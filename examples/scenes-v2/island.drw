# island.drw — tropical island scene, warm afternoon light

# --- scene colors -----------------------------------------------------------
sunC    = #ffe08a
foamC   = #f7f3e4
sandWet = #cfa878
sandDry = #eccf96
ink     = #2a3038

grad skyG  = linear(90, #2f7fc4, #cdeef3)
grad seaG  = linear(90, #14556e, #3dbccc)
grad glowG = radial(#fff6d2.alpha(60%), #fff6d2.alpha(0%))

# --- shoreline as a function ------------------------------------------------
fn shoreY(nx) = 47 + round(noise(5, nx * 3, 0) * 6)
fn wetY(nx)   = shoreY(nx) + 1
fn dryY(nx)   = shoreY(nx) + 4

# --- parts ------------------------------------------------------------------
draw palm 36x34:
  bark   = #8a5a3a
  barkHi = bark.lighten(16%)
  leaf   = #2f8f4e
  leafDk = leaf.darken(18%)
  leafHi = leaf.lighten(15%)
  nut    = #6b4a2a
  # trunk, leaning right toward the sea
  curve bark 9:33 13:26 18:16 24:8 w3
  curve barkHi 8:33 12:26 17:16 23:8
  # fronds around the crown at 24:8 — slim drooping slivers, dark layer first
  curvePoly leafDk 24:8 16:6 7:11 5:15 14:8 fill
  curvePoly leafDk 24:8 31:7 35:13 34:17 29:9 fill
  curvePoly leaf 24:8 14:3 6:5 4:9 13:5 fill
  curvePoly leaf 24:8 30:2 35:5 35:10 29:5 fill
  curvePoly leafHi 24:8 20:1 13:0 10:2 19:3 fill
  curvePoly leafHi 24:8 27:0 32:1 34:4 27:3 fill
  # drooping tips
  curve leafDk 5:15 4:17 4:19
  curve leafDk 34:17 34:19 33:21
  curve leaf 4:9 3:11 3:13
  # coconuts
  circle nut 22:10 1 fill
  circle nut 25:11 1 fill

draw starfish 7x6:
  pal s=#e8734a d=#c25436
  pixels:
    ...s...
    ..sds..
    sssssss
    .sdsds.
    ..s.s..
    .s...s.

# --- the scene --------------------------------------------------------------
draw island 96x64:
  # sky
  rect skyG 0:0 95:36 fill
  circle glowG 78:11 10 fill
  circle sunC 78:11 5 fill
  circle sunC.lighten(20%) 77:10 3 fill
  # clouds
  cloud = #ffffff.alpha(88%)
  curvePoly cloud 10:9 18:6 28:8 24:12 12:12 fill
  curvePoly cloud 44:15 52:12 60:14 56:18 46:17 fill
  # birds
  line ink 56:7 58:9
  line ink 58:9 60:7
  line ink 63:11 65:13
  line ink 65:13 67:11
  # sea
  rect seaG 0:37 95:63 fill
  line #114a60 0:37 95:37
  mask seaM = rect(0:38, 95:46)
  lightRegion seaM 78:11 #d8f4ff 25%
  ripple seaM 1.2 4 #ffffff.alpha(20%)
  scatter wv 12 9 rect(4:40, 86:46):
    line #17607e.alpha(45%) wv ((wv.x) + 4):(wv.y)
  # distant islet on the horizon (clipped flat at the waterline)
  mask islet = curvePoly(56:38, 62:32, 70:31, 78:38).intersect(rect(0:0, 95:37))
  fill #23606b islet
  rim islet 0:1 #ffe9a8.alpha(45%) 1
  # sun sparkles on the water
  scatter sp 26 7 rect(2:39, 93:46):
    px #ffffff.alpha(50%) sp
  # beach: foam edge, wet band, dry sand
  profile foamC 0..w shoreY fill
  profile sandWet 0..w wetY fill
  profile sandDry 0..w dryY fill
  mask beachM = profile(0..w, dryY)
  grain beachM 0.07 11 sandWet
  shadeRegion beachM 78:11 #5a3c22 30%
  # palm with ground shadow (sun top-right -> shadow to lower-left)
  ellipse #00000038 14:58 13:2 fill
  stamp palm 4:24
  # beach props
  stamp starfish 62:57
  scatter pb 9 3 beachM.intersect(rect(30:56, 92:62)):
    px #b98d5f pb

export island island:
  png @1
