# market.drw -- sunny medieval marketplace, flat storybook-diorama style
from std/shapes dot

# ---- palette (semantic bindings, not pal -- this is procedural, not pixel art) ----
skyTop = oklch(0.82, 0.07, 235)
skyHorizon = oklch(0.93, 0.09, 75)
sunCol = #ffe9a8
groundBase = oklch(0.62, 0.03, 75)
groundFront = groundBase.lighten(10%)
wallBase = #caa06a
roofBase = #7a4a3a
poleCol = #6b4a34
inkCol = #2a2018

grad sky = linear(90, skyTop, skyHorizon)
grad groundGrad = linear(90, groundBase.darken(8%), groundFront)
grad sunGlow = radial(sunCol.alpha(55%), transparent)

# ---- small hand-pixeled fruit icon (pal + pixels:) ----
draw fruitIcon 5x5:
  pal r=#c94b3b d=#8a2f22 h=#5a8a3a
  pixels:
    ..h..
    .rrr.
    rrdrr
    rrrrr
    .rrr.

# ---- pavement medallion (path) ----
path medallion 18x18:
  move 9:1
  arc 17:9 around 9:9 cw
  arc 9:17 around 9:9 cw
  arc 1:9 around 9:9 cw
  arc 9:1 around 9:9 cw
  close

# ---- well roof (path with arc-around dome) ----
path domeRoof 20x12:
  move 1:11
  arc 19:11 around 10:11 cw
  close

# ---- functions ----
fn hillY(nx) = 50 + round(noise(2, nx * 3, 0) * 6)
fn sagY(t, y0, dip) = y0 + dip * 4 * t * (1 - t)

# ---- market stall (parametric: awning stripe colors + cloth) ----
draw stall(awning1, awning2, cloth) 46x58:
  woodDark = poleCol.darken(20%)
  rect poleCol 5:24 9:57 fill
  rect poleCol 37:24 41:57 fill
  rect woodDark 3:22 43:24 fill
  awningCols = awning1, awning2
  for i 0..7:
    sx = i * 6 + 2
    poly awningCols.cycle(i) sx:22 (sx+3):6 (sx+6):22 fill
  for i 0..7:
    sx2 = i * 6 + 2
    poly awningCols.cycle(i + 1) sx2:22 (sx2+3):29 (sx2+6):22 fill
  rect cloth 3:42 42:57 fill
  rect cloth.darken(18%) 3:53 42:57 fill
  ambientOcclusion rect(3:42, 42:57) #000000 40%
  fruitRamp = #c94b3b, #e0a83a, #7a9a3a, #8a4a8a
  stamp fruitIcon 10:35 scale2 tint fruitRamp.cycle(0) 0.4
  stamp fruitIcon 18:35 scale2 tint fruitRamp.cycle(1) 0.4
  stamp fruitIcon 14:31 scale2 tint fruitRamp.cycle(2) 0.4
  stamp fruitIcon 27:35 scale2 tint fruitRamp.cycle(3) 0.4
  stamp fruitIcon 31:33 scale2 tint fruitRamp.cycle(0) 0.5
  breadCol = #c8974f
  ellipse breadCol 35:39 5:3 fill
  ellipse breadCol.darken(12%) 35:39 5:3

# ---- villager (parametric: shirt + skin) ----
draw person(shirt, skin) 12x22:
  pantsCol = shirt.darken(35%).desaturate(15%)
  rect pantsCol 3:15 5:21 fill
  rect pantsCol 7:15 9:21 fill
  rrect shirt 2:7 10:16 2 fill
  rect shirt 0:8 2:14 fill
  rect shirt 10:8 12:14 fill
  circle skin 6:4 3 fill

# ---- signboard ----
draw signboard 44x16:
  rect poleCol 2:0 4:15 fill
  rect poleCol 40:0 42:15 fill
  rect #d8c9a3 4:2 40:13 fill
  rect inkCol 4:2 40:13
  text inkCol 7:5 "MARKT" font small

# ---- village well ----
draw well 34x30:
  wellStone = #9a9186
  waterCol = oklch(0.55, 0.09, 235)
  roofCol = #8a5a3a
  fill roofCol domeRoof.shift(7:0).fill()
  rect poleCol 4:10 7:24 fill
  rect poleCol 27:10 30:24 fill
  rect poleCol 3:9 31:11 fill
  rrect wellStone 2:16 31:29 3 fill
  rrect wellStone.darken(18%) 2:16 31:29 3
  mask waterRegion = ellipse(16:18, 12:3)
  fill waterCol waterRegion
  ripple waterRegion 0.4 4 waterCol.lighten(20%)
  rim waterRegion 0:1 #ffffff.alpha(50%) 1
  line inkCol.alpha(60%) 16:11 16:17
  rect poleCol 14:16 18:19 fill
  ambientOcclusion rrect(2:16, 31:29, 3) #000000 35%

# ---- main scene ----
draw market 220x140:
  groundY = 66
  wellCx = 110
  wellBaseY = 102

  bg sky
  fill sunGlow circle(90:14, 20)
  circle sunCol 90:14 10 fill
  cloudCol = #ffffff.alpha(70%)
  curvePoly cloudCol 30:16 40:10 55:12 62:18 50:22 36:22 fill
  curvePoly cloudCol 120:10 132:6 148:9 154:15 140:20 124:18 fill
  scatter s 14 1 rect(0:0, w-1:34):
    px inkCol.alpha(0.35 + rand(9, s.x + s.y) * 0.3) s
    px inkCol.alpha(0.35 + rand(9, s.x + s.y) * 0.3) (s.x + 3):s.y
    px inkCol.alpha(0.35 + rand(9, s.x + s.y) * 0.3) (s.x + 6):(s.y - 2)
  hillCol = oklch(0.75, 0.05, 240).alpha(55%)
  profile hillCol 0..w hillY fill

  bx = 2, 40, 78, 118, 158
  bw = 36, 32, 38, 34, 40
  bh = 30, 24, 34, 22, 32
  wallCols = wallBase.tones(-20%, -8%, 0%, 10%, 20%)
  roofCols = roofBase.tones(-15%, 0%, 15%, -10%, 10%)
  for i 0..5:
    x = bx[i]
    bw2 = bw[i]
    bh2 = bh[i]
    top = groundY - bh2
    wallC = wallCols[i]
    roofC = roofCols[i]
    rect wallC x:top (x + bw2 - 1):(groundY - 1) fill
    match i mod 3:
      0: poly roofC x:top (x + bw2 // 2):(top - 12) (x + bw2 - 1):top fill
      1: rect roofC x:(top - 6) (x + bw2 - 1):top fill
      else: poly roofC x:top (x + bw2 - 1):top (x + bw2 - 1):(top - 10) fill
    wx = x + bw2 // 2 - 3
    litChance = noise(4, i, 0)
    winCol = if litChance > 0.5 then #ffe9a0.alpha(85%) else #2a2436.alpha(70%)
    rect winCol wx:(top + 8) (wx + 6):(top + 14) fill
    rect wallC.darken(25%) wx:(top + 8) (wx + 6):(top + 14)

  rect groundGrad 0:groundY (w - 1):(h - 1) fill
  mask groundMask = rect(0:groundY, w - 1:h - 1)
  speckle groundMask 0.35 7 groundBase.darken(20%)
  grain groundMask 0.15 3 groundBase.lighten(15%)
  shadeRegion groundMask 110:(h - 1) #2a1d12.alpha(90%) 45%
  fill groundBase.darken(22%) medallion.shift(101:119).fill()
  stroke groundBase.lighten(25%) medallion.shift(101:119).fill() w1
  stroke groundBase.lighten(15%) circle(110:128, 3) w1
  mask plazaEdge = groundMask.subtract(circle(wellCx:(wellBaseY - 10), 22))
  scatter peb 30 6 plazaEdge:
    stamp dot peb tint groundBase.darken(30%) 1

  mirror x=110:
    lampX = 14
    postTop = 34
    rect poleCol lampX:postTop (lampX + 2):groundY fill
    rrect #4a3a2a (lampX - 2):(postTop - 6) (lampX + 4):(postTop + 4) 2 fill
    fill sunGlow circle((lampX + 1):(postTop - 2), 10)
    circle #6b4a34 (lampX + 1):(postTop - 6) 2 fill

  buntCol = #4a3a2a
  flagCols = #c94b3b, #f2efe2, #3f6fae, #f2efe2
  curve buntCol 16:round(sagY(0, 34, 10)) 66:round(sagY(0.25, 34, 10)) 110:round(sagY(0.5, 34, 10)) 154:round(sagY(0.75, 34, 10)) 204:round(sagY(1, 34, 10))
  for i 0..7:
    fx = 30 + i * 160 // 6
    t = (fx - 16) / 188
    fy = round(sagY(t, 34, 10))
    poly flagCols.cycle(i) (fx - 4):fy (fx + 4):fy fx:(fy + 9) fill

  stamp person(#5a6a4a, #d8a878) 88:112 anchor bottom shadow 1:2 #00000035
  stamp person(#8a5a6a, #c99a78) 138:110 anchor bottom flipx shadow 1:2 #00000035

  fill #00000030 ellipse(wellCx:(wellBaseY + 2), 15:4)
  stamp well wellCx:wellBaseY anchor bottom

  stamp stall(#c94b3b, #f2efe2, #d8c9a3) 6:139 anchor bottomLeft shadow 3:4 #00000045
  stamp stall(#3f6fae, #f2efe2, #d8c9a3) 168:139 anchor bottomLeft flipx shadow 3:4 #00000045

  stamp signboard 58:98 anchor bottom shadow 1:2 #00000035

  stamp person(#3a7a5a, #e0b088) 60:139 anchor bottom shadow 1:2 #00000040
  stamp person(#a84a6a, #f0c9a0) 100:139 anchor bottom flipx shadow 1:2 #00000040
  stamp person(#c99a3a, #d8a878) 140:139 anchor bottom shadow 1:2 #00000040

  scatter d 40 3 rect(0:groundY, w - 1:h - 1):
    px sunCol.alpha(0.15 + noise(8, d.x * 0.1, d.y * 0.1) * 0.25) d

export market examples/scenes-v2/market:
  png @1
