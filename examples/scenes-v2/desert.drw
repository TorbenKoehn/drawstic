sandDark = #8a5a2e
sandMid = #c68a4a
sandLight = #e8c48a
skyTop = #f2934f
skyMid = #f7b96b
skyHorizon = #fce3a8
sunColor = #fff6d8
camelBody = #8a6a45
camelBodyFar = #b89a72
robeColor = #3f5a6b
birdColor = #5a3a24
shadowColor = #3a241066

grad sky = linear(90, skyTop, skyMid, skyHorizon)

fn duneFarY(nx) = 30 + round(noise(1, nx * 3, 0) * 6)
fn duneMidY(nx) = 42 + round(noise(2, nx * 3.5, 0) * 8)
fn duneNearY(nx) = 56 + round(noise(3, nx * 3, 0) * 10)

draw camel(c) 24x16:
  eye = c.darken(45%)
  curvePoly c 2:11 2:8 5:5 9:2 12:4 15:3 19:1 23:4 21:6 17:7 15:9 14:11 8:12 4:11 fill
  line c 4:11 3:15 w2
  line c 7:11 8:15 w2
  line c 15:9 14:15 w2
  line c 18:8 19:15 w2
  px eye 20:3

draw rider(c) 8x8:
  pal r=c h=c.lighten(20%)
  pixels:
    ..hh....
    .hhhh...
    .rrrr...
    rrrrrr..
    rrrrrr..
    .rrrr...
    .rrrr...
    ........

draw desert 140x80:
  bg sky
  circle sunColor.alpha(20%) 100:22 30 fill
  circle sunColor.alpha(40%) 100:22 20 fill
  circle sunColor.alpha(70%) 100:22 13 fill
  circle sunColor 100:22 8 fill
  curve birdColor 14:14 18:11 22:14 w1
  curve birdColor 30:9 34:6 38:9 w1
  profile sandLight 0..w duneFarY fill
  profile sandMid 0..w duneMidY fill
  mask duneMidRegion = profile(0..w, duneMidY)
  grain duneMidRegion 0.12 5 sandMid.darken(12%)
  profile sandDark 0..w duneNearY fill
  mask duneNearRegion = profile(0..w, duneNearY)
  grain duneNearRegion 0.18 6 sandDark.darken(15%)
  speckle duneNearRegion 0.03 7 sandDark.darken(30%)
  scatter p 15 9 duneNearRegion:
    circle sandDark.darken(25%) p 1 fill
  stamp camel(camelBodyFar) 30:44 anchor bottom transform scale(0.55) shadow 1:1 shadowColor
  stamp camel(camelBodyFar) 44:46 anchor bottom transform flipx().scale(0.5) shadow 1:1 shadowColor
  stamp camel(camelBody) 70:60 anchor bottom shadow 2:1 shadowColor
  stamp rider(robeColor) 65:47 anchor bottom
  stamp camel(camelBody) 95:64 anchor bottom shadow 2:1 shadowColor
  stamp camel(camelBody.darken(10%)) 118:67 anchor bottom shadow 2:1 shadowColor

export desert examples/scenes-v2/desert:
  png @1 @3
