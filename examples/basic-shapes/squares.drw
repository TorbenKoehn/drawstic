# A hand-pixeled square with a border.
draw squareDeclarative:
  palette k=#fff y=#e0b070
  pixels:
    kkkkkkkk
    kyyyyyyk
    kyyyyyyk
    kyyyyyyk
    kyyyyyyk
    kyyyyyyk
    kyyyyyyk
    kkkkkkkk

draw squareImperative 8x8:
  palette k=#fff y=#e0b070
  rect k 0:0 7:7
  rect y 1:1 6:6 fill

draw squares 128x16:
  palette:
    k = #1a1a1a
    a = #c04040
  bg #fff
  for i 1..=8:
    c = (i*16-8):8
    r = i:i
    rect k c-r c+r-1
    rect a c-r+2 c+r-3 fill

export squares squares:
  png

export squareDeclarative square-declarative:
  png

export squareImperative square-imperative:
  png
