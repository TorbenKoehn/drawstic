# Productivity app-icon family - light from the TOP for every icon:
# 1px light rim on the plate top edge, 1px dark rim on the bottom edge,
# every glyph drops a 1px shadow straight down (0:1).

theme productivity:
  size 32x32
  mode pixel
  palette:
    b = #3d7de0
    r = #e0493c
    a = #e5942f
    v = #8a63d2
    t = #2aa39b
    g = #4fae52
    p = #f7fafc
    k = #2b3648
  style """
    App-icon family "Productivity". One accent hue per app: b mail, r calendar,
    a notes, v calculator, t clock, g todo. Shared plate: rounded square, 1px
    margin, corner radius ~1/5 of the tile, vertical accent gradient (top
    mixed 18% toward white, bottom 26% toward #182230), 1px light rim on top,
    1px dark rim on the bottom. Glyph artwork uses paper p and ink k only,
    plus at most one accent detail, stamped with a 1px drop shadow 0:1.
    Light always comes from the top. Optical center at 32px is 15.5:15.5.
    """

use productivity

# --- shared plates (one per canvas size, same proportions) ---------------

draw plate(c):
  face = rrect(1:1, 30:30, 6)
  fill linear(90, c.mix(#ffffff, 18%), c.mix(#182230, 26%)) face
  fill #ffffff.alpha(50%) face.edge(0:1)
  fill #0a1220.alpha(35%) face.edge(0:-1)

draw plate16(c) 16x16:
  face = rrect(1:1, 14:14, 3)
  fill linear(90, c.mix(#ffffff, 18%), c.mix(#182230, 26%)) face
  fill #ffffff.alpha(50%) face.edge(0:1)
  fill #0a1220.alpha(35%) face.edge(0:-1)

draw plate64(c) 64x64:
  face = rrect(2:2, 61:61, 12)
  fill linear(90, c.mix(#ffffff, 18%), c.mix(#182230, 26%)) face
  fill #ffffff.alpha(50%) face.edge(0:1)
  fill #0a1220.alpha(35%) face.edge(0:-1)

# --- glyphs (paper + ink artwork, stamped with a drop shadow) -------------

draw mailGlyph 20x14:
  rrect p 0:0 19:13 1 fill
  line k 1:1 9:8 w2
  line k 18:1 10:8 w2

draw calGlyph 20x18:
  rrect p 0:2 19:17 1 fill
  rect r 0:3 19:6 fill
  rect k 3:0 4:4 fill
  rect k 15:0 16:4 fill
  m = k.mix(p, 40%)
  for col 0..4:
    rect m (2 + col * 5):9 (3 + col * 5):10 fill
    rect m (2 + col * 5):13 (3 + col * 5):14 fill
  rect r 17:13 18:14 fill

draw noteGlyph 16x20:
  poly p 0:0 15:0 15:14 10:19 0:19 fill
  poly p.mix(k, 22%) 10:14 15:14 10:19 fill
  rect k 3:4 12:5 fill
  rect k 3:9 12:10 fill
  rect k 3:14 7:15 fill

draw calcGlyph 16x20:
  rrect p 0:0 15:19 1 fill
  rect k 2:2 13:5 fill
  for row 0..3:
    for col 0..3:
      bc = if col == 2 then v else k
      rect bc (2 + col * 5):(8 + row * 4) (3 + col * 5):(9 + row * 4) fill

draw clockGlyph 20x20:
  face = circle(10:10, 10)
  fill p face
  stroke t.mix(k, 45%) face
  tick = k.mix(p, 45%)
  rect tick 9:1 10:2 fill
  rect tick 9:17 10:18 fill
  rect tick 1:9 2:10 fill
  rect tick 17:9 18:10 fill
  line k 9:9 5:7 w2
  line k 10:9 14:4 w2
  rect k 9:9 10:10 fill

draw todoGlyph 18x20:
  rrect p 0:0 5:5 1 fill
  line g 1:3 2:4
  line g 2:4 4:2
  rect p 0:7 5:12
  rect p 0:14 5:19
  rect p 8:2 17:3 fill
  rect p 8:9 17:10 fill
  rect p 8:16 17:17 fill

# --- the six 32x32 masters ------------------------------------------------

draw mail:
  stamp plate(b) 0:0
  stamp mailGlyph 6:9 shadow 0:1 k.alpha(35%)

draw calendar:
  stamp plate(r) 0:0
  stamp calGlyph 6:7 shadow 0:1 k.alpha(35%)

draw notes:
  stamp plate(a) 0:0
  stamp noteGlyph 8:6 shadow 0:1 k.alpha(35%)

draw calculator:
  stamp plate(v) 0:0
  stamp calcGlyph 8:6 shadow 0:1 k.alpha(35%)

draw clock:
  stamp plate(t) 0:0
  stamp clockGlyph 6:6 shadow 0:1 k.alpha(35%)

draw todo:
  stamp plate(g) 0:0
  stamp todoGlyph 7:6 shadow 0:1 k.alpha(35%)

# --- 16x16 redraws (hand-tuned, not scaled) -------------------------------

draw mailGlyph16 10x7:
  pixels:
    kppppppppk
    pkppppppkp
    ppkkppkkpp
    ppppkkpppp
    pppppppppp
    pppppppppp
    pppppppppp

draw mail16 16x16:
  stamp plate16(b) 0:0
  stamp mailGlyph16 3:4 shadow 0:1 k.alpha(35%)

draw clockGlyph16 12x12:
  face = circle(6:6, 6)
  fill p face
  stroke t.mix(k, 45%) face
  line k 5:5 5:2
  line k 5:5 3:4
  px t.mix(k, 45%) 5:5

draw clock16 16x16:
  stamp plate16(t) 0:0
  stamp clockGlyph16 2:2 shadow 0:1 k.alpha(35%)

# --- 64x64 detail clock ----------------------------------------------------

fn handX(deg, rr) = 31.5 + sin(deg / 180 * pi) * rr
fn handY(deg, rr) = 31.5 - cos(deg / 180 * pi) * rr

draw clock64 64x64:
  stamp plate64(t) 0:0
  face = circle(32:32, 22)
  fill p face
  stroke t.mix(k, 45%) face w2
  fill #0a1220.alpha(25%) face.edge(0:-1, 2)
  for i 0..12:
    d = i * 30
    major = i mod 3 == 0
    rIn = if major then 16 else 18
    tc = if major then k else k.mix(p, 45%)
    line tc (handX(d, rIn)):(handY(d, rIn)) (handX(d, 20)):(handY(d, 20))
  hs = k.alpha(25%)
  line hs (handX(304, 0)):(handY(304, 0) + 1) (handX(304, 11)):(handY(304, 11) + 1) w3
  line hs (handX(48, 0)):(handY(48, 0) + 1) (handX(48, 16)):(handY(48, 16) + 1) w2
  line k (handX(304, 0)):(handY(304, 0)) (handX(304, 11)):(handY(304, 11)) w3
  line k (handX(48, 0)):(handY(48, 0)) (handX(48, 16)):(handY(48, 16)) w2
  line r (handX(210, -4)):(handY(210, -4)) (handX(210, 18)):(handY(210, 18))
  circle k 32:32 2 fill
  circle r 32:32 1 fill

# --- exports ---------------------------------------------------------------

export mail productivity/mail:
  png @1 @2
  svg

export calendar productivity/calendar:
  png @1 @2
  svg

export notes productivity/notes:
  png @1 @2
  svg

export calculator productivity/calculator:
  png @1 @2
  svg

export clock productivity/clock:
  png @1 @2
  svg

export todo productivity/todo:
  png @1 @2
  svg

export mail16 productivity/mail16:
  png @1 @2
  svg

export clock16 productivity/clock16:
  png @1 @2
  svg

export clock64 productivity/clock64:
  png @1 @2
  svg
