tile = #1f3a5f
tileDark = tile.darken(14%)
tileLight = tile.lighten(10%)
ink = #f5ecdb
inkDim = ink.darken(12%)
gold = #e8b13e
goldDark = gold.darken(18%)
green = #4caf6f
shade = #0b1a2c

theme finTheme:
  palette t=tile r=tileDark l=tileLight k=ink d=inkDim g=gold o=goldDark n=green s=shade
  size 32x32
  mode pixel
  style """
    Fintech app-icon family: flat rounded-square tile in deep banking blue, one warm
    cream glyph per icon, gold accent for value/price, green accent for paid/positive.
    ONE light source top-left: tile carries a subtle top-left-to-bottom-right gradient
    (tileLight to tileDark); single-shape glyphs get a top-left rim highlight and a
    1:1 offset contact shadow; composite glyphs get a flat ground-contact ellipse
    shadow instead (no clumped cast shadow). Corner radius scales with size
    (16px -> 3, 32px -> 6, 64px -> 12); glyph strokes are 1px accents on solid filled
    silhouettes, never thin outlines. Optically centered, no orphan pixels.
  """

use finTheme

gradient tileGrad = linear(45, tileLight, tileDark)
gradient roofGrad = linear(45, ink.lighten(8%), ink.darken(10%))

draw tileBg32 32x32:
  mask tileShape = rrect(0:0, 31:31, 6)
  fill tileGrad tileShape

draw tileBg64 64x64:
  mask tileShape = rrect(0:0, 63:63, 12)
  fill tileGrad tileShape

# --- Wallet (32x32 master) ---
draw wallet 32x32:
  stamp tileBg32 0:0
  mask walletBody = rrect(5:10, 26:23, 3)
  shadow walletBody 1:1 shade.alpha(30%)
  fill ink walletBody
  rim walletBody 1:1 tileLight 1
  line inkDim 5:15 26:15
  circle gold 21:15 2 fill
  circle goldDark 21:15 2
  circle gold 24:9 3 fill
  circle goldDark 24:9 3

export wallet finance/wallet:
  png @1 @2
  svg ids classes

# --- Bank (32x32 master) ---
draw bank 32x32:
  stamp tileBg32 0:0
  poly ink 4:11 16:4 28:11 fill
  rect ink 4:11 28:13 fill
  rect ink 6:14 8:23 fill
  rect ink 12:14 14:23 fill
  rect ink 18:14 20:23 fill
  rect ink 24:14 26:23 fill
  rect ink 3:23 29:26 fill
  ellipse shade.alpha(25%) 16:27 12:2 fill
  circle gold 16:12 2 fill
  circle goldDark 16:12 2

export bank finance/bank:
  png @1 @2
  svg ids classes

# --- Warenkorb / Cart (32x32 master) ---
draw cart 32x32:
  stamp tileBg32 0:0
  poly ink 7:12 25:12 22:21 10:21 fill
  line inkDim 12:13 10:20
  line inkDim 20:13 22:20
  line ink 4:8 7:12 w2
  line ink 3:5 4:8 w2
  circle shade 12:24 3 fill
  px gold 12:24
  circle shade 20:24 3 fill
  px gold 20:24
  circle gold 16:16 2 fill
  circle goldDark 16:16 2
  ellipse shade.alpha(25%) 16:27 9:1 fill

export cart finance/cart:
  png @1 @2
  svg ids classes

# --- Preisschild / Price tag (32x32 master) ---
draw tag 32x32:
  stamp tileBg32 0:0
  mask tagShape = poly(6:16, 13:8, 26:8, 26:24, 13:24)
  shadow tagShape 1:1 shade.alpha(30%)
  fill ink tagShape
  rim tagShape 1:1 tileLight 1
  circle tile 12:16 2 fill
  circle tileDark 12:16 2
  rrect gold 16:14 23:19 1 fill

export tag finance/tag:
  png @1 @2
  svg ids classes

# --- Chart (32x32 master) ---
draw chart 32x32:
  stamp tileBg32 0:0
  line inkDim 5:27 27:27
  rect ink 8:20 12:27 fill
  rect ink 14:14 18:27 fill
  rect gold 20:8 24:27 fill
  rect gold.lighten(18%) 20:8 24:9 fill
  line gold 8:19 24:4 w1
  poly gold 27:3 23:4 25:8 fill

export chart finance/chart:
  png @1 @2
  svg ids classes

# --- Rechnung / Invoice (32x32 master) ---
draw invoice 32x32:
  stamp tileBg32 0:0
  mask paperShape = poly(7:5, 25:5, 25:20, 22:23, 19:20, 16:23, 13:20, 10:23, 7:20)
  shadow paperShape 1:1 shade.alpha(30%)
  fill ink paperShape
  rim paperShape 1:1 tileLight 1
  line tile 10:9 22:9
  line tile 10:13 22:13
  line tile 10:17 18:17
  line green 20:17 22:19 w2
  line green 22:19 26:14 w2

export invoice finance/invoice:
  png @1 @2
  svg ids classes

# --- Wallet (16x16 native redraw) ---
draw wallet16 16x16:
  pixels:
    ..tttttttttttt..
    .tttttttttttttt.
    tttttttttttttttt
    tttttttttttttttt
    tttttttttttttttt
    tttkkkkkkkkkkttt
    tttkkkkkkkkkkttt
    tttkddddddddkttt
    tttkkkkkkgkkkttt
    tttkkkkkkkkkkttt
    tttkkkkkkkkkkttt
    tttttttttttttttt
    tttttttttttttttt
    tttttttttttttttt
    .tttttttttttttt.
    ..tttttttttttt..

export wallet16 finance/wallet16:
  png @1 @2
  svg ids classes

# --- Preisschild (16x16 native redraw) ---
draw tag16 16x16:
  pixels:
    ..tttttttttttt..
    .tttttttttttttt.
    tttttttttttttttt
    ttttttttkttttttt
    tttttttkkktttttt
    ttttttkktkkttttt
    tttttkkkkkkktttt
    ttttkkkkkkkkkttt
    tttkkkkgggkkkktt
    ttttkkkkkkkkkttt
    tttttkkkkkkktttt
    ttttttkkkkkttttt
    tttttttkkktttttt
    ttttttttkttttttt
    .tttttttttttttt.
    ..tttttttttttt..

export tag16 finance/tag16:
  png @1 @2
  svg ids classes

# --- Bank (64x64 detail) ---
draw bank64 64x64:
  stamp tileBg64 0:0
  mask roofMask = poly(8:22, 32:8, 56:22)
  fill roofGrad roofMask
  rect ink 6:22 58:27 fill
  rect shade.alpha(25%) 6:27 58:29 fill
  rect ink 12:29 18:50 fill
  rect ink 24:29 30:50 fill
  rect ink 36:29 42:50 fill
  rect ink 48:29 54:50 fill
  line inkDim 14:30 14:49
  line inkDim 16:30 16:49
  line inkDim 26:30 26:49
  line inkDim 28:30 28:49
  line inkDim 38:30 38:49
  line inkDim 40:30 40:49
  line inkDim 50:30 50:49
  line inkDim 52:30 52:49
  rect tileLight.alpha(35%) 12:29 13:50 fill
  rect tileLight.alpha(35%) 24:29 25:50 fill
  rect tileLight.alpha(35%) 36:29 37:50 fill
  rect tileLight.alpha(35%) 48:29 49:50 fill
  rect ink 6:50 58:56 fill
  rect ink 4:56 59:60 fill
  ellipse shade.alpha(30%) 32:61 26:2 fill
  circle gold 48:53 4 fill
  circle goldDark 48:53 4
  circle gold 32:24 3 fill
  circle goldDark 32:24 3

export bank64 finance/bank64:
  png @1 @2
  svg ids classes
