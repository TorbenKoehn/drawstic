from std/shapes star4

ink = #22273a
bodyBlue = #4d63d1
bevelLight = bodyBlue.lighten(20%)
accent = #ffb347

theme gamesTheme:
  palette k=ink b=bodyBlue l=bevelLight a=accent
  mode pixel
  light sun = dir 1:1 #fff2d0 amb #2a3a5e 22%
  style """
  Games/Navigation icon family, silhouette-first flat style.
  Light source: the theme's `sun`, fixed top-left for every icon body — one `model body bodyM`
  on the silhouette, ink stroke last. The `flat` response keeps it a soft bevel, not a sphere,
  and the shade follows the silhouette: a rounded square beads at its corners and a heart
  rounds over its lobes, which a straight distance ramp could not do.
  Corner radius: 4px @32 master, 2px @16 redraw, 8px @64 detail (proportional to size).
  Outline: 2px ink stroke @32, 1px @16, 3px @64, always the final pass on a body.
  b = body fill, a = accent (exactly one pop element per icon: button/pip/pin/star/fill),
  k = outlines/fine linework, l = the derived bevel tint used on small stamped parts.
  No other hues.
  """

use gamesTheme

material bodyM = bodyBlue flat
material accentM = accent flat

draw ctrlBumper 6x4:
  rrect b 0:0 5:3 1 fill
  rrect k 0:0 5:3 1

draw trophyHandle 6x11:
  ellipse k 3:5 2:5

draw ctrlStick 9x9:
  circle b 4:4 4 fill
  circle k 4:4 4
  circle l 3:3 1 fill

path pinOutline:
  move 24:6
  bezier 28:6 28:12 24:15
  bezier 20:12 20:6 24:6
  close

draw controller 32x32:
  mask body = rrect(3:11,28:22,4).union(circle(7:21,6)).union(circle(24:21,6))
  model body bodyM
  stroke k body w2
  stamp ctrlBumper 4:7
  stamp ctrlBumper 22:7 flipx
  rect k 8:15 10:21 fill
  rect k 6:17 12:19 fill
  circle a 22:16 2 fill
  circle a 25:19 2 fill

draw controller64 64x64:
  mask body = rrect(6:22,57:44,8).union(circle(14:44,12)).union(circle(49:44,12))
  model body bodyM
  stroke k body w3
  stamp ctrlBumper 8:14 scale2
  stamp ctrlBumper 44:14 scale2 flipx
  rect k 15:26 19:38 fill
  rect k 11:30 23:34 fill
  stamp ctrlStick 14:47 anchor center
  stamp ctrlStick 49:47 anchor center
  circle a 46:27 4 fill
  circle a 52:33 4 fill
  circle a 40:33 4 fill
  circle a 46:39 4 fill
  shadow circle(46:27,4).union(circle(52:33,4)).union(circle(40:33,4)).union(circle(46:39,4)) 1:1 k.alpha(35%)
  grain body 0.12 5 k

draw dice 32x32:
  mask body = rrect(4:4,27:27,5)
  model body bodyM
  stroke k body w2
  circle a 9:9 2 fill
  circle a 22:9 2 fill
  circle a 16:16 2 fill
  circle a 9:22 2 fill
  circle a 22:22 2 fill

draw dice16 16x16:
  mask body = rrect(1:1,14:14,2)
  model body bodyM
  stroke k body w1
  circle a 4:4 1 fill
  circle a 11:4 1 fill
  circle a 7:7 1 fill
  circle a 4:11 1 fill
  circle a 11:11 1 fill

draw trophy 32x32:
  mask bowl = poly(8:7,23:7,20:18,11:18)
  model bowl bodyM
  stroke k bowl w2
  gradient lipGrad = linear(90, a.lighten(15%), a.darken(12%))
  rrect lipGrad 7:5 24:8 2 fill
  rrect k 7:5 24:8 2
  stamp trophyHandle 3:6
  stamp trophyHandle 23:6 flipx
  rect b 14:18 17:21 fill
  rect k 14:18 17:21
  rrect b 9:22 22:27 2 fill
  rrect k 9:22 22:27 2
  stamp star4(a) 16:12 anchor center

draw map 32x32:
  mask body = rrect(3:5,28:26,4)
  model body bodyM
  stroke k body w2
  mirror x=16:
    for y 8..24:
      if y mod 4 < 2:
        px k 12:y
  line a 7:22 24:9
  fill a pinOutline.fill()
  fill k pinOutline.stroke(1)

draw puzzle 32x32:
  mask body = rrect(6:8,25:25,4).union(circle(16:7,3)).subtract(circle(16:25,3))
  model body bodyM
  stroke k body w2
  circle a 16:16 2 fill

draw heart 32x32:
  mask body = circle(11:12,6).union(circle(21:12,6)).union(poly(5:14,27:14,16:27))
  model body accentM
  stroke k body w2

draw heart16 16x16:
  palette p=a.lighten(12%) q=a.darken(15%)
  pixels:
    ................
    ................
    ................
    ................
    ...kaak..kaak...
    ...kppaaaaaak...
    ...kaaaaaaaak...
    ...kaaaaaaaak...
    ....kaaaaqqk....
    .....kaaqqk.....
    ......kaak......
    .......kk.......
    ................
    ................
    ................
    ................

export controller, controller64, dice, dice16, trophy, map, puzzle, heart, heart16:
  dir games
  png @1 @2
  svg ids classes
