theme armorParts:
  pal:
    i = #222833
    m = #a9b5c5
    h = #eef4fb
    s = #7d8998
    d = #5c6674
    l = #8b5e36
    g = #d6a067
    c = #536f9b
    q = #33476b
    n = #1f2530
  size 64x64
  mode pixel
  style """
  Armor-parts inventory icons. Transparent background, one light source from top-left.
  All items share the same 64x64 grid, dark outline, crisp @1 silhouette, and the same
  material language: steel = cool metal with hard glints, leather = warm straps and cuffs,
  cloth = deep blue folds. No tile plate, no scene shadow, no extra hues.
  """

use armorParts

lightPt = -6:-6

fn hi(c) = c.lighten(18%)
fn sh(c) = c.darken(18%)
fn deep(c) = c.darken(34%)

draw gauntlet(t) 12x15:
  pal:
    i = n
    m = m
    h = h
    s = s
    d = d
    l = t
    g = hi(t)
  mask body = poly(3:5, 8:4, 11:7, 11:12, 9:14, 4:14, 2:11, 2:7).union(rrect(2:9, 10:14, 2))
  fill l body
  shadeRegion body lightPt d 0.26
  lightRegion body lightPt g 0.16
  stroke i body w1
  rect s 4:5 8:7 fill
  rect h 4:5 8:5 fill
  poly d 8:6 11:8 8:11 fill
  rect d 3:10 9:13 fill
  rect m 5:9 7:12 fill
  px h 5:10
  px h 6:10
  px h 7:10

draw boot(t) 12x16:
  pal:
    i = n
    m = m
    h = h
    s = s
    d = d
    l = t
    g = hi(t)
  mask body = poly(3:2, 9:2, 11:5, 11:12, 9:14, 4:14, 2:11, 2:6).union(rrect(2:9, 10:15, 2))
  fill l body
  shadeRegion body lightPt d 0.25
  lightRegion body lightPt g 0.15
  stroke i body w1
  rect s 4:3 9:4 fill
  rect h 4:3 7:4 fill
  poly d 8:6 11:8 8:12 fill
  rect d 3:12 10:14 fill
  rect m 4:11 8:13 fill
  px h 4:5
  px h 5:5

draw helmetBase 32x32:
  mask shell = curvePoly(10:6, 14:4, 18:4, 22:6, 25:11, 24:19, 20:24, 12:25, 8:20, 7:12).union(rrect(10:15, 21:25, 3))
  fill m shell
  shadeRegion shell lightPt deep(m) 0.24
  lightRegion shell lightPt h 0.16
  stroke i shell w1
  rect s 10:7 18:9 fill
  rect h 10:7 13:8 fill
  rect d 19:7 23:11 fill
  rect n 11:12 21:14 fill
  rect n 15:14 16:20 fill
  poly q 8:14 11:23 10:25 7:22 fill
  poly q 24:14 21:23 22:25 25:22 fill
  rect l 11:24 21:26 fill
  rect d 9:25 22:27 fill
  circle h 13:10 1 fill
  circle h 20:10 1 fill
  px h 12:9
  px h 19:9

draw breastplateBase 32x32:
  mask body = poly(8:6, 13:4, 19:4, 24:6, 27:12, 25:22, 20:27, 12:27, 7:22, 5:12).union(circle(7:8, 3)).union(circle(25:8, 3)).union(rrect(11:23, 20:28, 3))
  fill m body
  shadeRegion body lightPt deep(m) 0.22
  lightRegion body lightPt h 0.16
  stroke i body w1
  rect h 13:6 15:23 fill
  rect s 15:6 17:23 fill
  poly d 9:16 23:16 20:25 12:25 fill
  rect l 10:8 12:20 fill
  rect d 20:8 22:20 fill
  rect l 11:23 21:25 fill
  rect d 10:26 22:28 fill
  circle h 12:8 1 fill
  circle h 20:8 1 fill
  rect l 11:27 20:28 fill

draw beltBase 32x32:
  mask body = curvePoly(8:12, 12:9, 20:9, 24:12, 24:18, 20:21, 12:21, 8:18).subtract(curvePoly(11:13, 13:11, 19:11, 21:13, 21:17, 19:19, 13:19, 11:17)).union(poly(20:13, 28:16, 24:23, 18:20))
  fill l body
  shadeRegion body lightPt deep(l) 0.22
  lightRegion body lightPt hi(l) 0.16
  stroke i body w1
  rect g 10:13 20:17 fill
  rect l 10:13 12:17 fill
  rect d 18:13 20:17 fill
  rect m 12:14 18:16 fill
  rect n 13:15 17:15 fill
  rect d 13:18 18:20 fill
  poly q 20:14 28:16 24:23 18:20 fill
  rect h 11:12 12:13 fill

draw cloakBase 32x32:
  mask body = curvePoly(9:6, 14:4, 18:4, 23:6, 27:12, 25:26, 16:30, 6:26, 4:12)
  fill c body
  shadeRegion body lightPt q 0.26
  lightRegion body lightPt hi(c) 0.16
  stroke i body w1
  rect q 10:8 14:24 fill
  rect d 17:8 22:25 fill
  poly q 7:12 15:17 10:27 6:26 fill
  poly d 24:12 17:17 22:27 26:26 fill
  rect n 13:5 18:7 fill
  circle m 15:6 1 fill
  circle m 18:6 1 fill
  rect h 14:5 17:6 fill
  line h 12:9 20:9 w1
  line d 12:10 15:24 w1
  line q 20:10 17:24 w1

draw glovesBase 32x32:
  stamp gauntlet(l) 5:9
  stamp gauntlet(l) 16:9 flipx

draw bootsBase 32x32:
  stamp boot(l) 4:9
  stamp boot(l) 17:9 flipx

draw helmet 64x64:
  stamp helmetBase 0:0 scale2

draw breastplate 64x64:
  stamp breastplateBase 0:0 scale2

draw gloves 64x64:
  stamp glovesBase 0:0 scale2

draw boots 64x64:
  stamp bootsBase 0:0 scale2

draw belt 64x64:
  stamp beltBase 0:0 scale2

draw cloak 64x64:
  stamp cloakBase 0:0 scale2

tileset armorPartsSheet 64x64:
  tiles helmet, breastplate, gloves, boots, belt, cloak

export helmet armor-parts/helmet:
  png @1 @4

export breastplate armor-parts/breastplate:
  png @1 @4

export gloves armor-parts/gloves:
  png @1 @4

export boots armor-parts/boots:
  png @1 @4

export belt armor-parts/belt:
  png @1 @4

export cloak armor-parts/cloak:
  png @1 @4

export armorPartsSheet armor-parts/armor-parts:
  png @1 @4
  tiled
  atlasJson
