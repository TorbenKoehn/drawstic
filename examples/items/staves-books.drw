# Staves & Books - game-item set with one shared 64x64 inventory-sprite contract.
# Light top-left for every item. Long forms lean bottom-left -> top-right.

warm = #ffe8bf
cool = #28324b

fn lit(c)  = c.mix(warm, 20%)
fn shd(c)  = c.darken(12%).mix(cool, 18%)
fn deep(c) = c.darken(24%).mix(cool, 30%)

fn litW(c)  = c.mix(warm, 18%)
fn shdW(c)  = c.darken(18%)
fn deepW(c) = c.darken(30%)

wood     = #8b5a31
woodDark = #5c3419
leather  = #6b4026
iron     = #95a1b4
ironDark = #586273
gold     = #c89b32
goldDark = #88621e
paper    = #e6d29f
paperDark = #c5ae73
ink      = #5f3f30
cover    = #433f88
coverDark = #2e2a61
ruby     = #d65968
arcane   = #7d76ff
arcaneHi = #d8d2ff
crystal  = #79cfff
crystalHi = #e8fbff
teal     = #42cab8
tealHi   = #c3fff4
edge     = #241a20

theme relics:
  size 64x64
  mode pixel
  pal:
    w = #8b5a31
    g = #c89b32
    p = #e6d29f
    a = #7d76ff
    t = #42cab8
    k = #241a20
  style """
    Item set "Staves & Books". Shared contract: transparent 64x64 inventory
    sprites with 2-3px breathing room, one light direction top-left, dark side
    bottom-right. Long props lean from lower-left toward upper-right around 55
    degrees. Wood uses a lit edge, a dark trailing edge, and 2-4 knot/wrap
    marks instead of full-scene texture filters. Metals use a warm spec on the
    lit cap and a cooler dark strip on the far edge. Paper stays warm ivory with
    darker rolled/page edges and sparse ink dashes. Magic glow is a tight
    alpha-only halo behind the focal gem or rune, never larger than about a
    third of the tile.
    """

use relics

draw combatStaffBase 32x32:
  line wood 9:25 22:7 w3
  line litW(wood) 8:24 21:6
  line deepW(woodDark) 10:26 23:8
  line leather 13:20 17:16 w3
  line gold 12:21 18:15
  line iron 16:15 19:12 w3
  line lit(iron) 15:14 18:11
  line ironDark 17:16 20:13
  circle iron 9:25 2 fill
  px lit(iron) 8:24
  px ironDark 10:26
  poly iron 20:8 23:4 26:7 24:11 fill
  poly ironDark 24:6 26:7 24:11 23:8 fill
  line gold 20:9 24:5
  px lit(iron) 22:6
  px gold 21:10
  px woodDark 14:19
  px woodDark 17:15
  px litW(wood) 11:22
  px litW(wood) 19:11
  line edge 9:26 22:8
  line edge 21:8 24:5

draw crystalStaffBase 32x32:
  circle arcane.alpha(8%) 24:7 7 fill
  circle arcane.alpha(14%) 24:7 5 fill
  circle arcane.alpha(20%) 24:7 3 fill
  line wood 9:25 22:8 w3
  line litW(wood) 8:24 21:7
  line deepW(woodDark) 10:26 23:9
  line gold 13:20 17:16 w3
  px woodDark 15:18
  px litW(wood) 11:22
  line iron 20:10 24:5
  line iron 23:11 24:5
  line iron 24:5 27:8
  line lit(iron) 20:9 24:4
  poly crystal 22:8 24:5 27:8 25:12 fill
  poly crystalHi 23:8 24:6 25:8 24:10 fill
  line arcaneHi 24:7 26:9
  px crystalHi 24:7
  px arcaneHi 25:10
  circle iron 9:25 2 fill
  px lit(iron) 8:24
  line edge 9:26 22:9
  line edge 22:9 24:6

draw scepterBase 32x32:
  circle ruby.alpha(8%) 22:9 6 fill
  circle ruby.alpha(14%) 22:9 4 fill
  line gold 10:24 20:12 w3
  line litW(gold) 9:23 19:11
  line goldDark 11:25 21:13
  line leather 14:20 17:17 w3
  circle gold 10:24 2 fill
  px litW(gold) 9:23
  poly gold 18:12 22:6 26:9 23:14 19:15 fill
  poly goldDark 22:9 26:9 23:14 21:13 fill
  line gold 19:13 22:8 w2
  line gold 22:8 25:10 w2
  circle ruby 22:10 3 fill
  circle arcaneHi.alpha(45%) 21:9 1 fill
  px litW(gold) 20:8
  px litW(gold) 24:9
  px goldDark 23:13
  line edge 10:25 20:13
  line edge 19:13 23:8

draw spellbookBase 32x32:
  circle arcane.alpha(7%) 18:15 7 fill
  circle arcane.alpha(12%) 18:15 5 fill
  poly paper 8:24 21:21 25:11 12:14 fill
  poly paperDark 8:24 12:14 13:16 10:26 fill
  poly paperDark 21:21 25:11 26:13 22:23 fill
  line paperDark 10:24 22:12
  line paperDark 9:22 21:10
  poly cover 10:22 23:19 27:9 14:12 fill
  poly lit(cover) 10:22 16:20 20:12 14:12 fill
  poly coverDark 21:19 27:9 24:17 18:21 fill
  rect gold 11:20 12:21 fill
  rect gold 24:10 25:11 fill
  line gold 12:20 24:10
  rect gold 18:14 20:16 fill
  rect goldDark 20:14 20:16 fill
  line gold 19:13 21:11
  line ink 12:17 17:12
  line ink 15:19 20:14
  px arcaneHi 18:16
  px arcaneHi 17:15
  px arcaneHi 19:15
  line edge 11:23 24:11
  line edge 14:13 27:10

draw scrollBase 32x32:
  line paper 10:24 22:12 w5
  line litW(paper) 9:23 21:11 w2
  line paperDark 11:25 23:13 w2
  circle paper 10:24 3 fill
  circle paper 22:12 3 fill
  circle paperDark 10:24 2 fill
  circle paperDark 22:12 2 fill
  circle paper 10:24 1 fill
  circle paper 22:12 1 fill
  line ruby 14:20 18:16 w4
  line deep(ruby) 15:21 19:17 w2
  line ink 12:21 16:17
  line ink 15:23 19:19
  px litW(paper) 8:23
  px litW(paper) 20:11
  line edge 10:25 22:13

draw amuletBase 32x32:
  circle teal.alpha(8%) 16:19 7 fill
  circle teal.alpha(14%) 16:19 5 fill
  circle teal.alpha(20%) 16:19 3 fill
  curve gold 10:8 12:11 14:13 16:14 18:13 20:11 22:8 w2
  curve litW(gold) 10:7 12:10 14:12 16:13 18:12 20:10 22:7
  line gold 14:14 15:16
  line gold 18:14 17:16
  poly gold 16:13 22:19 16:26 10:19 fill
  poly goldDark 16:20 22:19 16:26 14:23 fill
  poly teal 16:15 20:19 16:24 12:19 fill
  poly tealHi 16:16 18:19 16:22 14:19 fill
  px arcaneHi 15:17
  px litW(gold) 14:18
  px goldDark 18:22
  line edge 16:14 21:19

draw combatStaff 64x64:
  stamp combatStaffBase 0:0 scale2

draw crystalStaff 64x64:
  stamp crystalStaffBase 0:0 scale2

draw scepter 64x64:
  stamp scepterBase 0:0 scale2

draw spellbook 64x64:
  stamp spellbookBase 0:0 scale2

draw scroll 64x64:
  stamp scrollBase 0:0 scale2

draw amulet 64x64:
  stamp amuletBase 0:0 scale2

tileset set 64x64:
  tiles combatStaff, crystalStaff, scepter, spellbook, scroll, amulet
  cols 3

export combatStaff staves-books/combat-staff:
  png @1 @4

export crystalStaff staves-books/crystal-staff:
  png @1 @4

export scepter staves-books/scepter:
  png @1 @4

export spellbook staves-books/spellbook:
  png @1 @4

export scroll staves-books/scroll:
  png @1 @4

export amulet staves-books/amulet:
  png @1 @4

export set staves-books/set:
  png
  tiled
  atlasJson
