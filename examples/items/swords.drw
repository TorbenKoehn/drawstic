theme swordSet:
  pal:
    i = #17202b
    o = #2f3848
    d = #485469
    m = #8f9db0
    s = #c7d4e2
    H = #ffffff
    g = #c8953a
    G = #f0c35d
    l = #6b4329
    L = #3a2417
    r = #853232
    c = #5adfff
    b = #1b789f
  size 64x64
  mode pixel
  style """64x64 transparent game-item swords. All blades run southwest-to-northeast at one set angle; ink outline is 1-2 px, metal has dark spine, mid fill, top-left white glints, handles use leather/gold, magic uses cyan accents only."""

use swordSet

draw daggerBase 32x32:
  title "Dagger"
  poly i 11:22 21:9 24:12 14:24 fill
  poly d 12:21 21:11 23:12 14:23 fill
  poly s 13:20 21:11 22:12 14:21 fill
  line H 15:19 21:12
  line i 8:19 15:26 w3
  line g 8:19 15:26
  line i 6:27 10:23 w4
  line l 7:26 11:22 w2
  px G 8:25
  circle i 5:28 2 fill
  circle g 5:28 1 fill

draw shortswordBase 32x32:
  title "Shortsword"
  poly i 11:22 24:7 27:10 14:24 fill
  poly d 12:21 24:9 26:10 14:23 fill
  poly m 13:20 24:9 25:10 14:22 fill
  line s 14:19 24:9
  px H 19:14
  line i 8:18 16:26 w3
  line g 8:18 16:26
  line i 6:28 11:23 w4
  line l 7:27 12:22 w2
  line L 8:28 13:23
  circle i 5:29 2 fill
  circle g 5:29 1 fill

draw longswordBase 32x32:
  title "Longsword"
  poly i 10:23 25:5 28:8 13:26 fill
  poly d 11:22 25:7 27:8 13:25 fill
  poly m 12:21 25:7 26:8 13:24 fill
  line s 13:20 25:7
  line H 17:16 21:12
  line i 7:17 17:27 w3
  line g 7:17 17:27
  px G 9:19
  px G 15:25
  line i 5:29 12:22 w4
  line l 6:28 13:21 w2
  line L 7:29 14:22
  circle i 4:30 2 fill
  circle g 4:30 1 fill

draw scimitarBase 32x32:
  title "Scimitar"
  curve i 12:22 17:14 25:7 w6
  curve d 13:21 18:14 25:8 w4
  curve m 14:20 19:14 25:8 w3
  curve s 15:19 20:13 25:8
  poly i 23:5 28:6 25:10 fill
  poly s 24:6 27:7 25:8 fill
  line i 8:19 16:27 w3
  line G 8:19 16:27
  line i 6:28 12:22 w4
  line r 7:27 13:21 w2
  line L 8:28 14:22
  circle i 5:29 2 fill
  circle G 5:29 1 fill

draw twoHanderBase 32x32:
  title "Two-hander"
  poly i 9:24 25:4 29:8 13:28 fill
  poly o 10:23 25:6 28:8 13:27 fill
  poly m 11:22 25:6 27:8 13:26 fill
  line s 12:21 25:6 w2
  px H 18:15
  px H 20:13
  line i 5:17 18:30 w4
  line g 5:17 18:30 w2
  px G 7:19
  px G 16:28
  line i 3:31 12:22 w5
  line l 4:30 13:21 w3
  line L 5:31 14:22
  circle i 2:31 2 fill
  circle g 2:31 1 fill

draw magicBladeBase 32x32:
  title "Magic blade"
  line c.alpha(20%) 12:22 26:6 w7
  poly i 10:23 25:5 28:8 13:26 fill
  poly b 11:22 25:7 27:8 13:25 fill
  poly c 12:21 25:7 26:8 13:24 fill
  line H 13:20 25:7
  px c 18:15
  px H 20:13
  px c.alpha(70%) 23:9
  line i 7:18 17:28 w3
  line g 7:18 17:28
  circle c 12:23 1 fill
  line i 5:30 13:22 w4
  line l 6:29 14:21 w2
  line c 7:28 13:22
  circle i 4:31 2 fill
  circle c 4:31 1 fill
  px c.alpha(60%) 27:5
  px c.alpha(50%) 9:21

draw dagger 64x64:
  stamp daggerBase 0:0 scale2

draw shortsword 64x64:
  stamp shortswordBase 0:0 scale2

draw longsword 64x64:
  stamp longswordBase 0:0 scale2

draw scimitar 64x64:
  stamp scimitarBase 0:0 scale2

draw twoHander 64x64:
  stamp twoHanderBase 0:0 scale2

draw magicBlade 64x64:
  stamp magicBladeBase 0:0 scale2

tileset swordsTiles 64x64:
  tiles dagger, shortsword, longsword, scimitar, twoHander, magicBlade
  cols 6

atlas swordsAtlas:
  sprites dagger, shortsword, longsword, scimitar, twoHander, magicBlade
  pad 1

export dagger examples/items/swords/dagger:
  png @1 @4

export shortsword examples/items/swords/shortsword:
  png @1 @4

export longsword examples/items/swords/longsword:
  png @1 @4

export scimitar examples/items/swords/scimitar:
  png @1 @4

export twoHander examples/items/swords/twoHander:
  png @1 @4

export magicBlade examples/items/swords/magicBlade:
  png @1 @4

export swordsTiles examples/items/swords/swordsTiles:
  png @1 @4
  tiled

export swordsAtlas examples/items/swords/swordsAtlas:
  png @1 @4
  atlasJson
