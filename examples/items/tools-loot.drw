theme toolsLootTheme:
  pal:
    k = #1d1713
    n = #6f4e31
    b = #9a6a42
    l = #d7a15f
    s = #66717d
    m = #95a3ad
    S = #e6edf4
    g = #b98a24
    G = #f3d45a
    c = #49a7c4
    C = #d8fbff
    r = #c96f7c
    R = #ffdbe1
    p = #fff6dc
  size 64x64
  mode pixel
  style """
  64x64 transparent game-item set for tools and loot.
  Shared contract: light top-left, dark bottom-right, 2-4 px breathing margin, thick dark outline, no background plate.
  Wood uses a dark shaft, mid body, and light grain; metal uses a dark spine, mid fill, and bright glints; leather stays compact and folded; gems are faceted and translucent; gold is warm, heavy, and edged with bright highlights.
  """

use toolsLootTheme

draw pickaxeBase 32x32:
  title "Pickaxe"
  line k 12:27 21:8 w6
  line n 12:27 21:8 w4
  line l 13:26 21:8 w2
  poly k 11:9 16:6 21:7 25:9 22:12 16:13 12:11 fill
  poly s 12:9 16:7 20:8 23:9 21:11 16:12 13:10 fill
  poly S 13:9 16:8 19:9 21:10 19:11 16:11 14:10 fill
  line S 9:8 14:10 w2
  line S 18:8 26:10 w2
  px p 20:8
  px p 18:10
  px S 23:7

draw axeBase 32x32:
  title "Axe"
  line k 11:27 20:8 w6
  line n 11:27 20:8 w4
  line l 12:26 20:8 w2
  poly k 13:8 19:6 26:8 27:11 24:15 18:15 14:12 fill
  poly g 14:8 19:7 24:9 25:11 22:14 18:14 15:11 fill
  poly S 15:8 19:8 23:9 23:11 21:13 17:12 15:10 fill
  line S 17:8 25:10
  px p 21:8
  px p 18:10
  px G 24:9

draw keyBase 32x32:
  title "Key"
  poly k 12:6 14:4 18:4 20:6 20:10 18:12 14:12 12:10 fill
  poly s 13:6 14:5 18:5 19:6 19:9 18:10 14:10 13:9 fill
  poly m 14:7 15:6 17:6 18:7 18:9 17:10 15:10 14:9 fill
  line k 16:12 16:23 w5
  line s 16:12 16:23 w3
  line m 16:13 16:22 w1
  poly k 16:20 21:20 21:22 19:22 19:24 16:24 16:21 fill
  poly s 17:20 20:20 20:21 18:21 18:23 17:23 17:21 fill
  px S 16:6
  px S 17:7
  px p 16:13

draw coinPouchBase 32x32:
  title "Coin pouch"
  curvePoly k 11:13 13:9 18:9 21:13 21:20 18:24 14:24 10:20 fill
  curvePoly n 12:13 14:10 18:10 20:13 20:19 18:22 15:22 11:19 fill
  curvePoly b 13:14 15:11 18:11 19:14 19:18 17:21 15:21 12:18 fill
  line p 13:11 19:11 w2
  line k 14:9 18:9 w2
  poly k 14:8 16:7 18:8 17:11 15:11 fill
  poly p 15:8 16:8 17:8 16:10 fill
  circle G 18:15 1 fill
  px G 14:16
  px l 17:17
  line n 12:22 19:22 w2

draw gemBase 32x32:
  title "Gem"
  poly k 16:4 23:11 20:24 12:24 9:11 fill
  poly c.alpha(78%) 16:5 22:11 19:23 13:23 10:11 fill
  poly C.alpha(38%) 16:6 21:11 19:19 14:19 11:11 fill
  poly s.alpha(62%) 16:4 20:10 18:16 14:16 12:10 fill
  poly c.alpha(55%) 16:4 17:10 14:16 12:10 fill
  line C 16:5 16:24
  line C 10:11 22:11
  line p 12:10 16:4
  line p 16:4 20:10
  px p 15:8
  px p 18:9
  px C 17:13

draw crownBase 32x32:
  title "Crown"
  poly k 8:20 10:13 13:18 16:8 19:18 22:13 24:20 23:25 9:25 fill
  poly g 9:20 11:14 13:19 16:10 19:19 21:14 23:20 22:24 10:24 fill
  poly G 10:19 12:15 13:18 16:11 19:18 20:15 22:19 21:23 11:23 fill
  line S 12:15 16:11
  line S 16:11 20:15
  line p 11:20 21:20
  circle r 13:16 1 fill
  circle c 19:16 1 fill
  circle G 16:12 1 fill
  px p 16:9
  px p 14:18
  px p 18:18

draw pickaxe 64x64:
  stamp pickaxeBase 0:0 scale2

draw axe 64x64:
  stamp axeBase 0:0 scale2

draw key 64x64:
  stamp keyBase 0:0 scale2

draw coinPouch 64x64:
  stamp coinPouchBase 0:0 scale2

draw gem 64x64:
  stamp gemBase 0:0 scale2

draw crown 64x64:
  stamp crownBase 0:0 scale2

tileset toolsLootTiles 64x64:
  tiles pickaxe, axe, key, coinPouch, gem, crown
  cols 3

atlas toolsLootAtlas:
  sprites pickaxe, axe, key, coinPouch, gem, crown
  pad 1

export pickaxe examples/items/tools-loot/pickaxe:
  png @1 @4

export axe examples/items/tools-loot/axe:
  png @1 @4

export key examples/items/tools-loot/key:
  png @1 @4

export coinPouch examples/items/tools-loot/coinPouch:
  png @1 @4

export gem examples/items/tools-loot/gem:
  png @1 @4

export crown examples/items/tools-loot/crown:
  png @1 @4

export toolsLootTiles examples/items/tools-loot/toolsLootTiles:
  png @1 @4
  tiled

export toolsLootAtlas examples/items/tools-loot/toolsLootAtlas:
  png @1 @4
  atlasJson
