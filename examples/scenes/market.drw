drawstic 1

from std/shapes tri, leaf, blob
use std/themes pixelBase

fn cobbleTone(i, a, b, c) = if i mod 3 == 0 then a else if i mod 3 == 1 then b else c

path buntingRope 160x14:
  move 5:1
  bezier 45:13 115:13 155:1

draw villagerA 7x11:
  pal n=#4a2f1d s=#e8b98c c=#b23b3b d=#3c2626 k=#241a12
  pixels:
    ..nnn..
    .nsssn.
    ..sks..
    ..sss..
    .ccccc.
    ccccccc
    .ccccc.
    ..ddd..
    ..d.d..
    ..d.d..
    .k...k.

draw villagerB 7x11:
  pal n=#221a15 s=#c98f5c c=#2f5f86 d=#1c3d54 k=#241a12
  pixels:
    ..nnn..
    .nsssn.
    ..sks..
    ..sss..
    .ccccc.
    ccccccc
    .ccccc.
    ..ddd..
    ..d.d..
    ..d.d..
    .k...k.

draw villagerC 7x11:
  pal n=#d8b464 s=#e8b98c c=#d9a441 d=#5c4419 k=#241a12
  pixels:
    ..nnn..
    .nsssn.
    ..sks..
    ..sss..
    .ccccc.
    ccccccc
    .ccccc.
    ..ddd..
    ..d.d..
    ..d.d..
    .k...k.

draw house(wall, timber, roofA, roofB, door) 34x46:
  poly roofB 1:18 17:2 33:18 fill
  poly roofA 2:18 17:3 32:18 fill
  rect timber 3:18 30:45 fill
  rect wall 4:19 29:45 fill
  shadeRegion rect(4:19, 29:45) 0:0 wall 0.4
  line timber 4:31 29:31
  line timber 4:19 16:31
  line timber 29:19 17:31
  line timber 4:45 16:31
  line timber 29:45 17:31
  line timber 16:31 16:45
  line timber 17:31 17:45
  rect timber 7:22 13:29 fill
  mask rect(7:23, 12:28):
    bg #cfe6f0
  rect timber 21:22 27:29 fill
  mask rect(21:23, 26:28).subtract(rect(23:23, 24:28)).subtract(rect(21:25, 26:26)):
    bg #cfe6f0
  mask rect(13:35, 20:45).union(circle(16:35, 4)):
    bg door
  circle timber 19:40 1 fill
  rim rect(3:18, 30:45) 1:1 #fff2cf99 1
  ambientOcclusion rect(3:18, 30:45) #17110c 0.5

draw stall(cloth, clothAlt, wood, woodDark, goodsA, goodsB) 30x28:
  rect woodDark 3:20 6:27 fill
  rect woodDark 23:20 26:27 fill
  rect wood 1:16 28:20 fill
  rect woodDark 1:19 28:20 fill
  rect woodDark 3:4 5:16 fill
  rect woodDark 24:4 26:16 fill
  rect wood 1:2 28:4 fill
  for i 0..9:
    stripeCol = if i mod 2 == 0 then cloth else clothAlt
    rect stripeCol (1 + i * 3):4 (3 + i * 3):15 fill
  for i 0..9:
    valCol = if i mod 2 == 0 then clothAlt else cloth
    stamp tri(valCol) (1 + i * 3):14
  fruitCols = goodsA.mixes(goodsB, 4)
  for i 0..4:
    circle fruitCols[i] (4 + i * 5):18 2 fill
  stamp blob(woodDark) 20:16
  rim rect(1:2, 28:20) 1:1 #fff2cf80 1
  ambientOcclusion rect(1:16, 28:27) #14100a 0.4

draw well(stoneA, stoneB, roofWood, roofClay, water) 30x36:
  ellipse stoneB 15:32 13:3 fill
  ellipse stoneA 15:30 12:3 fill
  rect stoneB 4:17 26:31 fill
  rect stoneA 5:17 25:30 fill
  shadeRegion rect(4:17, 26:31) 0:0 stoneA 0.3
  for i 0..7:
    line stoneB (4 + i * 3):17 (4 + i * 3):31
  ellipse stoneB 15:16 11:3 fill
  grad wellWater = radial(water.lighten(12%), water.darken(22%))
  mask ellipse(15:16, 9:2):
    bg wellWater
    ripple 0.3 4 water.alpha(55%)
  rect roofWood 6:2 8:17 fill
  rect roofWood 22:2 24:17 fill
  poly roofClay 2:7 28:7 15:0 fill
  poly roofClay.darken(14%) 3:7 27:7 15:1 fill
  bezier stoneB 8:8 12:1 18:1 22:8
  rect stoneB 14:10 16:16 fill
  rim rect(4:16, 26:31) 1:1 #fff2cf90 1
  ambientOcclusion rect(4:16, 26:31) #10161a 0.45

draw market 160x96:
  skyHigh = oklch(0.83, 0.05, 250)
  skyMid = oklch(0.87, 0.06, 70)
  skyDawn = oklch(0.9, 0.09, 48)
  sunGold = #ffd76a
  sunHot = #fff4c2
  sunGlow = #ffce6e66
  stoneBase = #98897a
  stoneDark = #675c50
  stoneLite = stoneBase.lighten(18%)
  plaster = #ede2c9
  timberDark = #3c2a1e
  timberMid = timberDark.lighten(16%)
  roofClayA = #a1503a
  roofClayB = roofClayA.darken(16%)
  doorWood = #5b3a24
  clothRed = #b23b3b
  clothCream = #f2e6c8
  clothBlue = #2f5f86
  clothMustard = #d9a441
  leafGreen = #4f8f3f
  leafDark = leafGreen.darken(20%)
  waterBlue = #3d7fa0
  shadowInk = #16202c

  grad sky = linear(90, skyHigh, skyMid, skyDawn)
  bg sky

  circle sunGlow 22:20 20 fill
  circle sunGold 22:20 12 fill
  circle sunHot 20:17 5 fill

  mask rect(0:40, 159:52):
    dither skyDawn skyMid 0.5

  rect stoneBase 0:52 159:95 fill
  stoneA, stoneB, stoneC = stoneBase.tones(-8%, 0%, 10%)
  for i 0..46:
    tone = cobbleTone(i, stoneA, stoneB, stoneC)
    cx = floor(rand(3, i) * 154)
    cy = 54 + floor(rand(5, i) * 38)
    rect tone cx:cy (cx + 5):(cy + 2) fill
  for x 0..160:
    if noise(13, x, 64) > 0.62:
      px stoneLite.alpha(45%) x:64
    if noise(21, x, 80) > 0.65:
      px stoneDark.alpha(35%) x:80
  mask rect(0:52, 159:95):
    grain 0.1 7 #00000030
    speckle 0.05 9 #ffffff30
  ambientOcclusion rect(0:52, 159:95) #000000 0.15

  castShadow ellipse(13:54, 16:4) 8:3 shadowInk.alpha(35%)
  castShadow ellipse(75:54, 16:4) 8:3 shadowInk.alpha(35%)
  castShadow ellipse(135:54, 16:4) 8:3 shadowInk.alpha(35%)
  castShadow ellipse(27:88, 15:4) 10:3 shadowInk.alpha(30%)
  castShadow ellipse(133:88, 15:4) 10:3 shadowInk.alpha(30%)
  castShadow ellipse(85:82, 14:4) 9:3 shadowInk.alpha(35%)

  houseXs = -4, 58, 118
  for i 0..3:
    x = houseXs[i]
    match i:
      0: stamp house(plaster, timberDark, roofClayA, roofClayB, doorWood) x:52 anchor bottomLeft
      1: stamp house(plaster.lighten(6%), timberMid, roofClayB, roofClayA, doorWood.darken(10%)) x:52 anchor bottomRight flipx
      else: stamp house(plaster.darken(4%), timberDark, roofClayA.lighten(6%), roofClayB, doorWood) x:52 anchor bottomLeft

  stamp stall(clothRed, clothCream, doorWood.lighten(20%), timberDark, #c0432f, #e8a33a) 12:88 anchor bottomLeft
  stamp stall(clothBlue, clothCream, doorWood.lighten(20%), timberDark, #6a8f3f, #d9c14a) 118:88 anchor bottomLeft tint sunGold 0.12

  stamp well(stoneBase, stoneDark, timberDark, roofClayB, waterBlue) 85:82 anchor bottom

  stamp leaf(leafGreen) 60:83
  stamp leaf(leafDark) 63:85 flipy
  stamp leaf(leafGreen) 101:81 rot45

  stroke doorWood buntingRope w1
  buntingCols = clothRed.mixes(clothMustard, 5)
  buntingSpots = 15:4, 45:9, 80:11, 115:9, 145:4
  for i 0..5:
    stamp tri(buntingCols[i]) buntingSpots[i] flipy

  stamp villagerA 20:83
  stamp villagerB 50:87 flipx
  stamp villagerC 100:80 mask rect(0:0, 159:88)
  stamp villagerB 140:84
  stamp villagerA 76:70 scale2 shadow 2:1 shadowInk.alpha(40%)

export market scenes/market:
  png @1 @2
  svg ids classes
