drawstic 1

from std/shapes spark, leaf

skyTop = #68bff0
skyMid = #9fe0ff
skyLow = #ffe3a9
sunGold = oklch(0.87, 0.15, 88)
sunHot = #fff09a
seaBase = #1f9ec4
seaLite, seaMid, seaDeep = seaBase.tones(20%, 0%, -24%)
seaAbyss = seaDeep.darken(8%)
foam = #e9fbff
foamSoft = #92dceb
sandDark, sand, sandLite = #d9a95f.tones(-16%, 0%, 14%)
grassDark, grass, grassLite = #4e9c45.tones(-24%, 0%, 22%)
trunkDark = #6a3b22
trunk = #9a5b31
trunkLite = #c4864c
rock = #765c55
rockLite = #9b8176
shade = #17394b60

draw cloud 18x8:
  pal a=#ffffff b=#d9f2ff c=#a8d5ee
  pixels:
    .....aaaa.........
    ...aaaaaaaa.......
    ..aaaabbaaaa......
    .aaaabbbbaaaa.....
    aaaabbbbbbaaaa....
    .aaabbbbbbaaa.....
    ..cccccccccc......
    ....cccccc........

draw wisp 12x5:
  pal a=#fff8dc b=#e8f7ff c=#b8d8ea
  pixels:
    ...aaaa.....
    .aaaaaaaa...
    aaaabbbaaa..
    .bbbbbbbbb..
    ..ccccccc...

draw bird 7x4:
  pal k=#25304a
  pixels:
    ...k...
    ..k.k..
    .k...k.
    k.....k

draw boat 28x15:
  pal k=#192238 v=#fff6d5 r=#b44a34 o=#70351e b=#365f8c
  pixels:
    .............k..............
    .............kk.............
    ............kvk.............
    ...........kvvk.............
    ..........kvvvk.............
    .........kvvvvk.............
    ........kvvvvvk.............
    ........kkkkkkkkk...........
    .......kkkkkkkkkkkkk........
    .....koooooooooooook........
    ....koorrrrrrrrrrook........
    ...kooorrrrrrrrrroook.......
    ....kkkoooooooookkk.........
    ......bbbbbbbbbbbb..........
    .......bbbbbbbbbb...........

draw shell 5x4:
  pal k=#9a6a3b p=#ffe0a4 q=#ffbd7a
  pixels:
    ..k..
    .pqp.
    pqqqp
    .kkk.

draw starfish 7x7:
  pal s=#e8894e t=#f3b079
  pixels:
    ...s...
    s..t..s
    .sttts.
    ..tst..
    .sttts.
    s..t..s
    ...s...

draw crab 7x5:
  pal r=#c94f36 d=#8f2f1e
  pixels:
    r.....r
    .r...r.
    .drrrd.
    drrrrrd
    .d.d.d.

draw deepBand 160x8:
  bg seaDeep
  dither seaAbyss seaDeep 0.5

draw sea 160x47:
  grad water = linear(90, (seaLite, 0%), (seaMid, 45%), (seaAbyss, 100%))
  bg water
  rect #ddf8ff 0:0 159:1 fill
  rect #5ecae2 0:2 159:4 fill
  for x 0..160:
    if noise(5, x, 0) > 0.55:
      rect foamSoft x:9 (x + 4):9 fill
    if noise(5, x, 9) > 0.57:
      rect foam x:23 (x + 5):23 fill
    if noise(5, x, 17) > 0.6:
      rect #c7f4f9 x:35 (x + 7):35 fill
    if noise(7, x, 4) > 0.62:
      rect #1c88ad x:15 (x + 3):15 fill
  stamp deepBand 0:39
  mask shine = poly(108:0, 140:0, 152:46, 96:46)
  mask shine:
    for i 0..14:
      sx = 100 + floor(rand(21, i) * 44)
      rect #fff3c060 sx:(2 + i * 3) (sx + 3):(2 + i * 3) fill
  ripple 0.2 23 #0b4b7230

draw sandbar 108x32:
  ellipse sandDark 52:18 49:13 fill
  ellipse sand 52:16 47:12 fill
  ellipse sandLite 35:12 23:7 fill
  ellipse #f4cf86 67:14 28:8 fill
  poly grassDark 18:8 32:2 51:2 72:4 90:9 85:13 42:12 16:10 fill
  poly grass 22:7 35:3 54:4 77:6 88:9 74:11 36:10 fill
  poly grassLite 34:6 50:4 66:6 52:8 fill
  ellipse rock 17:17 7:3 fill
  ellipse rockLite 18:16 4:2 fill
  ellipse rock 86:19 8:3 fill
  ellipse rockLite 84:18 3:2 fill
  grain 0.1 11 sandDark
  speckle 0.06 17 sandLite

draw palm 56x54:
  poly trunkDark 23:53 31:53 26:18 22:19 fill
  poly trunk 25:52 30:52 26:19 23:20 fill
  poly trunkLite 27:50 29:51 25:21 24:21 fill
  rect trunkDark 23:44 29:45 fill
  rect trunkDark 23:37 28:38 fill
  rect trunkDark 22:29 27:30 fill
  poly grassDark 24:21 1:19 9:14 26:16 fill
  poly grass 25:21 4:21 12:16 27:17 fill
  poly grassLite 24:19 9:19 16:17 fill
  poly grassDark 26:18 6:7 18:6 29:15 fill
  poly grass 26:19 11:8 20:8 29:16 fill
  poly grassDark 27:17 26:0 33:7 31:19 fill
  poly grass 27:18 28:3 33:8 31:19 fill
  poly grassDark 29:17 46:4 45:14 31:21 fill
  poly grass 29:18 43:8 43:15 31:21 fill
  poly grassDark 30:20 55:17 48:23 31:23 fill
  poly grass 30:21 50:19 45:22 31:23 fill
  poly grassDark 26:21 14:33 21:24 28:21 fill
  poly grass 26:21 18:30 23:24 29:21 fill
  circle trunkDark 27:20 3 fill
  circle #5b311d 24:21 2 fill
  circle #5b311d 30:22 2 fill
  circle #7b4326 27:24 2 fill

draw island 160x96:
  grad sky = linear(90, (skyTop, 0%), (skyMid, 55%), (skyLow, 100%))
  grad glow = radial(sunHot.alpha(35%), transparent)
  bg sky
  circle glow 124:16 17 fill
  circle sunGold 124:16 12 fill
  circle sunHot 120:12 5 fill
  stamp cloud 12:12
  stamp wisp 48:18
  stamp cloud 102:8 flipx tint skyLow 0.25
  stamp wisp 132:29 flipx
  stamp bird 34:16
  stamp bird 52:11 scale2
  stamp bird 140:18
  stamp sea 0:49
  ellipse shade 78:78 50:12 fill
  stamp sandbar 26:56
  islandR = sandbar.region.shift(26:56)
  shadeRegion islandR 124:16 #17394b30 0.9
  rim islandR 1:-1 #fff7d080 1
  ambientOcclusion islandR #17394b 0.35
  ellipse shade 80:65 10:2 fill
  stamp palm 74:64 anchor bottom
  stamp leaf(grassDark) 34:66
  stamp leaf(grass) 37:67 flipx
  stamp leaf(grassDark) 104:67 flipx
  stamp shell 52:76 shadow 1:1 #b9854880
  stamp shell 96:76 flipx shadow 1:1 #b9854880
  stamp starfish 70:78 shadow 1:1 #b9854880
  stamp crab 88:78 shadow 1:1 #b9854880
  stamp boat 134:70 anchor bottom shadow 0:2 #0b4b7280
  rect foam 122:71 150:71 fill
  rect foamSoft 126:73 147:73 fill
  for i 0..8:
    gx = 10 + floor(rand(41, i) * 138)
    stamp spark(#ffffffa0) gx:(50 + floor(rand(43, i) * 7))

export island scenes/island:
  png @1 @2 @4 z9
  svg ids classes
