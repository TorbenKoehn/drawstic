drawstic 1

# Underwater coral reef — full-surface scene.
# Components (parametric by colour) are stamped by the `reef` drawing below.

from std/shapes leaf, blob, tri, star4, dot

use std/themes pixelBase

# deterministic seeded scatter: noise in [0,1) mapped to an integer 0..amp
fn scatter(seed, i, amp) = round(noise(seed, i, 0) * amp)

# ---------------------------------------------------------------- fish

draw clownfish 11x7:
  pal k=#12161b o=#ff8f33 s=#fff3e2 e=#0a0c0f
  pixels:
    ....kkkk...
    ..kkooookk.
    .koeooosok.
    koooossookk
    .kooossook.
    ..kkooookk.
    ....kkkk...

draw minnow(c) 6x4:
  ellipse c 2:2 2:1 fill
  poly c.darken(18%) 4:2 5:1 5:3 fill
  px c.darken(45%) 1:1

# ---------------------------------------------------------------- corals

draw staghorn(c) 22x28:
  cd = c.darken(16%)
  cl = c.lighten(18%)
  line cd 11:27 11:8 w3
  line cd 11:20 4:9 w3
  line cd 11:16 18:6 w3
  line cd 11:12 8:3 w3
  line c 11:27 11:9 w1
  circle cl 11:8 2 fill
  circle cl 4:9 2 fill
  circle cl 18:6 2 fill
  circle cl 8:3 2 fill

draw brainCoral(c) 24x16:
  cf = c.darken(32%)
  cl = c.lighten(18%)
  mask dome = ellipse(12:15, 11:9)
  fill c dome
  # meandering brain furrows — stacked shallow valleys
  for i 0..7:
    yy = 2 + i * 2
    arc cf 12:yy (5 + (i mod 2) * 3) 200 340
  ripple 0.32 21 cf
  shadeRegion dome 12:0 c 0.3
  rim dome 0:-1 cl 1

draw fanCoral(c) 22x22:
  cd = c.darken(14%)
  cl = c.lighten(18%)
  # lacy radiating ribs
  for i 0..8:
    line c 11:21 (3 + i * 2):2 w1
  # cross-arcs weave the ribs into a fan
  arc cd 11:22 19 250 290
  arc cd 11:22 15 246 294
  arc cd 11:22 11 242 298
  quad cl 4:6 11:2 18:6
  for i 0..8:
    px cl (3 + i * 2):2
  mask fanR = poly(11:21, 3:2, 19:2)
  rim fanR 0:-1 cl 1

draw tubeCoral(c) 16x20:
  cl = c.lighten(24%)
  cd = c.darken(16%)
  for i 0..5:
    x = 1 + i * 3
    hgt = 8 + (i mod 2) * 6
    rrect c x:(19 - hgt) (x + 1):19 1 fill
  dither c cd 0.5
  for i 0..5:
    x = 1 + i * 3
    hgt = 8 + (i mod 2) * 6
    px cl x:(19 - hgt)
    px #00000070 x:(20 - hgt)

draw anemone(c) 20x16:
  grad core = radial(c.lighten(26%), c.darken(8%))
  mask body = ellipse(10:13, 6:3)
  fill core body
  tips = c.mixes(#ffffff, 4)
  for i 0..14:
    ang = i / 14
    tx = round(10 + cos(ang * pi + 0.2) * 8)
    ty = round(13 - (0.4 + rand(4, i) * 0.9) * 9)
    line c.lighten(10%) 10:13 tx:ty w1
    px tips[i mod 4] tx:ty
  rim body 0:-1 c.lighten(30%) 1
  ambientOcclusion body #06121e 0.4

path kelpStrand 14x40:
  move 6:39
  bezier 2:28 10:20 6:10
  bezier 2:4 9:2 7:0

draw kelp(c) 14x40:
  stroke c kelpStrand w2
  for i 0..4:
    stamp leaf(c.lighten(14%)) (4 + (i mod 2) * 4):(34 - i * 8)

# ---------------------------------------------------------------- seabed

draw seabed 160x26:
  sandDark, sand, sandLite = #d9a860.tones(-18%, 0%, 14%)
  poly sandDark 0:25 0:9 26:6 60:9 96:5 128:8 159:6 159:25 fill
  poly sand 0:25 0:12 30:9 64:12 100:8 132:11 159:10 159:25 fill
  poly sandLite 0:25 0:16 40:13 90:12 140:14 159:15 159:25 fill
  grain 0.14 11 sandDark
  speckle 0.05 17 #5a4326
  speckle 0.03 23 sandLite

# ---------------------------------------------------------------- scene

draw reef 160x96:
  deep = #06263f
  mid = #12608a
  shallow = #2f9ec4
  coralPink = #ff6f91
  coralViolet = oklch(0.62, 0.13, 320)
  coralRed = #ff7a5e
  coralAmber = #ff9a3c
  coralTeal = #34c9b0
  anemPurple = #b063d6
  anemRose = #ff7fae
  rock = #46535f
  rockLite = #6d7986
  haze = #0a3f63
  beamCol = #d3efff

  grad water = linear(90, shallow, mid, deep)
  bg water

  # sunlight caustics on the open water
  ripple 0.22 23 #bfe6ff33

  # surface shimmer
  for x 0..160:
    if noise(6, x, 0) > 0.62:
      px #eaffffa0 x:0
      px #cdf4ff80 x:1

  # god rays — diagonal beams that fade with depth
  mask beams = poly(18:0, 38:0, 16:95, -6:95).union(poly(70:0, 92:0, 60:95, 40:95)).union(poly(122:0, 142:0, 134:95, 110:95))
  mask beams:
    grad beam = linear(90, beamCol.alpha(24%), beamCol.alpha(0%))
    bg beam

  # background reef — hazy, blue-tinted, small
  for i 0..7:
    bx = 6 + i * 22
    yb = 72 - scatter(8, i, 4)
    stamp blob(coralTeal) bx:yb scale2 tint haze 0.5
    stamp tri(coralPink) (bx + 10):(yb + 5) tint haze 0.45
  stamp tri(coralAmber) 150:66 rot45 tint haze 0.4
  stamp blob(coralViolet) 30:70 flipy tint haze 0.55

  # sandy floor
  stamp seabed 0:70

  # rocks — angular boulders with cast shadows
  mask rockA = poly(18:88, 20:80, 27:77, 36:80, 38:88)
  castShadow rockA 4:3 #04121e80
  fill rock rockA
  poly rockLite 21:80 27:77 31:80 24:82 fill
  ambientOcclusion rockA #05141f 0.5
  mask rockB = poly(98:88, 101:79, 108:76, 117:79, 120:88)
  castShadow rockB 5:3 #04121e80
  fill rock rockB
  poly rockLite 101:80 108:76 112:80 104:82 fill
  ambientOcclusion rockB #05141f 0.5

  # foreground reef — a row of varied corals along the sand
  cxs = 12, 42, 68, 94, 124, 150
  for i 0..6:
    cx = cxs[i]
    base = cx:(85 + (i mod 2) * 2)
    match i mod 3:
      0: stamp staghorn(coralPink) base anchor bottom shadow 2:1 #05121e66
      1: stamp fanCoral(coralViolet) base anchor bottom flipx shadow 2:1 #05121e55
      else: stamp brainCoral(coralRed) base anchor bottom shadow 2:1 #05121e55

  stamp tubeCoral(coralTeal) 80:88 anchor bottom shadow 2:1 #05121e55
  stamp fanCoral(coralTeal) 138:89 anchor bottom transform rotate(-12).about(11:21)

  # anemones perched on the rocks
  stamp anemone(anemPurple) 28:82 anchor bottom
  stamp anemone(anemRose) 108:82 anchor bottom scale2

  # swaying kelp at the margins
  stamp kelp(#3f9d52) 2:56
  stamp kelp(#57b968) 156:54 flipx

  # fish school — colour-cycled, noise-scattered, mirrored
  schoolCols = #4bbfe0, #ffd24a, #ff7fae, #9ce8ff
  for i 0..20:
    fx = 8 + i * 8
    fy = 22 + scatter(7, i, 22)
    c = schoolCols[i mod 4]
    if i mod 2 == 0:
      stamp minnow(c) fx:fy
    else:
      stamp minnow(c) (fx mod 152):fy flipx

  # hero clownfish
  stamp clownfish 96:40 shadow 1:1 #05121e55
  stamp clownfish 52:60 flipx tint coralAmber 0.15

  # starfish and pebbles on the sand
  stamp star4(coralAmber) 66:84
  stamp dot 46:88
  stamp dot 138:90

  # rising air bubbles
  for i 0..24:
    bx = round(rand(3, i) * 158)
    yb = 6 + round(rand(5, i) * 80)
    br = 1 + round(rand(9, i) * 1.4)
    circle #d9f7ff99 bx:yb br
    px #ffffffcc (bx - 1):(yb - 1)

export reef scenes/reef:
  png @1 @2
  svg ids classes
