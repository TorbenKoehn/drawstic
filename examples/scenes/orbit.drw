drawstic 1

from std/shapes star4, spark
use std/themes pixelBase

# ── stamped parts ────────────────────────────────────────────────

draw shuttle 16x8:
  pal k=#1b2236 s=#e6ecf6 g=#96a3b8 b=#54b0ec r=#e87b3c f=#ffd15a
  pixels:
    .....kkkkk......
    ...kkssssskkk...
    .kkgssssssssbrk.
    kffssbbsssssssrk
    kffssbbsssssssrk
    .kkgsssssssssbrk
    ...kkssssskkk...
    .....kkkkk......

draw satellite 9x9:
  pal k=#1b2236 m=#8f9db2 c=#d5deec y=#e8b24a
  pixels:
    ..y...y..
    ..y.k.y..
    .kkmmmkk.
    kccccccck
    kccmmmcck
    kccccccck
    .kkmmmkk.
    ..k...k..
    ..k...k..

path comet:
  move 6:6
  quad 16:11 30:26

fn ring(c, r) = circle(c, r).subtract(circle(c, r - 2))

# ── main scene ───────────────────────────────────────────────────

draw orbit 160x96:
  title "Raumstation im Orbit"

  # palette
  spaceTop = #04060f
  spaceBot = #0b1226
  nebA = #2a2a66
  nebB = #1c5066
  starW = #ffffff
  starB = #cfe4ff
  starWarm = #ffe6c0
  starDim = #8fa6cf
  ocean = #1d5f96
  oceanDeep = #0e3d64
  land = #3c7a3e
  landDark = #2b5730
  landLite = #6fae52
  desert = #b39355
  ice = #e8f3ff
  cloud = #ffffff
  rimLite = #d6f4ff
  atmoGlow = #8fd8ff
  termShade = #06122880
  earthGlow = #6fc0e6
  panelBlue = #21406e
  panelDark = #132a4c
  panelLite = #3f78bf
  panelFrame = #9aa7bd
  accent = oklch(0.79, 0.14, 72)
  hullDark, hull, hullLite = #808ea6.tones(-32%, 0%, 24%)

  # derived color ramps + lists
  starCols = starDim.mixes(starW, 4)
  pc = 44:84
  pr = 40

  # definitions
  grad space = linear(90, spaceTop, spaceBot)
  grad atmo = radial(atmoGlow.alpha(70%), atmoGlow.alpha(0%))
  grad earth = radial(earthGlow.alpha(42%), earthGlow.alpha(0%))
  mask planetDisk = circle(pc, pr)
  mask moon = circle(138:20, 7).subtract(circle(134:17, 8))
  mask lPanel = rect(62:26, 88:46)
  mask rPanel = rect(134:26, 158:46)
  mask hubBody = rrect(100:28, 124:44, 2)

  # 1 · deep space + faint nebulae
  bg space
  ellipse (nebA.alpha(20%)) 46:20 48:16 fill
  ellipse (nebB.alpha(14%)) 104:12 42:12 fill

  # 2 · starfield (seeded)
  for i 0..90:
    p = (rand(1, i) * 159):(rand(2, i) * 95)
    px starCols[floor(rand(3, i) * 4)] p
  for i 0..7:
    p = (rand(5, i) * 150 + 5):(rand(6, i) * 42 + 4)
    match i mod 3:
      0: stamp star4(starWarm) p anchor center
      1: stamp spark(starW) p anchor center scale2
      else: stamp spark(starB) p anchor center

  # 3 · moon moon (region set-op)
  fill (starW.alpha(88%)) moon

  # 4 · comet streak (path) upper-left
  circle (starB.alpha(45%)) 6:6 2 fill
  stroke (starW.alpha(55%)) comet w1
  circle starW 6:6 1 fill

  # 5 · atmosphere halo behind the planet
  circle atmo pc 47 fill

  # 6 · planet body + surface (masked to disk)
  circle ocean pc pr fill
  mask planetDisk:
    ellipse landDark 31:68 16:11 fill
    ellipse land 30:66 16:10 fill
    ellipse landLite 25:63 6:3 fill
    poly land 46:60 62:64 66:76 52:86 40:82 fill
    ellipse desert 41:80 9:5 fill
    ellipse (ice.alpha(78%)) 44:96 30:6 fill
    for b 0..6:
      cy = 50 + b * 7
      a = 0.2 + (b mod 2) * 0.12
      ellipse (cloud.alpha(a)) 44:cy 41:2 fill
    ellipse (cloud.alpha(0.5)) 34:70 11:3 fill
    circle (cloud.alpha(0.4)) 58:62 4 fill
    speckle 0.03 12 land
    grain 0.16 4 termShade

  # 7 · sphere volume: terminator shade, lit rim, edge AO
  shadeRegion planetDisk 14:56 termShade 1.0
  rim planetDisk 1:1 rimLite 2
  ambientOcclusion planetDisk oceanDeep 55%

  # 8 · earthshine glow rising toward the station
  circle earth 108:56 30 fill

  # 9 · solar panels: dithered cells + frame + grid
  mask lPanel:
    bg panelBlue
    dither panelDark panelLite 50%
  mask rPanel:
    bg panelBlue
    dither panelDark panelLite 50%
  rect panelFrame 62:26 88:46
  rect panelFrame 134:26 158:46
  line panelFrame 62:36 88:36
  line panelFrame 134:36 158:36
  for g 0..5:
    lx = 62 + g * 6
    rx = 134 + g * 6
    line (panelFrame.alpha(60%)) lx:26 lx:46
    line (panelFrame.alpha(60%)) rx:26 rx:46

  # 10 · truss + central hub
  rect hull 88:35 100:37 fill
  rect hull 124:35 136:37 fill
  line hullLite 88:34 136:34
  castShadow rect(124:35, 136:37) 1:3 #00001840
  rrect hullDark 100:28 124:44 2 fill
  rrect hull 101:29 123:43 2 fill
  rrect hullLite 102:30 121:32 1 fill
  fill accent ring(112:36, 5)
  circle hullDark 112:36 3 fill
  circle accent 112:36 2 fill
  circle earthGlow 106:39 1 fill
  circle earthGlow 118:39 1 fill
  rim hubBody -1:1 earthGlow.alpha(70%) 1

  # 11 · comms mast + dish (line + arc) and a curved boom (bezier)
  line hullLite 112:28 112:17
  arc rimLite 112:16 5 30 150
  line accent 112:17 112:11
  circle accent 112:11 1 fill
  bezier hullLite 124:33 132:26 136:22 141:24
  circle accent 141:24 1 fill

  # 12 · shuttle approaching (stamp: shadow + tint) + satellites
  stamp shuttle 82:60 shadow 2:2 #00000055 tint earthGlow 0.12
  stamp satellite 140:64 anchor center rot45
  stamp satellite 24:30 anchor center flipx

export orbit scenes/orbit:
  png @1 @2
  svg ids classes
