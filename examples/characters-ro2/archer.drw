theme archer:
  light sun = dir 1:1 #ffe6b0 amb #2a3a5e 16%
  figure:
    heads 3.5
    headW 30
    eyeLine 0.62
    earLine 0.58
    eyeSep 13
    hipW 20

theme archerHead:
  with archer
  figure:
    heads 1
    headW 26
    eyeLine 0.66
    earLine 0.62
    eyeSep 13

skinC = #e8b489
hairC = #3a2a18
hairLiteC = #5c4326
irisC = #4f7bb0
pupilC = #201810
whiteC = #fbf6ee
mouthC = #7a4030
capC = #3f6b3a
capDarkC = #294a26
featherC = #f2ead8
featherTipC = #b5453c
clothC = #3f7a3e
clothDarkC = #2a5028
leatherC = #925c2c
leatherDarkC = #402616
leatherLiteC = #b3733c
stringC = #e8e2d0
bowWoodC = #6d4527
buckleC = #b6c3d6

material skinM = skinC skin
material capM = capC cloth spread 160%
material clothM = clothC cloth spread 160%
material leatherM = leatherC cloth spread 160%
material woodM = bowWoodC cloth spread 140%
material steelM = buckleC metal

draw headFront 30x38:
  use archerHead
  skull = ellipse(15:19, 13:15).union(lobe(fig.earL, 1:23, 5)).union(lobe(fig.earR, 29:23, 5))
  model skull skinM
  bangs = crescent(15:15, 13:13, 6, 0:1)
  fill hairC bangs.intersect(rect(0:0, 29:18))
  fill hairLiteC bangs.intersect(rect(0:0, 29:11))
  fill whiteC ellipse(fig.eyeL, 3:3)
  fill whiteC ellipse(fig.eyeR, 3:3)
  circle irisC fig.eyeL 2 fill
  circle irisC fig.eyeR 2 fill
  px pupilC fig.eyeL
  px pupilC fig.eyeR
  px whiteC.alpha(90%) (fig.eyeL - 1:1)
  px whiteC.alpha(90%) (fig.eyeR - 1:1)
  px skinC.darken(18%) 15:24
  line mouthC 12:27 17:27
  capCrown = dome(15:14, 14:11)
  model capCrown capM
  brim = crescent(15:16, 14:11, 4, 0:1)
  model brim leatherM
  stroke leatherDarkC brim
  plume = lobe(21:11, 27:1, 3)
  fill featherC plume
  fill featherTipC lobe(24:5, 27:1, 3)
  pin chin 15:31

draw headSide 30x38:
  use archerHead
  skull = ellipse(13:19, 12:15).union(lobe(fig.side.ear, 3:24, 5)).union(lobe(19:22, 27:20, 5))
  model skull skinM
  bangs = crescent(13:15, 12:13, 6, 0:1)
  fill hairC bangs.intersect(rect(0:0, 28:18))
  fill hairLiteC bangs.intersect(rect(0:0, 28:11))
  eyeP = fig.side.eye - 3:1
  fill whiteC ellipse(eyeP, 2:2)
  circle irisC eyeP 1 fill
  px pupilC eyeP
  px skinC.darken(22%) 24:23
  line mouthC 18:27 22:27
  capCrown = dome(13:14, 13:11)
  model capCrown capM
  brim = crescent(13:16, 13:11, 4, 0:1)
  model brim leatherM
  stroke leatherDarkC brim
  plume = lobe(6:11, 1:1, 3)
  fill featherC plume
  fill featherTipC lobe(3:5, 1:1, 3)
  pin chin 13:31

draw headBack 30x38:
  use archerHead
  skull = ellipse(15:19, 13:15).union(lobe(fig.earL, 1:23, 5)).union(lobe(fig.earR, 29:23, 5))
  model skull skinM
  hairMass = ellipse(15:20, 13:14).intersect(rect(0:14, 29:37))
  fill hairC hairMass
  fill hairLiteC hairMass.intersect(rect(0:14, 29:22))
  fill hairC.darken(28%) hairMass.intersect(rect(0:29, 29:37))
  capCrown = dome(15:14, 14:11)
  model capCrown capM
  brim = crescent(15:16, 14:11, 4, 0:1)
  model brim leatherM
  stroke leatherDarkC brim
  plume = lobe(21:11, 27:1, 3)
  fill featherC plume
  fill featherTipC lobe(24:5, 27:1, 3)
  pin chin 15:31

draw torsoFront 48x32:
  use archer
  body = rrect(3:2, 45:31, 7)
  model body clothM
  vest = body.subtract(rrect(11:2, 37:20, 5))
  model vest leatherM
  belt = rect(3:23, 45:27)
  model belt leatherM
  buckle = rect(21:23, 27:27)
  model buckle steelM
  strap = poly(8:2, 13:2, 39:29, 34:29)
  fill leatherDarkC strap
  fill clothDarkC rect(18:2, 30:5)
  pin neck 24:2
  pin quiverAttach 42:6

draw torsoSide 34x32:
  use archer
  body = rrect(3:2, 31:31, 7)
  model body clothM
  vest = body.subtract(rrect(9:2, 25:20, 5))
  model vest leatherM
  belt = rect(3:23, 31:27)
  model belt leatherM
  strap = poly(6:2, 11:2, 27:29, 22:29)
  fill leatherDarkC strap
  pin neck 17:2
  pin quiverAttach 27:6

draw torsoBack 48x32:
  use archer
  body = rrect(3:2, 45:31, 7)
  model body clothM
  vest = body.subtract(rrect(11:2, 37:20, 5))
  model vest leatherM
  belt = rect(3:23, 45:27)
  model belt leatherM
  strap = poly(34:2, 39:2, 13:29, 8:29)
  fill leatherDarkC strap
  pin neck 24:2
  pin quiverAttach 40:10
  pin bowSling 14:16

draw armRelax 14x34:
  use archer
  sleeveCloth = rrect(2:1, 12:20, 4)
  model sleeveCloth clothM
  glove = rrect(1:19, 13:30, 3)
  model glove leatherM
  pin shoulder 7:1

draw armBow 16x34:
  use archer
  upperArm = rrect(2:1, 12:16, 4)
  forearm = poly(3:14, 12:14, 15:26, 6:29)
  armMass = upperArm.union(forearm)
  model armMass clothM
  glove = ellipse(10:27, 4:5)
  model glove leatherM
  pin shoulder 7:1
  pin grip 10:29

draw leg 16x60:
  use archer
  pantsTop = rrect(2:1, 14:38, 4)
  model pantsTop clothM
  boot = rrect(1:34, 15:58, 3)
  model boot leatherM
  fill leatherDarkC rect(1:32, 15:36)
  fill leatherDarkC rect(1:56, 15:59)
  pin hip 8:1

draw bow 12x56:
  use archer
  curve bowWoodC 6:2 3:14 7:28 3:42 6:54 w3
  curve leatherLiteC 6:2 4:13 7:27 4:41 6:54 w1
  line stringC 6:2 6:54
  fill leatherDarkC rect(4:24, 9:32)
  pin tip 6:2
  pin grip 6:28

draw quiver 16x28:
  use archer
  body = rrect(2:8, 14:27, 3).union(poly(1:22, 15:22, 16:27, 0:27))
  model body leatherM
  fill leatherLiteC rect(3:11, 5:24)
  fill leatherDarkC rect(11:11, 13:24)
  fill leatherDarkC ellipse(8:8, 6:3)
  fill leatherDarkC rect(6:0, 10:10)
  line bowWoodC 5:7 5:0
  line bowWoodC 8:7 8:0
  line bowWoodC 11:7 11:0
  fill featherTipC poly(4:1, 6:1, 5:0)
  fill featherC poly(7:1, 9:1, 8:0)
  fill featherTipC poly(10:1, 12:1, 11:0)
  pin attach 8:9

skeleton archerRig:
  headJ at fig.chin
  chestJ at fig.neck
  shLJ at fig.shoulderL
  shRJ at fig.shoulderR
  hipLJ at fig.hipL
  hipRJ at fig.hipR

pose front over archerRig:
  view front
  hipLJ 0 z 0
  hipRJ 0 z 0
  chestJ 0 z 2
  shRJ 0 z 1
  shLJ 0 z 3
  headJ 0 z 4

pose side over archerRig:
  view side
  hipLJ 0 z 0
  hipRJ 0 z 1
  chestJ 0 z 2
  shLJ 0 z 1
  shRJ 0 z 3
  headJ 0 z 4

pose back over archerRig:
  view back
  hipLJ 0 z 0
  hipRJ 0 z 0
  chestJ 0 z 2
  shLJ 0 z 1
  shRJ 0 z 3
  headJ 0 z 4

draw figFront 64x128:
  use archer
  pose front
  fit torsoFront.neck bone chestJ
  fit leg.hip bone hipLJ shadow
  fit leg.hip bone hipRJ
  fit armBow.shoulder bone shLJ
  fit armRelax.shoulder bone shRJ
  fit headFront.chin bone headJ
  fit bow.grip armBow.grip aim tip 8:14
  fit quiver.attach torsoFront.quiverAttach behind torsoFront
  outline

draw figSide 64x128:
  use archer
  pose side
  fit torsoSide.neck bone chestJ
  fit leg.hip bone hipLJ tint #2b2b2b 45%
  fit leg.hip bone hipRJ shadow
  fit armRelax.shoulder bone shLJ tint #2b2b2b 45%
  fit armBow.shoulder bone shRJ
  fit headSide.chin bone headJ
  fit bow.grip armBow.grip aim tip 58:18
  fit quiver.attach torsoSide.quiverAttach behind torsoSide
  outline

draw figBack 64x128:
  use archer
  pose back
  fit torsoBack.neck bone chestJ
  fit leg.hip bone hipLJ shadow
  fit leg.hip bone hipRJ
  fit armRelax.shoulder bone shLJ
  fit armRelax.shoulder bone shRJ flipx
  fit headBack.chin bone headJ
  fit quiver.attach torsoBack.quiverAttach
  fit bow.grip torsoBack.bowSling aim tip 46:6 behind quiver front torsoBack
  outline

draw archerSheet 196x128:
  use archer
  stamp figFront 0:0
  stamp figSide 66:0
  stamp figBack 132:0

export figFront archer-front:
  png @1 @4

export figSide archer-side:
  png @1 @4

export figBack archer-back:
  png @1 @4

export archerSheet archer-sheet:
  png @1 @4
